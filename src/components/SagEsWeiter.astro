---
// Teilen-Kasten unten auf jeder Seite (über Layout.astro eingebunden)
// Geteilt wird immer die Startseite, nicht diese Seite selbst
const seite = new URL('/', Astro.site).href;
const nachricht =
	'Schau dir d-wie-demokratie.de an – eine Initiative für alle, die zeigen wollen, dass sie unsere Demokratie schätzen:';

const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${nachricht} ${seite}`)}`;
const mailtoHref = `mailto:?subject=${encodeURIComponent('D wie Demokratie')}&body=${encodeURIComponent(`${nachricht} ${seite}`)}`;
---

<section class="teilen" id="sag-es-weiter" aria-labelledby="sag-es-weiter-titel">
	<h2 id="sag-es-weiter-titel">Bitte weitersagen</h2>
	<p>
		Kennen Sie jemanden, den d-wie-demokratie.de interessieren könnte? Teilen Sie die Seite
		mit einem Klick.
	</p>

	<!-- Knöpfe in Schwarz, Rot, Gold wie die Flagge; Klicks zählt Umami als Ereignis (data-umami-event) -->
	<div class="knoepfe">
		<a class="knopf schwarz" data-umami-event="teilen-whatsapp" href={whatsappHref} target="_blank" rel="noopener">Auf WhatsApp teilen</a>
		<a class="knopf rot" data-umami-event="teilen-email" href={mailtoHref}>Per E-Mail empfehlen</a>
		<button class="knopf gold" data-umami-event="link-kopieren" id="kopieren" type="button" data-url={seite}>Link kopieren</button>
		<!-- nur sichtbar, wenn das Gerät eigenes Teilen anbietet (meist Handys); steht unten,
		     damit oben die Flaggenfolge erhalten bleibt -->
		<button class="knopf schwarz" data-umami-event="teilen-geraet" id="teilen" type="button" data-url={seite} data-text={nachricht} hidden>
			Teilen
		</button>
	</div>

	<!-- Anmeldung für Neuigkeiten über CleverReach (Double-Opt-in); öffnet die Bestätigungsseite
	     von CleverReach in einem neuen Tab, damit die Besucher auf der Seite bleiben -->
	<form
		class="neuigkeiten"
		method="post"
		action="https://flow.cleverreach.com/fl/22f14217-3d47-4f01-8b0f-ddcaf44718bf/confirm"
		target="_blank"
	>
		<h3>Neuigkeiten per E-Mail</h3>
		<p>
			Wir schreiben Ihnen, wenn es Neues von der Initiative gibt. Sie erhalten eine
			Bestätigungsmail und können sich jederzeit abmelden.
		</p>
		<!-- Falle für Spam-Programme, für Menschen unsichtbar -->
		<input type="text" name="email_confirm" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
		<label for="neuigkeiten-email">Ihre E-Mail-Adresse</label>
		<div class="eingabe">
			<input id="neuigkeiten-email" type="email" name="email" autocomplete="email" required />
			<button class="knopf schwarz" data-umami-event="neuigkeiten-anmelden" type="submit">Anmelden</button>
		</div>
	</form>
</section>

<script>
	const teilen = document.getElementById('teilen') as HTMLButtonElement | null;
	if (teilen && navigator.share) {
		teilen.hidden = false;
		teilen.addEventListener('click', async () => {
			try {
				await navigator.share({
					title: 'D wie Demokratie',
					text: teilen.dataset.text,
					url: teilen.dataset.url,
				});
			} catch {
				// abgebrochen – nichts zu tun
			}
		});
	}

	const kopieren = document.getElementById('kopieren') as HTMLButtonElement | null;
	kopieren?.addEventListener('click', async () => {
		const url = kopieren.dataset.url ?? '';
		try {
			await navigator.clipboard.writeText(url);
			kopieren.textContent = 'Link kopiert';
			setTimeout(() => (kopieren.textContent = 'Link kopieren'), 1600);
		} catch {
			alert('Kopieren war nicht möglich. Die Adresse lautet: ' + url);
		}
	});
</script>

<style>
	/* Kasten mit Schwarz-Rot-Gold links, mit Abstand zum Inhalt der Seite darüber */
	.teilen {
		margin-top: 3em;
		padding: 1.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	.teilen h2 {
		margin: 0 0 0.4em;
		font-size: 1.4rem;
	}

	.teilen p {
		margin-top: 0;
	}

	.knoepfe {
		display: flex;
		flex-direction: column;
		gap: 0.65em;
		max-width: 435px;
	}

	.knopf {
		display: block;
		padding: 0.75em 1.4em;
		border: 0;
		border-radius: 6px;
		font: inherit;
		font-weight: bold;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
	}

	/* durch eine Linie vom Teilen abgesetzt */
	.neuigkeiten {
		margin-top: 1.75em;
		padding-top: 1.5em;
		border-top: 1px solid #dddddd;
		max-width: 435px;
	}

	.neuigkeiten h3 {
		margin: 0 0 0.4em;
		font-size: 1.4rem;
	}

	.neuigkeiten label {
		display: block;
		margin-bottom: 0.3em;
		font-weight: bold;
	}

	.eingabe {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65em;
	}

	.eingabe input {
		flex: 1 1 14em;
		min-width: 0;
		padding: 0.7em 0.9em;
		border: 1px solid #999999;
		border-radius: 6px;
		background: #ffffff;
		font: inherit;
	}

	/* nur so breit wie nötig, der Rest bleibt für die Adresse */
	.eingabe .knopf {
		flex: 0 0 auto;
		padding-inline: 1em;
	}

	/* auf dem Handy steht der Knopf unter dem Feld, dann so breit wie die anderen Knöpfe */
	@media (max-width: 540px) {
		.eingabe .knopf {
			flex-basis: 100%;
		}
	}

	.knopf[hidden] {
		display: none;
	}

	.schwarz {
		background: var(--schwarz);
		color: #ffffff;
	}

	.rot {
		background: var(--rot);
		color: #ffffff;
	}

	/* auf Gold ist weiße Schrift kaum lesbar, daher schwarz */
	.gold {
		background: var(--gold);
		color: var(--schwarz);
	}

	.knopf:hover {
		filter: brightness(1.15);
	}

	/* Schwarz wird durch Aufhellen kaum sichtbar heller */
	.schwarz:hover {
		background: #333333;
	}
</style>
