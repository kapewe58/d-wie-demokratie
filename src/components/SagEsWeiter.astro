---
// Teilen-Kasten unten auf jeder Seite (über Layout.astro eingebunden)
import { getImage, Image } from 'astro:assets';
import reichstag from '../assets/flagge/1990-reichstag.jpg';

// Reichstag-Foto als Wasserzeichen hinter den drei Flaggen-Knöpfen (Nachweis unter dem goldenen Knopf)
const wasserzeichen = await getImage({ src: reichstag, width: 1000, format: 'webp' });
// Geteilt wird immer die Startseite, nicht diese Seite selbst
const seite = new URL('/', Astro.site).href;
const nachricht =
	'Schau dir d-wie-demokratie.de an – eine Initiative für alle, die zeigen wollen, dass sie unsere Demokratie schätzen:';

const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${nachricht} ${seite}`)}`;
const mailtoHref = `mailto:?subject=${encodeURIComponent('D wie Demokratie')}&body=${encodeURIComponent(`${nachricht} ${seite}`)}`;
---

<section class="teilen" id="sag-es-weiter" aria-labelledby="sag-es-weiter-titel" style={`--wz-url: url(${wasserzeichen.src})`}>
	<h2 id="sag-es-weiter-titel">Bitte weitersagen</h2>
	<p>
		Kennst du jemanden, den d-wie-demokratie.de interessieren könnte? Teile die Seite
		mit einem Klick.
	</p>

	<!-- Knöpfe in Schwarz, Rot, Gold wie die Flagge; Klicks zählt Umami als Ereignis (data-umami-event) -->
	<div class="knoepfe" data-wz-breite={reichstag.width} data-wz-hoehe={reichstag.height}>
		<a class="knopf schwarz flaggenknopf" data-umami-event="teilen-whatsapp" href={whatsappHref} target="_blank" rel="noopener">Auf WhatsApp teilen</a>
		<a class="knopf rot flaggenknopf" data-umami-event="teilen-email" href={mailtoHref}>Per E-Mail empfehlen</a>
		<button class="knopf gold flaggenknopf" data-umami-event="link-kopieren" id="kopieren" type="button" data-url={seite}>Link kopieren</button>
		<!-- Bildnachweis zum Wasserzeichen: nur „Foto“, ein Klick zeigt die Angaben (ohne JavaScript stehen sie gleich da) -->
		<p class="foto-nachweis">
			<button type="button" class="foto-knopf" aria-expanded="false" aria-controls="teilen-foto-lizenz" hidden>Foto</button><span id="teilen-foto-lizenz" hidden><span class="foto-ohne-js">Foto</span>:
				<a href="/geschichte-unserer-flagge/#1990">Flaggen vor dem Reichstag am 3. Oktober 1990</a>.
				Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann,
				<a href="https://creativecommons.org/licenses/by-sa/3.0/de/deed.de" target="_blank" rel="noopener">CC BY-SA 3.0 DE</a>,
				<a href="https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1990-1003-417,_Berlin,_Flaggen_vor_dem_Reichstag.jpg" target="_blank" rel="noopener">Quelle</a><a class="original" href="/geschichte-unserer-flagge/#1990"><Image src={reichstag} alt="Originalfoto: Flaggen vor dem Reichstag am 3. Oktober 1990" widths={[200, 400]} sizes="200px" /></a>
			</span>
		</p>
		<!-- versteckt, damit das Originalfoto erst beim Aufklappen lädt; ohne JavaScript stehen die Angaben gleich da -->
		<noscript><style is:inline>#teilen-foto-lizenz { display: inline; }</style></noscript>
		<!-- nur sichtbar, wenn das Gerät eigenes Teilen anbietet (meist Handys); steht unten,
		     damit oben die Flaggenfolge erhalten bleibt -->
		<button class="knopf schwarz textur" data-umami-event="teilen-geraet" id="teilen" type="button" data-url={seite} data-text={nachricht} hidden>
			Teilen
		</button>
	</div>

	<!-- Anmeldung für Neuigkeiten über CleverReach (Double-Opt-in); öffnet die Bestätigungsseite
	     von CleverReach in einem neuen Tab, damit die Besucher auf der Seite bleiben -->
	<form
		id="neuigkeiten"
		class="neuigkeiten"
		method="post"
		action="https://flow.cleverreach.com/fl/22f14217-3d47-4f01-8b0f-ddcaf44718bf/confirm"
		target="_blank"
	>
		<h3>Neuigkeiten per E-Mail</h3>
		<p>
			Von Zeit zu Zeit stellen wir dir neue Motive vor und teilen dir Neuigkeiten von unserer Initiative mit. Du erhältst eine
			Bestätigungsmail und kannst dich jederzeit abmelden.
		</p>
		<!-- Falle für Spam-Programme, für Menschen unsichtbar -->
		<input type="text" name="email_confirm" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
		<label for="neuigkeiten-email">Deine E-Mail-Adresse</label>
		<div class="eingabe">
			<input id="neuigkeiten-email" type="email" name="email" autocomplete="email" required />
			<button class="knopf schwarz textur" data-umami-event="neuigkeiten-anmelden" type="submit">Anmelden</button>
		</div>
	</form>
</section>

<script>
	// Wasserzeichen: ein durchgehendes Foto über die drei Flaggen-Knöpfe. Jeder Knopf zeigt den Ausschnitt,
	// der an seiner Stelle liegt; die Lücken dazwischen bleiben frei. Ohne JavaScript gibt es kein Wasserzeichen.
	const knoepfeBox = document.querySelector<HTMLElement>('.knoepfe');
	const flaggenknoepfe = [...document.querySelectorAll<HTMLElement>('.flaggenknopf')];
	function wasserzeichenSetzen() {
		if (!knoepfeBox || flaggenknoepfe.length === 0) return;
		const oben = flaggenknoepfe[0].offsetTop;
		const letzter = flaggenknoepfe[flaggenknoepfe.length - 1];
		const breite = knoepfeBox.clientWidth;
		const hoehe = letzter.offsetTop + letzter.offsetHeight - oben;
		// wie object-fit: cover
		const verhaeltnis = Number(knoepfeBox.dataset.wzBreite) / Number(knoepfeBox.dataset.wzHoehe);
		const bildBreite = Math.max(breite, hoehe * verhaeltnis);
		const bildHoehe = bildBreite / verhaeltnis;
		const versatzX = (breite - bildBreite) / 2;
		const versatzY = (hoehe - bildHoehe) / 2;
		for (const knopf of flaggenknoepfe) {
			knopf.style.setProperty('--wz-groesse', `${bildBreite}px ${bildHoehe}px`);
			knopf.style.setProperty('--wz-lage', `${versatzX - knopf.offsetLeft}px ${versatzY - (knopf.offsetTop - oben)}px`);
			knopf.classList.add('mit-wasserzeichen');
		}
	}
	wasserzeichenSetzen();
	addEventListener('resize', wasserzeichenSetzen);

	const fotoKnopf = document.querySelector<HTMLButtonElement>('.foto-knopf');
	const fotoLizenz = document.getElementById('teilen-foto-lizenz');
	if (fotoKnopf && fotoLizenz) {
		fotoKnopf.hidden = false;
		document.querySelector('.foto-ohne-js')?.remove();
		fotoLizenz.hidden = true;
		fotoKnopf.addEventListener('click', () => {
			const offen = fotoKnopf.getAttribute('aria-expanded') === 'true';
			fotoKnopf.setAttribute('aria-expanded', String(!offen));
			fotoLizenz.hidden = offen;
		});
	}

	const teilen = document.getElementById('teilen') as HTMLButtonElement | null;
	if (teilen && navigator.share) {
		teilen.hidden = false;
		teilen.addEventListener('click', async () => {
			try {
				await navigator.share({
					title: 'D wie Demokratie',
					text: teilen.dataset.text,
					url: teilen.dataset.url,
				});
			} catch {
				// abgebrochen – nichts zu tun
			}
		});
	}

	const kopieren = document.getElementById('kopieren') as HTMLButtonElement | null;
	kopieren?.addEventListener('click', async () => {
		const url = kopieren.dataset.url ?? '';
		try {
			await navigator.clipboard.writeText(url);
			kopieren.textContent = 'Link kopiert';
			setTimeout(() => (kopieren.textContent = 'Link kopieren'), 1600);
		} catch {
			alert('Kopieren war nicht möglich. Die Adresse lautet: ' + url);
		}
	});
</script>

<style>
	/* Kasten mit Schwarz-Rot-Gold links, mit Abstand zum Inhalt der Seite darüber */
	.teilen {
		margin-top: 3em;
		padding: 1.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	.teilen h2 {
		margin: 0 0 0.4em;
		font-size: 1.4rem;
	}

	.teilen p {
		margin-top: 0;
	}

	.knoepfe {
		position: relative; /* Bezugspunkt für die Lage des Wasserzeichens */
		display: flex;
		flex-direction: column;
		gap: 0.65em;
		max-width: 435px;
	}

	.knopf {
		display: block;
		padding: 0.75em 1.4em;
		border: 0;
		border-radius: 6px;
		font: inherit;
		font-weight: bold;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
	}

	/* durch eine Linie vom Teilen abgesetzt */
	.neuigkeiten {
		margin-top: 1.75em;
		padding-top: 1.5em;
		border-top: 1px solid #dddddd;
		max-width: 435px;
	}

	.neuigkeiten h3 {
		margin: 0 0 0.4em;
		font-size: 1.4rem;
	}

	.neuigkeiten label {
		display: block;
		margin-bottom: 0.3em;
		font-weight: bold;
	}

	.eingabe {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65em;
	}

	.eingabe input {
		flex: 1 1 14em;
		min-width: 0;
		padding: 0.7em 0.9em;
		border: 1px solid #999999;
		border-radius: 6px;
		background: #ffffff;
		font: inherit;
	}

	/* nur so breit wie nötig, der Rest bleibt für die Adresse */
	.eingabe .knopf {
		flex: 0 0 auto;
		padding-inline: 1em;
	}

	/* auf dem Handy steht der Knopf unter dem Feld, dann so breit wie die anderen Knöpfe */
	@media (max-width: 540px) {
		.eingabe .knopf {
			flex-basis: 100%;
		}
	}

	.knopf[hidden] {
		display: none;
	}

	/* „Foto“ klein und rechtsbündig direkt unter dem goldenen Knopf */
	.foto-nachweis {
		margin: -0.45em 0 0;
		color: var(--grau);
		font-size: 0.75rem;
		text-align: right;
	}

	.foto-nachweis a {
		color: inherit;
	}

	/* Originalfoto über den Angaben; wird erst beim Aufklappen geladen (lazy im versteckten Bereich) */
	.original {
		display: block;
		width: 200px;
		margin: 0.4em 0 0.2em auto;
	}

	.original img {
		display: block;
		width: 100%;
		height: auto;
	}

	.foto-knopf {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}

	.foto-knopf:hover,
	.foto-nachweis a:hover {
		color: var(--rot);
	}

	/* Wasserzeichen hinter dem Text, über der Knopffarbe (Lage berechnet das Skript) */
	.flaggenknopf {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.mit-wasserzeichen::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--wz-url);
		background-size: var(--wz-groesse);
		background-position: var(--wz-lage);
		background-repeat: no-repeat;
		filter: grayscale(1) contrast(1.1);
		opacity: 0.25;
		mix-blend-mode: luminosity;
		pointer-events: none;
	}

	/* „Teilen“ und „Anmelden“: dasselbe Foto als Textur, unten mit der Menschenmenge */
	.textur {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.textur::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		/* mindestens so breit wie die Knopfspalte, damit auch der schmale „Anmelden“ nur Menschen zeigt */
		background: var(--wz-url) center 85% / max(100%, 435px) auto no-repeat;
		filter: grayscale(1) contrast(1.1);
		opacity: 0.25;
		mix-blend-mode: luminosity;
		pointer-events: none;
	}

	/* auf Schwarz goldene Schrift, wie in den Flaggen-Kästen */
	.schwarz {
		background: var(--schwarz);
		color: var(--gold);
	}

	.rot {
		background: var(--rot);
		color: #ffffff;
	}

	/* auf Gold ist weiße Schrift kaum lesbar, daher schwarz */
	.gold {
		background: var(--gold);
		color: var(--schwarz);
	}

	.knopf:hover {
		filter: brightness(1.15);
	}

	/* Schwarz wird durch Aufhellen kaum sichtbar heller */
	.schwarz:hover {
		background: #333333;
	}
</style>
