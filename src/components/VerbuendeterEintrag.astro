---
// Ein Eintrag in der Liste der Verbündeten (Seite /verbuendete/)
import { Image } from 'astro:assets';

const { v } = Astro.props;
// Website kurz anzeigen: ohne https:// und www., ohne Schrägstrich am Ende
const kurz = v.url ? v.url.replace(/^https?:\/\//, '').replace(/^www\./, '').replace(/\/$/, '') : '';
---

<li>
	{v.logo && <Image class="logo" src={v.logo} alt="" width={240} />}
	<div>
		{/* Name immer fett und nicht verlinkt, damit alle Einträge gleich aussehen; die Website steht darunter */}
		<strong>{v.name}</strong>
		{v.zusatz && <span class="zusatz">{v.zusatz}</span>}
		{v.url && <a class="website" href={v.url} target="_blank" rel="noopener">{kurz}<span aria-hidden="true"> ↗</span></a>}
		{v.zitat && <q class="zitat">{v.zitat}</q>}
	</div>
</li>

<style>
	li {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		padding: 0.5em 0;
		border-bottom: 1px solid #e4e4e4;
	}

	/* Zitat unter dem Namen, mit deutschen Anführungszeichen */
	.zitat {
		display: block;
		margin-top: 0.3em;
		font-style: italic;
		quotes: '„' '“';
	}

	/* Logos einheitlich klein, ohne sie zu verzerren */
	.logo {
		flex: none;
		width: 96px;
		height: 48px;
		object-fit: contain;
	}

	.zusatz {
		display: block;
		color: #555555;
		font-size: 0.95rem;
	}

	.website {
		display: inline-block;
		font-size: 0.95rem;
	}
</style>
