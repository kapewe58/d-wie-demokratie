---
import Layout from '../layouts/Layout.astro';

// Geteilt wird immer die Startseite, nicht diese Seite selbst
const seite = new URL('/', Astro.site).href;
const nachricht =
	'Schau dir d-wie-demokratie.de an – eine Initiative für alle, die zeigen wollen, dass sie unsere Demokratie schätzen:';

const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${nachricht} ${seite}`)}`;
const mailtoHref = `mailto:?subject=${encodeURIComponent('D wie Demokratie')}&body=${encodeURIComponent(`${nachricht} ${seite}`)}`;
---

<Layout
	title="Sag’s weiter – D wie Demokratie"
	description="Empfehlen Sie d-wie-demokratie.de weiter – per WhatsApp, E-Mail oder mit einem Link."
>
	<h1>Sag’s weiter</h1>

	<section class="teilen" aria-label="Seite teilen">
		<p>
			Kennen Sie jemanden, den d-wie-demokratie.de interessieren könnte? Teilen Sie die Seite
			mit einem Klick.
		</p>

		<!-- Knöpfe in Schwarz, Rot, Gold wie die Flagge; Klicks zählt Umami als Ereignis (data-umami-event) -->
		<div class="knoepfe">
			<a class="knopf schwarz" data-umami-event="teilen-whatsapp" href={whatsappHref} target="_blank" rel="noopener">Auf WhatsApp teilen</a>
			<a class="knopf rot" data-umami-event="teilen-email" href={mailtoHref}>Per E-Mail empfehlen</a>
			<button class="knopf gold" data-umami-event="link-kopieren" id="kopieren" type="button" data-url={seite}>Link kopieren</button>
			<!-- nur sichtbar, wenn das Gerät eigenes Teilen anbietet (meist Handys); steht unten,
			     damit oben die Flaggenfolge erhalten bleibt -->
			<button class="knopf schwarz" data-umami-event="teilen-geraet" id="teilen" type="button" data-url={seite} data-text={nachricht} hidden>
				Teilen
			</button>
		</div>
	</section>
</Layout>

<script>
	const teilen = document.getElementById('teilen') as HTMLButtonElement | null;
	if (teilen && navigator.share) {
		teilen.hidden = false;
		teilen.addEventListener('click', async () => {
			try {
				await navigator.share({
					title: 'D wie Demokratie',
					text: teilen.dataset.text,
					url: teilen.dataset.url,
				});
			} catch {
				// abgebrochen – nichts zu tun
			}
		});
	}

	const kopieren = document.getElementById('kopieren') as HTMLButtonElement | null;
	kopieren?.addEventListener('click', async () => {
		const url = kopieren.dataset.url ?? '';
		try {
			await navigator.clipboard.writeText(url);
			kopieren.textContent = 'Link kopiert';
			setTimeout(() => (kopieren.textContent = 'Link kopieren'), 1600);
		} catch {
			alert('Kopieren war nicht möglich. Die Adresse lautet: ' + url);
		}
	});
</script>

<style>
	h1 {
		font-size: clamp(1.85rem, 7.5vw, 2.75rem);
	}

	/* Kasten wie der Download-Kasten auf der Startseite: Schwarz-Rot-Gold links */
	.teilen {
		padding: 1.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	.teilen p {
		margin-top: 0;
	}

	.knoepfe {
		display: flex;
		flex-direction: column;
		gap: 0.65em;
		max-width: 435px;
	}

	.knopf {
		display: block;
		padding: 0.75em 1.4em;
		border: 0;
		border-radius: 6px;
		font: inherit;
		font-weight: bold;
		text-align: center;
		text-decoration: none;
		cursor: pointer;
	}

	.knopf[hidden] {
		display: none;
	}

	.schwarz {
		background: var(--schwarz);
		color: #ffffff;
	}

	.rot {
		background: var(--rot);
		color: #ffffff;
	}

	/* auf Gold ist weiße Schrift kaum lesbar, daher schwarz */
	.gold {
		background: var(--gold);
		color: var(--schwarz);
	}

	.knopf:hover {
		filter: brightness(1.15);
	}

	/* Schwarz wird durch Aufhellen kaum sichtbar heller */
	.schwarz:hover {
		background: #333333;
	}
</style>
