---
// Alte Adresse der Seite „mitmachen“. Eigene Weiterleitung statt `redirects` in astro.config.mjs,
// damit Links auf einzelne Stellen (/jobs/#instagram) auf der richtigen Stelle landen.
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<title>Weiterleitung zu Mitmachen</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href="https://d-wie-demokratie.de/mitmachen/" />
		<script is:inline>location.replace('/mitmachen/' + location.hash);</script>
		<meta http-equiv="refresh" content="0;url=/mitmachen/" />
	</head>
	<body>
		<a href="/mitmachen/">Weiter zu Mitmachen</a>
	</body>
</html>
