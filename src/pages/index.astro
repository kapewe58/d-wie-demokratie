---
import { Image } from 'astro:assets';
import { motive } from '../data/motive';
import Werte from '../components/Werte.astro';
import Layout from '../layouts/Layout.astro';
import laptop from '../assets/slider/02-laptop.png';
import tassen from '../assets/slider/04-tassen.png';
import tshirt from '../assets/slider/05-tshirtmaedchen.png';
// Wasserzeichen im Zitat-Kasten (Nachweis unter dem Kasten)
import fotoReichstag from '../assets/flagge/1990-reichstag.jpg';

// Startseite: Fotos, Werte aus dem Grundgesetz, Zitate und eine Vorschau unserer Motive (alle Motive: /motive/,
// Daten in src/data/motive.ts). Alte Links wie /#motiv-1, /#herunterladen, /#shop leitet das Skript unten auf /motive/ weiter.

// Fotos oben, wechseln alle paar Sekunden; ein Klick springt zum gezeigten Motiv auf /motive/. Neues Foto = nach
// src/assets/slider/ legen (1800 × 1200 Pixel, JPEG), oben importieren und hier eintragen.
// „foto: true“ blendet beim Bild den Hinweis „KI-generiert“ ein (Kennzeichnung nach Art. 50 KI-Verordnung, muss sichtbar bleiben).
const bilder = [
	{
		src: laptop,
		motiv: 1,
		foto: true,
		alt: 'Fünf lächelnde Menschen unterschiedlichen Alters und unterschiedlicher Herkunft an einem Tisch vor dem Reichstagsgebäude, auf ihren Laptops der Aufkleber „D wie Demokratie“.',
	},
	{
		src: tassen,
		motiv: 1,
		foto: true,
		alt: 'Fünf lächelnde Menschen, darunter eine Frau mit Kopftuch, halten vor dem Reichstagsgebäude Tassen mit dem Aufdruck „D wie Demokratie“ hoch.',
	},
	{
		src: tshirt,
		motiv: 1,
		foto: true,
		alt: 'Eine junge Frau in einem weißen T-Shirt mit dem Aufdruck „D wie Demokratie“, im Hintergrund der Berliner Fernsehturm im Abendlicht.',
	},
];
const sekunden = 5;

// Zitate im Flaggen-Kasten, wechseln alle paar Sekunden. Neues Zitat = neuer Eintrag.
// Videos und Reden werden nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von Dritten geladen wird.
// id: eigene Adresse je Zitat, z. B. /#zitat-aigner zeigt dieses Zitat und hält den Wechsel an
const zitate = [
	{
		id: 'zitat-steinmeier',
		text: 'Schwarz-Rot-Gold sind die Farben der freiheitlichen Demokratie und der europäischen Völkerfreundschaft, nicht der Nationalisten und Autoritären …',
		wer: 'Bundespräsident Frank-Walter Steinmeier, 18. März 2026, Gastbeitrag zum Tag der Demokratiegeschichte',
		// #:~:text= springt direkt zur Stelle und hebt sie hervor (Seite hat keine Absatz-Anker); Bindestriche dort als %2D
		knopf: { text: 'Beitrag nachlesen', url: 'https://www.bundespraesident.de/SharedDocs/Reden/DE/Frank-Walter-Steinmeier/Zeitungsbeitraege/2026/260317-Tag-der-Demokratiegeschichte-RND.html#:~:text=Schwarz%2DRot%2DGold%20sind%20die%20Farben,Nationalisten%20und%20Autorit%C3%A4ren' },
	},
	{
		id: 'zitat-klopp',
		text: 'Ich würde mir oder uns gerne die Fahne zurückholen.',
		wer: 'Bundestrainer Jürgen Klopp, 17. September 2026',
		// „Mehr in unserer Flaggengeschichte“ springt hier direkt zur Station 2026
		mehr: '/geschichte-unserer-flagge/#2026',
		knopf: { text: '▶ Video ansehen', url: 'https://www.youtube.com/watch?v=_jfi8T6pU0I&t=1052s' },
	},
	{
		id: 'zitat-pistorius',
		text: 'Wir dürfen uns die Symbole dieses Staates nicht von Rechtsextremen nehmen lassen.',
		wer: 'Verteidigungsminister Boris Pistorius, 8. November 2026, im Interview mit den Funke-Zeitungen',
		// AFP-Meldung; falls der Yahoo-Link einmal tot ist, ersetzen durch die dts-Meldung:
		// https://regionalheute.de/pistorius-will-nationalsymbole-nicht-rechtsextremen-ueberlassen-1794096127/#:~:text=Wir%20d%C3%BCrfen%20uns%20die%20Symbole%20dieses%20Staates%20nicht%20von%20Rechtsextremen%20nehmen%20lassen
		knopf: { text: 'Quelle lesen', url: 'https://de.nachrichten.yahoo.com/pistorius-f%C3%BCr-selbstbewussteren-umgang-nationalhymne-092230184.html#:~:text=Wir%20d%C3%BCrfen%20uns%20die%20Symbole%20dieses%20Staates%20nicht%20von%20Rechtsextremen%20nehmen%20lassen' },
	},
	{
		id: 'zitat-aigner',
		text: 'Die Feinde der Demokratie sind stark. Aber wir, wir sind viel stärker, weil uns die Freiheit leistungsfähiger, kreativer und solidarischer macht.',
		// Wahl durch die Bundesversammlung am 30. Januar 2027; wenn gewählt, „Bundespräsidentin“ eintragen
		wer: 'Ilse Aigner, Präsidentin des Bayerischen Landtags, 6. Juli 2026',
		// PDF: Textsprung geht dort nicht, #page=23 öffnet die Seite mit dem Zitat
		knopf: { text: 'Rede nachlesen', url: 'https://www.bayern.landtag.de/fileadmin/Internet_Dokumente/Presse/2026-07-06_Rede_LPin_Ilse_Aigner_anl_Auszeichnung_Gro%C3%9Fe_Aula_LMU_zu_Ort_der_Demokratie.pdf#page=23' },
	},
];
const zitatSekunden = 8;

---

<Layout
	title="D wie Demokratie"
	description="Wir zeigen Flagge für unsere Demokratie und das Grundgesetz: Motive kostenlos herunterladen oder im Shop bestellen."
>
	<!-- Fotos liegen übereinander und werden nacheinander eingeblendet; ohne JavaScript bleibt das erste stehen -->
	<div class="slider" data-sekunden={sekunden}>
		{bilder.map((bild, i) => (
			<a href={`/motive/#motiv-${bild.motiv}`} class:list={['folie', { sichtbar: i === 0 }]} data-foto={bild.foto ? '' : undefined} tabindex={i === 0 ? undefined : -1}>
				<Image
					src={bild.src}
					alt={bild.alt}
					widths={[400, 700, 1360]}
					sizes="(max-width: 680px) 100vw, 680px"
					loading={i === 0 ? 'eager' : 'lazy'}
				/>
			</a>
		))}
	</div>

	<div class="unter-slider">
		<!-- Punkte zum Weiterschalten; ein Klick hält den automatischen Wechsel an -->
		<div class="punkte" hidden>
			{bilder.map((_, i) => (
				<button type="button" aria-label={`Bild ${i + 1} von ${bilder.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
			))}
		</div>
		<!-- Kennzeichnung nach Art. 50 KI-Verordnung -->
		<p class="ki-hinweis" hidden={!bilder[0].foto}>KI-Bilder, bald ersetzen wir sie durch echte.</p>
	</div>

	<h1>Wir zeigen Flagge</h1>

	<p class="lead">
		<strong>Wir schätzen unsere Demokratie und die zentralen Werte unseres Grundgesetzes:</strong>
	</p>

	<Werte class="lead werte" />

	<p class="lead">
		<strong>Deshalb bekennen wir in der Öffentlichkeit Farbe. Mit Motiven auf unseren T-Shirts, Taschen, Laptops, Autos, Tassen und vielem mehr.</strong>
	</p>

	<!-- Klopp-Zitat als Flagge (Schwarz-Rot-Gold); das Video ist nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von YouTube geladen wird -->
	<div class="zitate" data-sekunden={zitatSekunden}>
		{zitate.map((z, i) => (
			<aside id={z.id} class:list={['flaggen-kasten', 'wz', { sichtbar: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
				<Image src={fotoReichstag} alt="" class="wz-bild" widths={[800, 1400]} sizes="(max-width: 680px) 100vw, 680px" />
				<div class="streifen schwarz">
					<p class="zitat">„{z.text}“</p>
				</div>
				<div class="streifen rot">
					<p>{z.wer}</p>
				</div>
				<div class="streifen gold">
					<a class="knopf-schwarz" href={z.knopf.url} target="_blank" rel="noopener">{z.knopf.text}</a>
					<a class="nebenlink" href={z.mehr ?? '/geschichte-unserer-flagge/'}>Mehr in unserer Flaggengeschichte</a>
				</div>
			</aside>
		))}
	</div>
	<!-- Punkte zum Weiterschalten (ein Klick hält den automatischen Wechsel an), rechts daneben der Bildnachweis -->
	<div class="unter-zitaten">
	<div class="punkte zitat-punkte" hidden>
		{zitate.map((_, i) => (
			<button type="button" aria-label={`Zitat ${i + 1} von ${zitate.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
		))}
	</div>
	<!-- Bildnachweis: nur „Foto“, ein Klick zeigt die Angaben (ohne JavaScript stehen sie gleich da) -->
	<p class="wz-nachweis">
		<button type="button" class="wz-knopf" aria-expanded="false" aria-controls="wz-lizenz" hidden>Foto</button><span id="wz-lizenz" hidden><span class="wz-ohne-js">Foto</span>:
			<a href="/geschichte-unserer-flagge/#1990">Flaggen vor dem Reichstag am 3. Oktober 1990</a>.
			Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann,
			<a href="https://creativecommons.org/licenses/by-sa/3.0/de/deed.de" target="_blank" rel="noopener">CC BY-SA 3.0 DE</a>,
			<a href="https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1990-1003-417,_Berlin,_Flaggen_vor_dem_Reichstag.jpg" target="_blank" rel="noopener">Quelle</a><a class="original" href="/geschichte-unserer-flagge/#1990"><Image src={fotoReichstag} alt="Originalfoto: Flaggen vor dem Reichstag am 3. Oktober 1990" widths={[200, 400]} sizes="200px" /></a>
		</span>
	</p>
	<!-- versteckt, damit das Originalfoto erst beim Aufklappen lädt; ohne JavaScript stehen die Angaben gleich da -->
	<noscript><style is:inline>#wz-lizenz { display: inline; }</style></noscript>
	</div>

	<!-- Vorschau: alle Motive als kleine Bilder (später nur die neuesten), alles Weitere auf /motive/ -->
	<h2>Unsere Motive</h2>
	<p class="vorschau-text">Bald werden es mehr, denn Demokratie bedeutet Vielfalt.</p>
	<ul class="vorschau">
		{motive.filter((motiv) => !motiv.bald).map((motiv) => (
			<li>
				<a href={`/motive/#motiv-${motiv.nr}`}>
					<Image src={motiv.fassungen[0].bild!} alt={motiv.alt} width={300} widths={[300, 600]} sizes="(max-width: 540px) 45vw, 300px" />
					<span>{motiv.name}</span>
				</a>
			</li>
		))}
	</ul>
</Layout>

<!-- alte Links auf Motive und Fragen von der Startseite (z. B. /#motiv-2, /#shop) gehen jetzt auf /motive/ -->
<script is:inline>
	if (/^#(motiv-\d+|motive|herunterladen|shop)$/.test(location.hash)) location.replace('/motive/' + (location.hash === '#motive' ? '' : location.hash));
</script>

<script>
	const slider = document.querySelector<HTMLElement>('.slider');
	const punkte = document.querySelector<HTMLElement>('.punkte');
	if (slider && punkte) {
		const folien = [...slider.querySelectorAll<HTMLElement>('.folie')];
		const hinweis = document.querySelector<HTMLElement>('.ki-hinweis');
		const knoepfe = [...punkte.querySelectorAll('button')];
		let aktuell = 0;

		const zeige = (n: number) => {
			folien[aktuell].classList.remove('sichtbar');
			folien[aktuell].tabIndex = -1;
			knoepfe[aktuell].removeAttribute('aria-current');
			aktuell = n;
			folien[aktuell].classList.add('sichtbar');
			folien[aktuell].removeAttribute('tabindex');
			if (hinweis) hinweis.hidden = !('foto' in folien[aktuell].dataset);
			knoepfe[aktuell].setAttribute('aria-current', 'true');
		};

		// wer Bewegung abgeschaltet hat, schaltet nur selbst weiter
		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const takt = ruhig
			? undefined
			: setInterval(() => zeige((aktuell + 1) % folien.length), Number(slider.dataset.sekunden) * 1000);

		knoepfe.forEach((knopf, i) =>
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				zeige(i);
			})
		);
		punkte.hidden = false;
	}

	// Zitate im Flaggen-Kasten: wechseln wie die Fotos, ein Klick auf einen Punkt hält an
	const zitateBox = document.querySelector<HTMLElement>('.zitate');
	const zitatPunkte = document.querySelector<HTMLElement>('.zitat-punkte');
	if (zitateBox && zitatPunkte) {
		const kaesten = [...zitateBox.querySelectorAll<HTMLElement>('.flaggen-kasten')];
		const knoepfe = [...zitatPunkte.querySelectorAll('button')];
		let aktuell = 0;

		const zeige = (n: number) => {
			kaesten[aktuell].classList.remove('sichtbar');
			kaesten[aktuell].setAttribute('aria-hidden', 'true');
			knoepfe[aktuell].removeAttribute('aria-current');
			aktuell = n;
			kaesten[aktuell].classList.add('sichtbar');
			kaesten[aktuell].removeAttribute('aria-hidden');
			knoepfe[aktuell].setAttribute('aria-current', 'true');
		};

		// Aufruf mit /#zitat-…: dieses Zitat zeigen und nicht weiterwechseln
		const angefragt = kaesten.findIndex((k) => k.id && '#' + k.id === location.hash);
		if (angefragt > 0) zeige(angefragt);

		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let takt =
			ruhig || kaesten.length < 2 || angefragt >= 0
				? undefined
				: setInterval(() => zeige((aktuell + 1) % kaesten.length), Number(zitateBox.dataset.sekunden) * 1000);

		knoepfe.forEach((knopf, i) =>
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				zeige(i);
			})
		);
		addEventListener('hashchange', () => {
			const n = kaesten.findIndex((k) => '#' + k.id === location.hash);
			if (n < 0) return;
			clearInterval(takt);
			takt = undefined;
			zeige(n);
		});
		if (kaesten.length > 1) zitatPunkte.hidden = false;
	}

	// Bildnachweis im Zitat-Kasten: Lizenzangaben erst nach Klick auf „Foto“
	const wzKnopf = document.querySelector<HTMLButtonElement>('.wz-knopf');
	const wzLizenz = document.getElementById('wz-lizenz');
	if (wzKnopf && wzLizenz) {
		wzKnopf.hidden = false;
		document.querySelector('.wz-ohne-js')?.remove();
		wzLizenz.hidden = true;
		wzKnopf.addEventListener('click', () => {
			const offen = wzKnopf.getAttribute('aria-expanded') === 'true';
			wzKnopf.setAttribute('aria-expanded', String(!offen));
			wzLizenz.hidden = offen;
			wzKnopf.parentElement?.classList.toggle('offen', !offen);
		});
	}

</script>

<style>
	/* feste Höhe aus dem Seitenverhältnis der Bilder, damit beim Wechsel nichts springt */
	.slider {
		position: relative;
		aspect-ratio: 3 / 2;
		/* zusammen mit dem Innenabstand von main (36,8px) genau 40px bis zur Kopfzeile */
		margin-top: 3.2px;
	}

	/* Auf dem Handy rücken die Bilder noch näher an den oberen Rand */
	@media (max-width: 680px) {
		.slider {
			margin-top: -0.125em;
		}
	}

	/* nur das sichtbare Foto ist anklickbar */
	.folie {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 1s ease;
	}

	.folie.sichtbar {
		opacity: 1;
		pointer-events: auto;
	}

	/* Fotos füllen die Fläche; Bilder in anderem Seitenverhältnis werden am Rand beschnitten */
	.folie img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Zeile unter den Bildern: Punkte in der Mitte, Hinweis rechts; feste Höhe, auch ohne Punkte */
	.unter-slider {
		position: relative;
		min-height: 28px;
		margin: 0.4em 0 1.4em;
	}

	.punkte {
		display: flex;
		justify-content: center;
		gap: 0.2em;
	}

	/* auf dem Handy eigene Zeile unter den Punkten; bei Bildern ohne Hinweis bleibt der Platz frei, damit nichts springt */
	.ki-hinweis {
		margin: 0.2em 0 0;
		font-size: 0.75rem;
		text-align: right;
		color: var(--grau);
	}

	.ki-hinweis[hidden] {
		display: block;
		visibility: hidden;
	}

	/* auf dem Handy steht der Hinweis über den Punkten, direkt unter dem Bild */
	@media (max-width: 659px) {
		.unter-slider {
			display: flex;
			flex-direction: column-reverse;
		}

		.ki-hinweis {
			margin: 0 0 0.2em;
		}
	}

	/* auf breiten Bildschirmen passt er rechts neben die Punkte */
	@media (min-width: 660px) {
		.ki-hinweis {
			position: absolute;
			top: 50%;
			right: 0;
			margin: 0;
			transform: translateY(-50%);
		}
	}

	.punkte[hidden] {
		display: none;
	}

	/* große Klickfläche, sichtbar ist nur der Punkt in der Mitte */
	.punkte button {
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.punkte button::before {
		content: '';
		display: block;
		width: 10px;
		height: 10px;
		margin: auto;
		border-radius: 50%;
		background: #c4c4c4;
		transition: background 0.3s;
	}

	.punkte button[aria-current='true']::before {
		background: var(--schwarz);
	}

	@media (prefers-reduced-motion: reduce) {
		.folie,
		.punkte button::before {
			transition: none;
		}
	}

	.lead {
		font-size: 1.3rem;
	}

	/* Liste direkt unter dem Einleitungssatz, ohne großen Abstand dazwischen */
	.werte {
		margin-top: -0.5em;
	}
	/* Klopp-Zitat als Flagge: drei gleich hohe Streifen Schwarz-Rot-Gold */
	.flaggen-kasten {
		display: grid;
		grid-template-rows: 1fr 1fr 1fr;
	}

	/* alle Zitate liegen übereinander, der Kasten ist so hoch wie das längste; ohne JavaScript bleibt das erste stehen */
	.zitate {
		display: grid;
		margin-top: 1.6em;
	}

	.zitate > .flaggen-kasten {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.6s, visibility 0.6s;
	}

	.zitate > .sichtbar {
		opacity: 1;
		visibility: visible;
	}

	/* wie unter dem Fotoslider: Punkte in der Mitte, „Foto“ rechts auf gleicher Höhe */
	.unter-zitaten {
		position: relative;
		min-height: 28px;
		margin-top: 0.3em;
	}

	.unter-zitaten .wz-nachweis {
		position: absolute;
		top: 14px;
		right: 0;
		margin: 0;
		transform: translateY(-50%);
	}

	/* aufgeklappt ist der Nachweis zu lang für die Zeile, dann steht er darunter */
	.unter-zitaten .wz-nachweis.offen {
		position: static;
		transform: none;
	}

	.streifen {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6em 1.5em;
		padding: 1em 1.5em;
	}

	.streifen p {
		margin: 0;
	}

	.streifen.schwarz {
		background: var(--schwarz);
	}

	.streifen.schwarz .zitat {
		color: var(--gold);
		font-size: 1.5rem;
		font-weight: bold;
		line-height: 1.3;
	}

	.streifen.rot {
		background: var(--rot);
		color: #ffffff;
		font-weight: bold;
	}

	.streifen.gold {
		background: var(--gold);
	}

	/* gelb auf dem goldenen Streifen, mit ganz dünnem, halb durchsichtigem schwarzem Rand */
	.knopf-schwarz {
		padding: 0.6em 1.2em;
		border: 1px solid rgba(0, 0, 0, 0.4);
		background: var(--gold);
		color: var(--schwarz);
		font-weight: bold;
		text-decoration: none;
		border-radius: 4px;
	}

	.knopf-schwarz:hover {
		background: var(--schwarz);
		color: var(--gold);
	}

	.nebenlink {
		color: var(--schwarz);
	}

	.nebenlink:hover {
		color: var(--rot);
	}

	/* Foto als Wasserzeichen über die ganze Flagge, schwarz-weiß; die Flaggenfarben färben es ein */
	.wz {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.wz-bild {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(1) contrast(1.1);
		opacity: 0.25;
		mix-blend-mode: luminosity;
		pointer-events: none;
		z-index: 1;
	}

	.wz .streifen > * {
		position: relative;
		z-index: 2;
	}

	.wz-nachweis {
		margin: 0.2em 0 0;
		color: var(--grau);
		font-size: 0.75rem;
		text-align: right;
	}

	.wz-nachweis a {
		color: inherit;
	}

	/* Originalfoto über den Angaben; wird erst beim Aufklappen geladen (lazy im versteckten Bereich) */
	.original {
		display: block;
		width: 200px;
		margin: 0.4em 0 0.2em auto;
	}

	.original img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* „Foto“ sieht aus wie ein Link */
	.wz-knopf {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}

	.wz-knopf:hover,
	.wz-nachweis a:hover {
		color: var(--rot);
	}

	/* auf dem Handy kleiner, sonst werden die drei gleich hohen Streifen beim längsten Zitat sehr hoch */
	@media (max-width: 540px) {
		.streifen {
			padding: 0.8em 1.1em;
		}

		.streifen.schwarz .zitat {
			font-size: 1.2rem;
		}

		.streifen.rot {
			font-size: 0.95rem;
		}
	}

