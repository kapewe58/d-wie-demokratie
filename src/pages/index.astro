---
import { existsSync } from 'node:fs';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import laptop from '../assets/slider/02-laptop.png';
import tassen from '../assets/slider/04-tassen.png';
import tshirt from '../assets/slider/05-tshirtmaedchen.png';
// Wasserzeichen im Zitat-Kasten (Nachweis unter dem Kasten)
import fotoReichstag from '../assets/flagge/1990-reichstag.jpg';

// Startseite: Fotos, Werte aus dem Grundgesetz, zwei Fragen zum Aufklappen (Herunterladen, Shop) und unsere Motive.
//
// Unsere Motive, durchnummeriert, untereinander mit Links zu PNG, PDF und Shop. Neues Motiv = zwei Dateien ablegen
// und hier einen Eintrag ergänzen:
//   PNG (4000 px breit, transparent): src/assets/motive/motiv-<nr>.png  (Vorschaubild und Download)
//   PDF (CMYK, Druckgröße):           public/download/d-wie-demokratie-motiv-<nr>.pdf
// Ein Motiv erscheint erst, wenn sein PNG da ist; fehlen PDF oder Shop-Link, wird nur dieser Link weggelassen.
// Jedes Motiv ist verlinkbar: /flagge-zeigen/#motiv-<nr>
const liste = [
	{
		nr: 1,
		name: 'D wie Demokratie',
		alt: 'Ein großes D in Schwarz-Rot-Gold, darunter „wie Demokratie“ und die Adresse d-wie-demokratie.de, rechts ein QR-Code, in einem Oval wie beim Länderkennzeichen am Auto.',
		shop: 'https://d-wie-demokratie.myspreadshop.de/all?searchTerm=D%20wie%20Demokratie%20Logo',
	},
	{
		nr: 2,
		name: 'Drei Entchen für die Demokratie',
		alt: 'Drei Badeenten nebeneinander, gezeichnet in Schwarz, Rot und Gold, darunter die Adresse d-wie-demokratie.de.',
		shop: 'https://d-wie-demokratie.myspreadshop.de/all?searchTerm=Drei%20Entchen%20f%C3%BCr%20die%20Demokratie%20%E2%80%93%20Motiv%20%232',
	},
];

// Fotos oben, wechseln alle paar Sekunden; ein Klick springt zum gezeigten Motiv. Neues Foto = nach
// src/assets/slider/ legen (1800 × 1200 Pixel, JPEG), oben importieren und hier eintragen.
// „foto: true“ blendet beim Bild den Hinweis „Foto KI-generiert“ ein.
const bilder = [
	{
		src: laptop,
		motiv: 1,
		foto: true,
		alt: 'Fünf lächelnde Menschen unterschiedlichen Alters und unterschiedlicher Herkunft an einem Tisch vor dem Reichstagsgebäude, auf ihren Laptops der Aufkleber „D wie Demokratie“.',
	},
	{
		src: tassen,
		motiv: 1,
		foto: true,
		alt: 'Fünf lächelnde Menschen, darunter eine Frau mit Kopftuch, halten vor dem Reichstagsgebäude Tassen mit dem Aufdruck „D wie Demokratie“ hoch.',
	},
	{
		src: tshirt,
		motiv: 1,
		foto: true,
		alt: 'Eine junge Frau in einem weißen T-Shirt mit dem Aufdruck „D wie Demokratie“, im Hintergrund der Berliner Fernsehturm im Abendlicht.',
	},
];
const sekunden = 5;

const pngs = import.meta.glob<{ default: ImageMetadata }>('../assets/motive/motiv-*.png', { eager: true });
const motive = liste
	.map((motiv) => ({ ...motiv, bild: pngs[`../assets/motive/motiv-${motiv.nr}.png`]?.default }))
	.filter((motiv) => motiv.bild);
const pdfLink = (nr: number) =>
	existsSync(`public/download/d-wie-demokratie-motiv-${nr}.pdf`) ? `/download/d-wie-demokratie-motiv-${nr}.pdf` : '';

// Zitate im Flaggen-Kasten, wechseln alle paar Sekunden. Neues Zitat = neuer Eintrag.
// Videos und Reden werden nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von Dritten geladen wird.
const zitate = [
	{
		text: 'Den Verächtern der Freiheit dürfen wir diese Farben niemals überlassen! … Schwarz-Rot-Gold, das sind Demokratie und Recht und Freiheit.',
		wer: 'Bundespräsident Frank-Walter Steinmeier, 9. November 2018, Rede im Bundestag',
		knopf: { text: 'Rede nachlesen', url: 'https://www.bundestag.de/resource/blob/577898/1fabb911443e38b78dc622d2b7d1aee6/Rede_BPraes_09November2018.pdf' },
	},
	{
		text: 'Ich würde mir oder uns gerne die Fahne zurückholen.',
		wer: 'Bundestrainer Jürgen Klopp, 17. September 2026',
		knopf: { text: '▶ Video ansehen', url: 'https://www.youtube.com/watch?v=_jfi8T6pU0I&t=1052s' },
	},
	{
		text: 'Wir dürfen uns die Symbole dieses Staates nicht von Rechtsextremen nehmen lassen.',
		wer: 'Verteidigungsminister Boris Pistorius, 8. November 2026, im Interview mit den Funke-Zeitungen',
		// AFP-Meldung; falls der Yahoo-Link einmal tot ist, ersetzen durch die dts-Meldung:
		// https://regionalheute.de/pistorius-will-nationalsymbole-nicht-rechtsextremen-ueberlassen-1794096127/
		knopf: { text: 'Quelle lesen', url: 'https://de.nachrichten.yahoo.com/pistorius-f%C3%BCr-selbstbewussteren-umgang-nationalhymne-092230184.html' },
	},
];
const zitatSekunden = 8;

// Der Shop liegt bei Spreadshop (Spreadshirt) und wird nur verlinkt (pro Motiv), nicht eingebettet,
// damit diese Website frei von Cookies und Inhalten Dritter bleibt.
// false: „Motiv … im Shop“ steht grau und ohne Link da (Shop vorübergehend abgeschaltet)
const shopAktiv = false;
---

<Layout
	title="D wie Demokratie"
	description="Wir zeigen Flagge für unsere Demokratie und das Grundgesetz: Motive kostenlos herunterladen oder im Shop bestellen."
>
	<!-- Fotos liegen übereinander und werden nacheinander eingeblendet; ohne JavaScript bleibt das erste stehen -->
	<div class="slider" data-sekunden={sekunden}>
		{bilder.map((bild, i) => (
			<a href={`#motiv-${bild.motiv}`} class:list={['folie', { sichtbar: i === 0 }]} data-foto={bild.foto ? '' : undefined} tabindex={i === 0 ? undefined : -1}>
				<Image
					src={bild.src}
					alt={bild.alt}
					widths={[400, 700, 1360]}
					sizes="(max-width: 680px) 100vw, 680px"
					loading={i === 0 ? 'eager' : 'lazy'}
				/>
			</a>
		))}
	</div>

	<div class="unter-slider">
		<!-- Punkte zum Weiterschalten; ein Klick hält den automatischen Wechsel an -->
		<div class="punkte" hidden>
			{bilder.map((_, i) => (
				<button type="button" aria-label={`Bild ${i + 1} von ${bilder.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
			))}
		</div>
		<!-- Kennzeichnung nach Art. 50 KI-Verordnung -->
		<p class="ki-hinweis" hidden={!bilder[0].foto}>Foto KI-generiert</p>
	</div>

	<h1>Wir zeigen Flagge</h1>

	<p class="lead">
		<strong>Wir schätzen unsere Demokratie und die zentralen Werte unseres Grundgesetzes:</strong>
	</p>

	<ul class="lead werte">
		<li>
			die Menschenwürde
			<a class="gg" href="https://www.gesetze-im-internet.de/gg/art_1.html" target="_blank" rel="noopener">Art.&nbsp;1&nbsp;GG</a>
		</li>
		<li>
			die freie Entfaltung der Persönlichkeit
			<a class="gg" href="https://www.gesetze-im-internet.de/gg/art_2.html" target="_blank" rel="noopener">Art.&nbsp;2&nbsp;GG</a>
		</li>
		<li>
			die Gleichheit vor dem Gesetz unabhängig von Geschlecht und Herkunft
			<a class="gg" href="https://www.gesetze-im-internet.de/gg/art_3.html" target="_blank" rel="noopener">Art.&nbsp;3&nbsp;GG</a>
		</li>
		<li>
			die Glaubens- und Gewissensfreiheit
			<a class="gg" href="https://www.gesetze-im-internet.de/gg/art_4.html" target="_blank" rel="noopener">Art.&nbsp;4&nbsp;GG</a>
		</li>
		<li>
			die Meinungsfreiheit und die Freiheit von Kunst und Wissenschaft 
			<a class="gg" href="https://www.gesetze-im-internet.de/gg/art_5.html" target="_blank" rel="noopener">Art.&nbsp;5&nbsp;GG</a>
		</li>
	</ul>

	<p class="lead">
		<strong>Deshalb zeigen wir Motive mit den Farben unserer Demokratie in der Öffentlichkeit: als Aufkleber auf unseren Laptops, unseren Autos, auf T-Shirts, Tassen, Taschen und vielem mehr.</strong>
	</p>

	<!-- Klopp-Zitat als Flagge (Schwarz-Rot-Gold); das Video ist nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von YouTube geladen wird -->
	<div class="zitate" data-sekunden={zitatSekunden}>
		{zitate.map((z, i) => (
			<aside class:list={['flaggen-kasten', 'wz', { sichtbar: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
				<Image src={fotoReichstag} alt="" class="wz-bild" widths={[800, 1400]} sizes="(max-width: 680px) 100vw, 680px" />
				<div class="streifen schwarz">
					<p class="zitat">„{z.text}“</p>
				</div>
				<div class="streifen rot">
					<p>{z.wer}</p>
				</div>
				<div class="streifen gold">
					<a class="knopf-schwarz" href={z.knopf.url} target="_blank" rel="noopener">{z.knopf.text}</a>
					<a class="nebenlink" href="/geschichte-unserer-flagge/">Mehr in unserer Flaggengeschichte</a>
				</div>
			</aside>
		))}
	</div>
	<!-- Punkte zum Weiterschalten; ein Klick hält den automatischen Wechsel an -->
	<div class="punkte zitat-punkte" hidden>
		{zitate.map((_, i) => (
			<button type="button" aria-label={`Zitat ${i + 1} von ${zitate.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
		))}
	</div>
	<!-- Bildnachweis: „Foto“ klappt die Lizenzangaben auf (ohne JavaScript stehen sie gleich da), der Text führt zur Flaggengeschichte -->
	<p class="wz-nachweis">
		<button type="button" class="wz-knopf" aria-expanded="false" aria-controls="wz-lizenz" hidden>Foto</button><span class="wz-ohne-js">Foto</span>:
		<a href="/geschichte-unserer-flagge/#1990">Flaggen vor dem Reichstag am 3. Oktober 1990</a>.
		<span id="wz-lizenz">
			Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann,
			<a href="https://creativecommons.org/licenses/by-sa/3.0/de/deed.de" target="_blank" rel="noopener">CC BY-SA 3.0 DE</a>,
			<a href="https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1990-1003-417,_Berlin,_Flaggen_vor_dem_Reichstag.jpg" target="_blank" rel="noopener">Quelle</a>
		</span>
	</p>

	<div class="fragen">
		<details id="herunterladen">
			<summary>Kann ich die Motive herunterladen und selbst drucken (lassen)?</summary>
			<p>
				Ja. Alle unsere Motive stehen Ihnen kostenlos zur Verfügung. Drucken Sie diese selbst oder lassen Sie sie
				von einer Druckerei oder einem Textildrucker oder Dienstleister Ihrer Wahl drucken. Unten finden Sie zu jedem Motiv zwei Dateien:
			</p>
			<ul>
				<li><strong>PNG:</strong> zum Drucken zu Hause, im Copyshop oder für Bildschirm und Social Media, Hintergrund transparent</li>
				<li><strong>PDF:</strong> Druckdatei in CMYK für Druckereien</li>
			</ul>
			<p>
				Brauchen Sie mehrere Stück, etwa für Ihren Verein, Ihre Firma oder Ihre Nachbarschaft? Dann ist das meist der
				günstigste Weg. Online-Druckereien, Textildrucker und Dienstleister stellen Aufkleber, Plakate, T-Shirts, Tassen und alle möglichen Dinge schon in
				kleinen Auflagen oft viel günstiger her, als wenn Sie jedes Stück einzeln in unserem Shop kaufen.
			</p>
			<p>
				Laden Sie dazu die PDF-Datei herunter und geben Sie die Produktion bei einem Anbieter Ihrer Wahl in Auftrag. So entscheiden
				Sie auch selbst, worauf gedruckt wird: zum Beispiel auf Recyclingpapier oder auf Textilien aus Bio-Baumwolle.
			</p>
			<p>
				Sie planen eine kleinere oder größere Auflage? Wir helfen Ihnen gerne dabei. Schreiben Sie uns an
				<a href="mailto:info@d-wie-demokratie.de?subject=Auflage%20D%20wie%20Demokratie" data-umami-event="email-unterstuetzung" data-umami-event-seite="startseite">info@d-wie-demokratie.de</a>.
			</p>
			<p>
				Sie dürfen unsere Motive kostenlos drucken und verteilen. Die Nutzungsrechte dazu erhalten Sie. Die Urheber der einzelnen Motive verzichten ausdrücklich auf Urhebernennung. Verändern dürfen Sie die Motive jedoch nicht. 
			</p>
		</details>

		<details id="shop">
			<summary>Kann ich fertige Produkte mit den Motiven kaufen?</summary>
			<p>
				Bald. Wir suchen gerade eine Shoplösung, die zu unserem Anliegen passt: Produkte aus umweltfreundlichen
				Materialien, fair hergestellt und erst gedruckt, wenn sie bestellt werden. Sobald wir einen passenden Anbieter
				gefunden haben, finden Sie hier Aufkleber, T-Shirts, Tassen und vieles mehr mit unseren Motiven.
			</p>
			<p>
				Bis dahin können Sie alle Motive <a href="#herunterladen">kostenlos herunterladen</a> und selbst drucken oder
				drucken lassen. Wenn Sie erfahren möchten, sobald der Shop da ist, melden Sie sich für unsere
				<a href="#neuigkeiten">Neuigkeiten per E-Mail</a> an.
			</p>
			<p>
				<strong>Wir werden daran nichts verdienen.</strong> Auf eine Provision werden wir verzichten. Sie werden nur zahlen,
				was der Anbieter für Produkt, Druck und Versand berechnet.
			</p>
		</details>
	</div>

	<h2 id="motive">Unsere Motive</h2>

	<ul class="motive">
		{motive.map((motiv) => (
			<li id={`motiv-${motiv.nr}`}>
				<Image src={motiv.bild!} alt={motiv.alt} width={240} widths={[240, 480]} sizes="200px" />
				<div>
					<h3>Motiv {motiv.nr}: {motiv.name}</h3>
					<ul class="links">
						<li>
							<a href={motiv.bild!.src} download={`d-wie-demokratie-motiv-${motiv.nr}.png`} data-umami-event="download-png" data-umami-event-motiv={motiv.nr}>
								Motiv {motiv.nr} als PNG herunterladen
							</a>
						</li>
						{pdfLink(motiv.nr) && (
							<li>
								<a href={pdfLink(motiv.nr)} download data-umami-event="download-pdf" data-umami-event-motiv={motiv.nr}>
									Motiv {motiv.nr} als PDF für Druckereien
								</a>
							</li>
						)}
						{motiv.shop && (
							<li>
								{shopAktiv ? (
									<a href={motiv.shop} target="_blank" rel="noopener" data-umami-event="shop-oeffnen" data-umami-event-motiv={motiv.nr}>
										Motiv {motiv.nr} im Shop
									</a>
								) : (
									<span class="aus">Motiv {motiv.nr} im Shop</span>
								)}
							</li>
						)}
					</ul>
				</div>
			</li>
		))}
	</ul>

	<p class="mehr-motive">
		Weitere Motive kommen bald. <a href="#neuigkeiten">Wir informieren Sie gerne.</a>
	</p>
</Layout>

<script>
	const slider = document.querySelector<HTMLElement>('.slider');
	const punkte = document.querySelector<HTMLElement>('.punkte');
	if (slider && punkte) {
		const folien = [...slider.querySelectorAll<HTMLElement>('.folie')];
		const hinweis = document.querySelector<HTMLElement>('.ki-hinweis');
		const knoepfe = [...punkte.querySelectorAll('button')];
		let aktuell = 0;

		const zeige = (n: number) => {
			folien[aktuell].classList.remove('sichtbar');
			folien[aktuell].tabIndex = -1;
			knoepfe[aktuell].removeAttribute('aria-current');
			aktuell = n;
			folien[aktuell].classList.add('sichtbar');
			folien[aktuell].removeAttribute('tabindex');
			if (hinweis) hinweis.hidden = !('foto' in folien[aktuell].dataset);
			knoepfe[aktuell].setAttribute('aria-current', 'true');
		};

		// wer Bewegung abgeschaltet hat, schaltet nur selbst weiter
		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const takt = ruhig
			? undefined
			: setInterval(() => zeige((aktuell + 1) % folien.length), Number(slider.dataset.sekunden) * 1000);

		knoepfe.forEach((knopf, i) =>
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				zeige(i);
			})
		);
		punkte.hidden = false;
	}

	// Zitate im Flaggen-Kasten: wechseln wie die Fotos, ein Klick auf einen Punkt hält an
	const zitateBox = document.querySelector<HTMLElement>('.zitate');
	const zitatPunkte = document.querySelector<HTMLElement>('.zitat-punkte');
	if (zitateBox && zitatPunkte) {
		const kaesten = [...zitateBox.querySelectorAll<HTMLElement>('.flaggen-kasten')];
		const knoepfe = [...zitatPunkte.querySelectorAll('button')];
		let aktuell = 0;

		const zeige = (n: number) => {
			kaesten[aktuell].classList.remove('sichtbar');
			kaesten[aktuell].setAttribute('aria-hidden', 'true');
			knoepfe[aktuell].removeAttribute('aria-current');
			aktuell = n;
			kaesten[aktuell].classList.add('sichtbar');
			kaesten[aktuell].removeAttribute('aria-hidden');
			knoepfe[aktuell].setAttribute('aria-current', 'true');
		};

		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const takt =
			ruhig || kaesten.length < 2
				? undefined
				: setInterval(() => zeige((aktuell + 1) % kaesten.length), Number(zitateBox.dataset.sekunden) * 1000);

		knoepfe.forEach((knopf, i) =>
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				zeige(i);
			})
		);
		if (kaesten.length > 1) zitatPunkte.hidden = false;
	}

	// Bildnachweis im Zitat-Kasten: Lizenzangaben erst nach Klick auf „Foto“
	const wzKnopf = document.querySelector<HTMLButtonElement>('.wz-knopf');
	const wzLizenz = document.getElementById('wz-lizenz');
	if (wzKnopf && wzLizenz) {
		wzKnopf.hidden = false;
		document.querySelector('.wz-ohne-js')?.remove();
		wzLizenz.hidden = true;
		wzKnopf.addEventListener('click', () => {
			const offen = wzKnopf.getAttribute('aria-expanded') === 'true';
			wzKnopf.setAttribute('aria-expanded', String(!offen));
			wzLizenz.hidden = offen;
		});
	}

	// Links wie /#herunterladen oder /#shop klappen die passende Frage gleich auf.
	function aufklappen() {
		const ziel = location.hash && document.querySelector(location.hash);
		if (ziel instanceof HTMLDetailsElement) ziel.open = true;
	}
	addEventListener('hashchange', aufklappen);
	aufklappen();
</script>

<style>
	/* feste Höhe aus dem Seitenverhältnis der Bilder, damit beim Wechsel nichts springt */
	.slider {
		position: relative;
		aspect-ratio: 3 / 2;
		/* zusammen mit dem Innenabstand von main (36,8px) genau 40px bis zur Kopfzeile */
		margin-top: 3.2px;
	}

	/* Auf dem Handy rücken die Bilder noch näher an den oberen Rand */
	@media (max-width: 680px) {
		.slider {
			margin-top: -0.125em;
		}
	}

	/* nur das sichtbare Foto ist anklickbar */
	.folie {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transition: opacity 1s ease;
	}

	.folie.sichtbar {
		opacity: 1;
		pointer-events: auto;
	}

	/* Fotos füllen die Fläche; Bilder in anderem Seitenverhältnis werden am Rand beschnitten */
	.folie img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Zeile unter den Bildern: Punkte in der Mitte, Hinweis rechts; feste Höhe, auch ohne Punkte */
	.unter-slider {
		position: relative;
		min-height: 28px;
		margin: 0.4em 0 1.4em;
	}

	.punkte {
		display: flex;
		justify-content: center;
		gap: 0.2em;
	}

	.ki-hinweis {
		position: absolute;
		top: 50%;
		right: 0;
		margin: 0;
		transform: translateY(-50%);
		font-size: 0.75rem;
		color: var(--grau);
	}

	.punkte[hidden] {
		display: none;
	}

	/* große Klickfläche, sichtbar ist nur der Punkt in der Mitte */
	.punkte button {
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}

	.punkte button::before {
		content: '';
		display: block;
		width: 10px;
		height: 10px;
		margin: auto;
		border-radius: 50%;
		background: #c4c4c4;
		transition: background 0.3s;
	}

	.punkte button[aria-current='true']::before {
		background: var(--schwarz);
	}

	@media (prefers-reduced-motion: reduce) {
		.folie,
		.punkte button::before {
			transition: none;
		}
	}

	h1 {
		font-size: clamp(1.85rem, 7.5vw, 2.75rem);
	}

	.lead {
		font-size: 1.3rem;
	}

	/* Liste direkt unter dem Einleitungssatz, ohne großen Abstand dazwischen */
	.werte {
		margin-top: -0.5em;
	}
	/* Verweise aufs Grundgesetz: klein und grau, damit sie den Text nicht stören */
	.gg {
		margin-left: 0.3em;
		font-size: 0.65em;
		color: var(--grau);
		text-decoration-color: currentColor;
		text-decoration-thickness: 1px;
		white-space: nowrap;
	}

	/* Klopp-Zitat als Flagge: drei gleich hohe Streifen Schwarz-Rot-Gold */
	.flaggen-kasten {
		display: grid;
		grid-template-rows: 1fr 1fr 1fr;
	}

	/* alle Zitate liegen übereinander, der Kasten ist so hoch wie das längste; ohne JavaScript bleibt das erste stehen */
	.zitate {
		display: grid;
		margin-top: 1.6em;
	}

	.zitate > .flaggen-kasten {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
