---
import { Image } from 'astro:assets';
import aufkleber from '../assets/aufkleber.png';
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="D wie Demokratie"
	description="Eine Initiative für alle, die zeigen wollen, dass sie unsere Demokratie schätzen. Den Aufkleber gibt es hier zum Herunterladen – Nachdruck ausdrücklich erwünscht."
>
	<h1 class="sr-only">D wie Demokratie</h1>

	<Image
		src={aufkleber}
		alt="Aufkleber: ein großes D in Schwarz-Rot-Gold, darunter „wie Demokratie“ und die Adresse d-wie-demokratie.de, in einem Oval wie beim Länderkennzeichen am Auto."
		class="aufkleber"
		widths={[400, 700, 1371]}
		sizes="(max-width: 680px) 100vw, 680px"
		loading="eager"
	/>

	<section class="text">
		<p class="lead">
			<strong>d-wie-demokratie.de</strong> ist eine Initiative für alle, die zeigen wollen,
			dass sie unsere Demokratie schätzen.
		</p>

		<p>
			Aus diesem Grund haben wir den Aufkleber entworfen. Wir wünschen ihm große
			Verbreitung.
		</p>
	</section>

	<section class="download" aria-labelledby="download-titel">
		<h2 id="download-titel">Der Aufkleber zum Herunterladen</h2>

		<p>Der Nachdruck ist ausdrücklich erwünscht.</p>

		<a class="button" href="/aufkleber-d-wie-demokratie.png" download>
			Aufkleber herunterladen (PNG)
		</a>
	</section>
</Layout>

<style>
	.aufkleber {
		display: block;
		width: 100%;
		height: auto;
		margin: 1em 0 2em;
	}

	.lead {
		font-size: 1.3rem;
	}

	.download {
		margin-top: 2.5em;
		padding: 1.5em;
		/* Platz für den 12px breiten Streifen links */
		padding-left: calc(1.5em + 12px);
		/* Schwarz-Rot-Gold nebeneinander, wie der Streifen am oberen Rand, nur um 90° gedreht */
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	.download h2 {
		margin-top: 0;
		font-size: 1.4rem;
	}

	.button {
		display: inline-block;
		margin-top: 0.5em;
		padding: 0.75em 1.4em;
		border-radius: 6px;
		background: var(--schwarz);
		color: #ffffff;
		font-weight: bold;
		text-decoration: none;
	}

	.button:hover {
		background: var(--rot);
		color: #ffffff;
	}
</style>
