---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { motive, shopAktiv, shopStart } from '../data/motive';
import Werte from '../components/Werte.astro';
import Layout from '../layouts/Layout.astro';
// Wasserzeichen im Zitat-Kasten (Nachweis unter dem Kasten)
import fotoReichstag from '../assets/flagge/1990-reichstag.jpg';

// Startseite: Fotos, Werte aus dem Grundgesetz, Zitate und eine Vorschau unserer Motive (alle Motive: /motive/,
// Daten in src/data/motive.ts). Alte Links wie /#motiv-1, /#herunterladen, /#shop leitet das Skript unten auf /motive/ weiter.

// Bilder oben, wechseln alle paar Sekunden; ein Klick springt zum gezeigten Motiv auf /motive/.
// Je fertigem Motiv ein Querformat src/assets/slider/motiv-<nr>.jpg (1800 × 1200, Motiv groß auf Weiß, ohne Text,
// erzeugt mit scripts/slider-querformate.py aus der Druck-PNG); ein Motiv ohne solches Bild wird einfach übersprungen.
// text: Zeile unter dem Bild (gehört zum Link, wechselt mit dem Bild)
// „foto: true“ blendet beim Bild den Hinweis „KI-generiert“ ein (Pflicht nach Art. 50 KI-Verordnung für KI-Fotos;
// seit 2026-11-21 gibt es keine KI-Fotos mehr, später echte Fotos von Shirts usw. hier ergänzen).
const querformate = import.meta.glob<{ default: ImageMetadata }>('../assets/slider/motiv-*.jpg', { eager: true });
const bilder: { src: ImageMetadata; motiv: number; foto?: boolean; alt: string; text: string; video?: string }[] = motive
	.filter((m) => !m.bald && querformate[`../assets/slider/motiv-${m.nr}.jpg`])
	// neuestes Motiv zuerst (wie die Vorschau und /motive/)
	.sort((a, b) => b.nr - a.nr)
	.map((m) => ({
		src: querformate[`../assets/slider/motiv-${m.nr}.jpg`].default,
		motiv: m.nr,
		alt: m.alt,
		text: `Motiv ${m.nr} von ${motive.filter((x) => !x.bald).length}`,
		// Video mit Ton (Feld `video` in motive.ts): „▶ Video abspielen“ neben den Pfeilen, startet erst beim Klick
		video: (m as { video?: string }).video,
	}));
const sekunden = 5;

// Zitate im Flaggen-Kasten, wechseln alle paar Sekunden. Neues Zitat = neuer Eintrag.
// Videos und Reden werden nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von Dritten geladen wird.
// id: eigene Adresse je Zitat, z. B. /#zitat-aigner zeigt dieses Zitat und hält den Wechsel an
const zitate = [
	{
		id: 'zitat-klopp',
		text: 'Ich würde mir oder uns gerne die Fahne zurückholen.',
		wer: 'Bundestrainer Jürgen Klopp, 17. September 2026',
		// „Mehr in unserer Flaggengeschichte“ springt hier direkt zur Station 2026
		mehr: '/geschichte-unserer-flagge/#2026',
		knopf: { text: '▶ Video ansehen', url: 'https://www.youtube.com/watch?v=_jfi8T6pU0I&t=1052s' },
	},
	{
		id: 'zitat-prantl',
		text: 'Es gilt mit aller Kraft zu verhindern, dass aus Schwarz-Rot-Gold ein Schwarz-Rot-Braun wird. Das ist der Auftrag des Grundgesetzes.',
		// Kolumne zu Steinmeiers Rede zum 9. November 2025; auf der Seite steht kein Datum, daher nur der Monat
		wer: 'Heribert Prantl, Journalist und Autor, November 2025, in seiner Kolumne „Prantls Blick“',
		knopf: { text: 'Kolumne lesen', url: 'https://heribertprantl.de/prantls-blick/steinmeier-preist-die-wehrhafte-demokratie-ist-aber-selbst-nicht-wehrhaft-genug/#:~:text=Es%20gilt%20mit%20aller%20Kraft,Auftrag%20des%20Grundgesetzes' },
	},
	{
		id: 'zitat-pistorius',
		text: 'Wir dürfen uns die Symbole dieses Staates nicht von Rechtsextremen nehmen lassen.',
		wer: 'Verteidigungsminister Boris Pistorius, 8. November 2026, im Interview mit den Funke-Zeitungen',
		// AFP-Meldung; falls der Yahoo-Link einmal tot ist, ersetzen durch die dts-Meldung:
		// https://regionalheute.de/pistorius-will-nationalsymbole-nicht-rechtsextremen-ueberlassen-1794096127/#:~:text=Wir%20d%C3%BCrfen%20uns%20die%20Symbole%20dieses%20Staates%20nicht%20von%20Rechtsextremen%20nehmen%20lassen
		knopf: { text: 'Quelle lesen', url: 'https://de.nachrichten.yahoo.com/pistorius-f%C3%BCr-selbstbewussteren-umgang-nationalhymne-092230184.html#:~:text=Wir%20d%C3%BCrfen%20uns%20die%20Symbole%20dieses%20Staates%20nicht%20von%20Rechtsextremen%20nehmen%20lassen' },
	},
	{
		id: 'zitat-steinmeier',
		text: 'Schwarz-Rot-Gold sind die Farben der freiheitlichen Demokratie und der europäischen Völkerfreundschaft, nicht der Nationalisten und Autoritären …',
		wer: 'Bundespräsident Frank-Walter Steinmeier, 18. März 2026, Gastbeitrag zum Tag der Demokratiegeschichte',
		// #:~:text= springt direkt zur Stelle und hebt sie hervor (Seite hat keine Absatz-Anker); Bindestriche dort als %2D
		knopf: { text: 'Beitrag nachlesen', url: 'https://www.bundespraesident.de/SharedDocs/Reden/DE/Frank-Walter-Steinmeier/Zeitungsbeitraege/2026/260317-Tag-der-Demokratiegeschichte-RND.html#:~:text=Schwarz%2DRot%2DGold%20sind%20die%20Farben,Nationalisten%20und%20Autorit%C3%A4ren' },
	},
	{
		id: 'zitat-aigner',
		text: 'Die Feinde der Demokratie sind stark. Aber wir, wir sind viel stärker, weil uns die Freiheit leistungsfähiger, kreativer und solidarischer macht.',
		// Wahl durch die Bundesversammlung am 30. Januar 2027; wenn gewählt, „Bundespräsidentin“ eintragen
		wer: 'Ilse Aigner, Präsidentin des Bayerischen Landtags, 6. Juli 2026',
		// PDF: Textsprung geht dort nicht, #page=23 öffnet die Seite mit dem Zitat
		knopf: { text: 'Rede nachlesen', url: 'https://www.bayern.landtag.de/fileadmin/Internet_Dokumente/Presse/2026-07-06_Rede_LPin_Ilse_Aigner_anl_Auszeichnung_Gro%C3%9Fe_Aula_LMU_zu_Ort_der_Demokratie.pdf#page=23' },
	},
];
const zitatSekunden = 8;

---

<Layout
	title="D wie Demokratie"
	description="Wir zeigen Flagge für unsere Demokratie und das Grundgesetz: Motive kostenlos herunterladen oder im Shop bestellen."
>
	<!-- Bilder liegen übereinander und werden nacheinander eingeblendet; ohne JavaScript bleibt das erste stehen.
	     Pfeile links und rechts der Zeile „Motiv 3 von 14“ blättern und halten den Wechsel an (auch Pfeiltasten). -->
	<div class="slider" data-sekunden={sekunden} role="region" aria-roledescription="Karussell" aria-label="Unsere Motive">
		{bilder.map((bild, i) => (
			<div class:list={['folie', { sichtbar: i === 0 }]} data-foto={bild.foto ? '' : undefined}>
				{/* nur das Bild ist ein Link; die Zeile darunter nicht, damit man neben den Pfeilen nicht versehentlich zu den Motiven springt */}
				<div class="bildfeld">
					<a href={`/motive/#motiv-${bild.motiv}`} tabindex={i === 0 ? undefined : -1}>
						<Image
						src={bild.src}
						alt={bild.alt}
						widths={[400, 700, 1360]}
						sizes="(max-width: 680px) 100vw, 680px"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					</a>
				</div>
				<p class="folie-text">{bild.text}</p>
				{/* „▶ Video abspielen“ rechts in der Zeile unter dem Bild (nur bei Motiven mit Video); das Video wird erst
				    beim Klick geladen und spielt mit Ton an Stelle des Bildes */}
				{bild.video && (
					<button type="button" class="abspielen" data-video={bild.video} tabindex={i === 0 ? undefined : -1} aria-label={`Video mit Ton abspielen: Motiv ${bild.motiv}`}>
						<span class="play" aria-hidden="true"></span><span class="play-wort">Video abspielen</span>
					</button>
				)}
			</div>
		))}
		<div class="pfeile" hidden>
			<button type="button" class="pfeil zurueck" aria-label="Vorheriges Motiv">‹</button>
			<button type="button" class="pfeil weiter" aria-label="Nächstes Motiv">›</button>
		</div>
	</div>

	<div class:list={['unter-slider', { leer: !bilder.some((b) => b.foto) }]}>
		<!-- Kennzeichnung nach Art. 50 KI-Verordnung -->
		<p class="ki-hinweis" hidden={!bilder[0].foto}>KI-Bilder, bald ersetzen wir sie durch echte.</p>
	</div>

	<h1>Wir zeigen Flagge</h1>

	<p class="lead">
		<strong>Wir schätzen unsere Demokratie und die zentralen Werte unseres Grundgesetzes:</strong>
	</p>

	<Werte class="lead werte" />

	<p class="lead">
		<strong>Deshalb bekennen wir in der Öffentlichkeit Farbe. Mit Motiven auf unseren T-Shirts, Taschen, Laptops, Autos, Tassen und vielem mehr.</strong>
	</p>

	<!-- Klopp-Zitat als Flagge (Schwarz-Rot-Gold); das Video ist nur verlinkt, nicht eingebettet, damit beim Seitenaufruf nichts von YouTube geladen wird -->
	<div class="zitate" data-sekunden={zitatSekunden}>
		{zitate.map((z, i) => (
			<aside id={z.id} class:list={['flaggen-kasten', 'wz', { sichtbar: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
				<Image src={fotoReichstag} alt="" class="wz-bild" widths={[800, 1400]} sizes="(max-width: 680px) 100vw, 680px" />
				<div class="streifen schwarz">
					<p class="zitat">„{z.text}“</p>
				</div>
				<div class="streifen rot">
					<p>{z.wer}</p>
				</div>
				<div class="streifen gold">
					<a class="knopf-schwarz" href={z.knopf.url} target="_blank" rel="noopener">{z.knopf.text}</a>
					<a class="nebenlink" href={z.mehr ?? '/geschichte-unserer-flagge/'}>Mehr in unserer Flaggengeschichte</a>
				</div>
			</aside>
		))}
	</div>
	<!-- Punkte zum Weiterschalten (ein Klick hält den automatischen Wechsel an), rechts daneben der Bildnachweis -->
	<div class="unter-zitaten">
	<div class="punkte zitat-punkte" hidden>
		{zitate.map((_, i) => (
			<button type="button" aria-label={`Zitat ${i + 1} von ${zitate.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
		))}
	</div>
	<!-- Bildnachweis: nur „Foto“, ein Klick zeigt die Angaben (ohne JavaScript stehen sie gleich da) -->
	<p class="wz-nachweis">
		<button type="button" class="wz-knopf" aria-expanded="false" aria-controls="wz-lizenz" hidden>Foto</button><span id="wz-lizenz" hidden><span class="wz-ohne-js">Foto</span>:
			<a href="/geschichte-unserer-flagge/#1990">Flaggen vor dem Reichstag am 3. Oktober 1990</a>.
			Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann,
			<a href="https://creativecommons.org/licenses/by-sa/3.0/de/deed.de" target="_blank" rel="noopener">CC BY-SA 3.0 DE</a>,
			<a href="https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1990-1003-417,_Berlin,_Flaggen_vor_dem_Reichstag.jpg" target="_blank" rel="noopener">Quelle</a><a class="original" href="/geschichte-unserer-flagge/#1990"><Image src={fotoReichstag} alt="Originalfoto: Flaggen vor dem Reichstag am 3. Oktober 1990" widths={[200, 400]} sizes="200px" /></a>
		</span>
	</p>
	<!-- versteckt, damit das Originalfoto erst beim Aufklappen lädt; ohne JavaScript stehen die Angaben gleich da -->
	<noscript><style is:inline>#wz-lizenz { display: inline; }</style></noscript>
	</div>

	<!-- Weitere Stimmen: Kampagne „Sommer für Demokratie 2024“ (Artikel 1 – Initiative für Menschenwürde e.V.).
	     #brxe-idyuix = Überschrift „Erstunterzeichnerinnen und Erstunterzeichner“ (vom Seitenbaukasten vergeben).
	     Keine Textmarke (:~:text=), die träfe zuerst denselben Wortlaut im PDF-Absatz darüber. Neuer Tab. -->
	<p class="mehr-stimmen">
		Viele weitere Stimmen für unsere Demokratie, von Ministerpräsidenten bis zu Künstlerinnen:
		<a
			href="https://demokratie-liebe.de/#brxe-idyuix"
			target="_blank"
			rel="noopener"
			data-umami-event="mehr-stimmen">„Sommer für Demokratie“ (2024)&nbsp;↗</a>
	</p>

	<!-- Vorschau: alle Motive als kleine Bilder, neueste zuerst (wie der Standard auf /motive/; später nur die neuesten),
	     alles Weitere auf /motive/ -->
	<h2>Unsere Motive</h2>
	<p class="vorschau-text">Ernst, frech, lustig oder einfach niedlich: Such dir dein Motiv aus. Laufend kommen neue Motive und weitere Produkte im {shopAktiv ? <a href={shopStart} target="_blank" rel="noopener" data-umami-event="shop-oeffnen" data-umami-event-motiv="startseite">Non-Profit-Shop</a> : 'Non-Profit-Shop'} dazu.</p>
	<ul class="vorschau">
		{motive.filter((motiv) => !motiv.bald).sort((a, b) => b.nr - a.nr).map((motiv) => (
			<li>
				<a href={`/motive/#motiv-${motiv.nr}`}>
					<Image src={motiv.fassungen[0].bild!} alt={motiv.alt} width={300} widths={[300, 600]} sizes="(max-width: 540px) 45vw, 300px" />
					<span>{motiv.name}</span>
				</a>
			</li>
		))}
	</ul>
</Layout>

<!-- alte Links auf Motive und Fragen von der Startseite (z. B. /#motiv-2, /#shop) gehen jetzt auf /motive/ -->
<script is:inline>
	if (/^#(motiv-\d+|motive|herunterladen|shop)$/.test(location.hash)) location.replace('/motive/' + (location.hash === '#motive' ? '' : location.hash));
</script>

<script>
	const slider = document.querySelector<HTMLElement>('.slider');
	const pfeile = document.querySelector<HTMLElement>('.slider .pfeile');
	if (slider && pfeile) {
		const folien = [...slider.querySelectorAll<HTMLElement>('.folie')];
		const links = folien.map((f) => f.querySelector('a')!);
		const hinweis = document.querySelector<HTMLElement>('.ki-hinweis');
		let aktuell = 0;

		// Video (nur bei Motiven mit ▶): beim Blättern anhalten und wieder das Bild zeigen
		let video: HTMLVideoElement | null = null;
		const videoWeg = () => {
			video?.pause();
			video?.remove();
			video = null;
			slider.querySelectorAll('.bildfeld.spielt').forEach((f) => f.classList.remove('spielt'));
			slider.querySelectorAll<HTMLElement>('.abspielen').forEach((k) => (k.style.visibility = ''));
		};

		const zeige = (n: number) => {
			videoWeg();
			const fokusDrin = links[aktuell] === document.activeElement;
			folien[aktuell].classList.remove('sichtbar');
			links[aktuell].tabIndex = -1;
			aktuell = (n + folien.length) % folien.length;
			folien[aktuell].classList.add('sichtbar');
			links[aktuell].removeAttribute('tabindex');
			// ▶ nur auf dem sichtbaren Bild per Tab erreichbar
			folien.forEach((f, j) => f.querySelector('.abspielen')?.setAttribute('tabindex', j === aktuell ? '0' : '-1'));
			if (fokusDrin) links[aktuell].focus();
			if (hinweis) hinweis.hidden = !('foto' in folien[aktuell].dataset);
		};

		// wer Bewegung abgeschaltet hat, schaltet nur selbst weiter
		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const takt = ruhig
			? undefined
			: setInterval(() => zeige((aktuell + 1) % folien.length), Number(slider.dataset.sekunden) * 1000);

		const blaettern = (schritt: number) => {
			clearInterval(takt);
			zeige(aktuell + schritt);
		};
		pfeile.addEventListener('click', (e) => {
			const pfeil = (e.target as Element).closest('.pfeil');
			if (pfeil) blaettern(pfeil.classList.contains('weiter') ? 1 : -1);
		});
		slider.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') blaettern(1);
			else if (e.key === 'ArrowLeft') blaettern(-1);
		});
		if (folien.length > 1) pfeile.hidden = false;

		// ▶: Wechsel anhalten, Video an Stelle des Bildes mit Ton abspielen; am Ende bleibt das letzte Bild
		// (= das Motiv) stehen und ▶ erscheint wieder. Klick aufs laufende Video hält an bzw. spielt weiter.
		for (const knopf of slider.querySelectorAll<HTMLButtonElement>('.abspielen')) {
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				videoWeg();
				const v = document.createElement('video');
				v.src = knopf.dataset.video!;
				v.playsInline = true;
				v.setAttribute('aria-label', knopf.getAttribute('aria-label') ?? '');
				v.addEventListener('ended', () => (knopf.style.visibility = ''));
				v.addEventListener('click', () => (v.paused ? v.play() : v.pause()));
				const feld = knopf.closest('.folie')!.querySelector('.bildfeld')!;
				feld.append(v);
				feld.classList.add('spielt');
				video = v;
				// unsichtbar statt verborgen, damit die Zeile auf dem Handy nicht springt
				knopf.style.visibility = 'hidden';
				v.play();
			});
		}
	}

	// Zitate im Flaggen-Kasten: wechseln wie die Fotos, ein Klick auf einen Punkt hält an
	const zitateBox = document.querySelector<HTMLElement>('.zitate');
	const zitatPunkte = document.querySelector<HTMLElement>('.zitat-punkte');
	if (zitateBox && zitatPunkte) {
		const kaesten = [...zitateBox.querySelectorAll<HTMLElement>('.flaggen-kasten')];
		const knoepfe = [...zitatPunkte.querySelectorAll('button')];
		let aktuell = 0;

		const zeige = (n: number) => {
			kaesten[aktuell].classList.remove('sichtbar');
			kaesten[aktuell].setAttribute('aria-hidden', 'true');
			knoepfe[aktuell].removeAttribute('aria-current');
			aktuell = n;
			kaesten[aktuell].classList.add('sichtbar');
			kaesten[aktuell].removeAttribute('aria-hidden');
			knoepfe[aktuell].setAttribute('aria-current', 'true');
		};

		// Aufruf mit /#zitat-…: dieses Zitat zeigen und nicht weiterwechseln
		const angefragt = kaesten.findIndex((k) => k.id && '#' + k.id === location.hash);
		if (angefragt > 0) zeige(angefragt);

		const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let takt =
			ruhig || kaesten.length < 2 || angefragt >= 0
				? undefined
				: setInterval(() => zeige((aktuell + 1) % kaesten.length), Number(zitateBox.dataset.sekunden) * 1000);

		knoepfe.forEach((knopf, i) =>
			knopf.addEventListener('click', () => {
				clearInterval(takt);
				zeige(i);
			})
		);
		addEventListener('hashchange', () => {
			const n = kaesten.findIndex((k) => '#' + k.id === location.hash);
			if (n < 0) return;
			clearInterval(takt);
			takt = undefined;
			zeige(n);
		});
		if (kaesten.length > 1) zitatPunkte.hidden = false;
	}

	// Bildnachweis im Zitat-Kasten: Lizenzangaben erst nach Klick auf „Foto“
	const wzKnopf = document.querySelector<HTMLButtonElement>('.wz-knopf');
	const wzLizenz = document.getElementById('wz-lizenz');
	if (wzKnopf && wzLizenz) {
		wzKnopf.hidden = false;
		document.querySelector('.wz-ohne-js')?.remove();
		wzLizenz.hidden = true;
		wzKnopf.addEventListener('click', () => {
			const offen = wzKnopf.getAttribute('aria-expanded') === 'true';
			wzKnopf.setAttribute('aria-expanded', String(!offen));
			wzLizenz.hidden = offen;
			wzKnopf.parentElement?.classList.toggle('offen', !offen);
		});
	}

</script>

<style>
	/* alle Folien liegen in derselben Rasterzelle übereinander; die Höhe richtet sich nach der höchsten, damit beim Wechsel nichts springt */
	.slider {
		display: grid;
		/* zusammen mit dem Innenabstand von main (36,8px) genau 40px bis zur Kopfzeile */
		margin-top: 3.2px;
	}

	/* Auf dem Handy rücken die Bilder noch näher an den oberen Rand */
	@media (max-width: 680px) {
		.slider {
			margin-top: -0.125em;
		}
	}

	/* nur das sichtbare Foto ist anklickbar */
	.folie {
		grid-area: 1 / 1;
		opacity: 0;
		pointer-events: none;
		transition: opacity 1s ease;
	}

	.folie.sichtbar {
		opacity: 1;
		pointer-events: auto;
	}

	.folie a {
		display: block;
	}

	/* Bilder im Format 3:2; andere Seitenverhältnisse werden am Rand beschnitten */
	.folie img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	/* Handy: Motivbilder quadratisch zuschneiden (nur das Weiß links und rechts fällt weg), damit das runde Motiv
	   fast die ganze Breite füllt; das Video wird mit object-fit: cover genauso beschnitten. Fotos (data-foto) bleiben 3:2. */
	@media (max-width: 599px) {
		.folie:not([data-foto]) img {
			aspect-ratio: 1 / 1;
		}
	}

	/* Bild mit ▶ für Motive mit Video; das Video liegt beim Abspielen genau über dem Bild (beide 3:2) */
	.bildfeld {
		position: relative;
	}

	.bildfeld :global(video) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: #fff;
		cursor: pointer;
		/* Videoweiß ist nach der Komprimierung minimal grau; so verschmilzt es mit dem Weiß der Seite */
		mix-blend-mode: multiply;
		/* Chrome zeigt Videoweiß etwas dunkler als Seitenweiß an; leicht aufhellen, damit kein grauer Kasten bleibt */
		filter: brightness(1.04);
	}

	/* solange das Video da ist, das starre Bild darunter ausblenden (sonst scheint es durch) */
	.bildfeld.spielt img {
		visibility: hidden;
	}

	/* Weiß dahinter, damit „multiply“ das Videoweiß zu reinem Weiß macht (die Folie ist eine eigene Ebene) */
	.bildfeld.spielt {
		background: #fff;
	}

	/* „▶ Video abspielen“: länglicher Knopf, so hoch wie die Pfeile; am Computer 12 px rechts neben „‹ Motiv 16 von 17 ›“,
	   auf dem Handy mittig in einer eigenen Zeile darunter */
	.folie {
