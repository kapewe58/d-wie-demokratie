import grundgesetz from '../assets/flagge/1949-grundgesetz.jpg';
import reichstag from '../assets/flagge/1990-reichstag.jpg';
import fanmeile from '../assets/flagge/2006-fanmeile.jpg';

// Bilder von Wikimedia Commons, lokal abgelegt (keine Anfragen an Dritte).
// Jede Lizenz verlangt die Angaben in „nachweis“; die vollständigen Angaben stehen unten unter „Bildnachweise“.
// Die ausführlichen Texte für „Noch mehr erfahren“ stehen in src/data/flagge-vertiefung.ts.

// ein Tipp unter „Wo kann ich das erleben?“; art ist die kleine graue Überschrift (Ort, Für Schulen, Lied …)
type Erlebnis = {
	art?: string;
	titel?: string;
	text?: string;
	links: { text: string; url: string }[];
};

type Station = {
	jahr: string;
	titel: string;
	text: string;
	// Absätze für „Mehr erfahren“; ein Zitat wird wie unter „Noch mehr erfahren“ als Zitatblock gesetzt
	mehr: (string | { zitat: string; herkunft: string })[];
	bild?: Bild;
	bildMehr?: Bild;
	// „Wo kann ich das erleben?“: Orte, Lieder, Bücher, Filme zur Station
	erleben?: Erlebnis[];
	// true: „Mehr erfahren“, „Noch mehr erfahren“ und „Wo kann ich das erleben?“ stehen offen da, ohne Ausklapplink
	offen?: boolean;
};

const stationen: Station[] = [
	{
		jahr: '1815',
		titel: 'Die frühen Wurzeln',
