					{ text: 'Das Wartburgfest und das Fest der Demokratie', url: 'https://www.wartburg.de/wartburgfest' },
					{ text: 'Die Fahne im Festsaal', url: 'https://www.wartburg.de/objekte/fahne-der-jenaer-urburschenschaft' },
