				links: [{ text: 'Gedenkstätte Berliner Mauer', url: 'https://www.stiftung-berliner-mauer.de/de/gedenkstaette-berliner-mauer' }],
			},
			{
				art: 'Ort',
				titel: 'Flagge der Einheit vor dem Reichstag in Berlin',
				text: 'Auf dem Platz der Republik weht die größte Bundesflagge Deutschlands: 60 Quadratmeter an einem 28,5 Meter hohen Mast, nachts angestrahlt. In der Nacht zum 3. Oktober 1990 wurde sie hier zum ersten Mal um Mitternacht gehisst. Die Flagge von damals bewahrt heute das Haus der Geschichte in Bonn.',
				links: [{ text: 'Die Flagge der Einheit (Deutscher Bundestag)', url: 'https://www.bundestag.de/dokumente/textarchiv/2023/kw34-rtg-flagge-der-einheit-383254' }],
			},
			{
				art: 'Mehr dazu',
				titel: 'Der Weg zur deutschen Einheit',
				text: 'Das Bundesarchiv erzählt die elf Monate zwischen Mauerfall und Einheit mit Fotos und Dokumenten aus seinen Beständen.',
				links: [{ text: 'Beim Bundesarchiv ansehen', url: 'https://www.bundesarchiv.de/themen-entdecken/online-entdecken/storys/der-weg-zur-deutschen-einheit/' }],
			},
		],
	},
	{
		jahr: '2026',
		titel: 'Wir holen uns die Fahne zurück',
		offen: true,
		text: 'Immer wieder versuchen Rechtsextreme, Schwarz-Rot-Gold für sich zu vereinnahmen. Doch immer mehr Menschen halten dagegen. Am 17. September 2026 setzt der neue Bundestrainer Jürgen Klopp bei seiner ersten Kaderbekanntgabe ein Zeichen.',
		mehr: [
			'Er trägt eine Kappe mit einem Emblem in Schwarz-Rot-Gold und sagt:',
			{
				zitat: 'Ich würde mir oder uns gerne die Fahne zurückholen. Wenn ich ganz ehrlich bin. Ich möchte, dass, wenn man sie schwingt, dass niemand denkt: ‚Was ist mit dir nicht in Ordnung‘, sondern dass man einfach nur das Gefühl hat, du bist happy und verstehst, dass du Glück hattest, dass du in diesem wundervollen Land geboren, aufgewachsen, zugezogen, wie auch immer, dass du hier lebst. Das hätte ich schon ganz gerne. … Ich möchte den Nationalstolz nicht den falschen Leuten überlassen. …',
				herkunft: 'Jürgen Klopp, Bundestrainer',
			},
		],
		bild: {
			src: fanmeile,
			alt: 'Farbfoto: Eine Menschenmenge jubelt mit erhobenen Armen, über den Köpfen viele schwarz-rot-goldene Fahnen.',
			unterschrift: 'So kann es aussehen: Fans auf der Berliner Fanmeile bei der Fußball-Weltmeisterschaft 2006',
			nachweis: 'Foto: Will Collins (aufgehellt und geschärft)',
			lizenz: lizenz.ccBySa30,
			quelle: 'https://commons.wikimedia.org/wiki/File:Worldcup_2006_Berlin.jpg',
		},
		erleben: [
			{
				titel: 'Die Pressekonferenz im Original',
				links: [{ text: 'Auf YouTube ansehen (ab 17:32)', url: 'https://www.youtube.com/watch?v=_jfi8T6pU0I&t=1052s' }],
			},
		],
	},
