// „vor … Jahren“: beim Bauen der Seite berechnet und im Browser mit dem aktuellen Jahr nachgeführt,
// damit es auch stimmt, wenn die Seite länger nicht neu veröffentlicht wurde. Bei „1933–1935“ zählt das erste Jahr.
const vorJahren = (jahr: string) => new Date().getFullYear() - parseInt(jahr, 10);
// „in diesem Jahr“, „vor einem Jahr“, „vor 211 Jahren“
const vorText = (n: number) => (n <= 0 ? '– in diesem Jahr' : n === 1 ? '– vor einem Jahr' : `– vor ${n} Jahren`);

const alleBilder = [
	...stationen.flatMap((s) => [s.bild, s.bildMehr].filter((b): b is Bild => Boolean(b))),
	...vertiefungsBilder,
];
---

<Layout
	title="Kleine Geschichte unserer Flagge – D wie Demokratie"
	description="Von der Freiheitsbewegung bis zum Grundgesetz: die Geschichte von Schwarz-Rot-Gold in acht Stationen, bis heute."
>
	<h1>Kleine Geschichte unserer Flagge</h1>

	<p class="lead">
		Unsere Farben Schwarz-Rot-Gold verdanken wir Menschen, die für die Einheit Deutschlands, für Freiheit,
		Gleichberechtigung und demokratische Mitbestimmung gekämpft haben. Viele von ihnen haben dafür mit ihrem
		Leben bezahlt.
	</p>

	<p>
		Die Bedeutung unserer Nationalfarben als Symbol der Demokratie reicht weit
		ins 19. Jahrhundert zurück. Entdecken Sie die wichtigsten Stationen.
	</p>

	<!-- Sprungleiste: bleibt beim Scrollen unter der Kopfzeile stehen, die sichtbare Station ist hervorgehoben -->
	<nav class="jahre" aria-label="Stationen der Geschichte">
		<ul>
			{stationen.map((s) => (
				<li><a href={`#${s.jahr.slice(0, 4)}`} title={s.titel}>{s.jahr.slice(0, 4)}</a></li>
			))}
		</ul>
	</nav>

	<ol class="zeitstrahl">
		{stationen.map((s) => {
			const Mehr = s.offen ? 'div' : 'details';
			return (
			<li class="station" id={s.jahr.slice(0, 4)}>
				<p class="jahr">{s.jahr} <span class="vor" data-jahr={parseInt(s.jahr, 10)}>{vorText(vorJahren(s.jahr))}</span></p>
				<h2>{s.titel}</h2>
				<p>{s.text}</p>
				{s.bild && (
					<figure>
						<Image src={s.bild.src} alt={s.bild.alt} widths={[600, 1200]} sizes="(max-width: 680px) 100vw, 600px" />
						<figcaption>{s.bild.unterschrift}. <span class="nachweis">{s.bild.nachweis}, {s.bild.lizenz.text}</span></figcaption>
					</figure>
				)}
				<Mehr class="mehr">
					{!s.offen && <summary>Mehr erfahren</summary>}
					{s.mehr.map((absatz) =>
						typeof absatz === 'string' ? <p>{absatz}</p> : (
							<blockquote>
								<p>„{absatz.zitat}“</p>
								<footer>{absatz.herkunft}</footer>
							</blockquote>
						)
					)}
					{s.bildMehr && (
						<figure>
							<Image src={s.bildMehr.src} alt={s.bildMehr.alt} widths={[400, 800]} sizes="(max-width: 680px) 100vw, 600px" class={s.bildMehr.hoch ? 'hoch' : undefined} />
							<figcaption>{s.bildMehr.unterschrift}. <span class="nachweis">{s.bildMehr.nachweis}, {s.bildMehr.lizenz.text}</span></figcaption>
						</figure>
					)}
					{vertiefung[s.jahr] && (
						<Mehr class="vertiefung">
							{!s.offen && <summary>Noch mehr erfahren</summary>}
							<div class="vertiefung-inhalt">
								{vertiefung[s.jahr].map((b) => (
									b.art === 'titel' ? <h3>{b.text}</h3>
									: b.art === 'absatz' ? <p>{b.text}</p>
									: b.art === 'zitat' ? (
										<blockquote>
											<p>„{b.text}“</p>
											<footer>{b.herkunft}</footer>
										</blockquote>
									)
									: b.art === 'bild' ? (
										<figure>
											<Image src={b.bild.src} alt={b.bild.alt} widths={[600, 1200]} sizes="(max-width: 680px) 100vw, 600px" />
											<figcaption>{b.bild.unterschrift}. <span class="nachweis">{b.bild.nachweis}, {b.bild.lizenz.text}</span></figcaption>
										</figure>
									)
									: (
										<div class="flaggen">
											{b.flaggen.map((f) => (
												<figure>
													<Image src={f.src} alt={f.alt} widths={[240, 480]} sizes="200px" />
													<figcaption><strong>{f.name}</strong><br />{f.zeit}</figcaption>
												</figure>
											))}
										</div>
									)
								))}
								{vertiefung[s.jahr].some((b) => b.art === 'bild' || b.art === 'flaggen') && (
									<p class="zuklappen-hinweis">Quellen der Bilder unten unter „Bildnachweise“.</p>
								)}
							</div>
						</Mehr>
					)}
					{s.erleben && (
						<Mehr class="erleben">
							{!s.offen && <summary>Wo kann ich das erleben?</summary>}
							<ul class="tipps">
								{s.erleben.map((t) => (
									<li>
										{t.art && <p class="tipp-art">{t.art}</p>}
										{t.titel && <h3>{t.titel}</h3>}
										{t.text && <p>{t.text}</p>}
										{t.links.length > 0 && (
											<p class="tipp-links">
												{t.links.map((l) => (l.url.startsWith('/') ? <a href={l.url}>{l.text}</a> : <a href={l.url} target="_blank" rel="noopener">{l.text}</a>))}
											</p>
										)}
									</li>
								))}
							</ul>
						</Mehr>
					)}
				</Mehr>
			</li>
			);
		})}
	</ol>

	<!-- Schlusskasten als Flagge, wie der Klopp-Kasten auf der Startseite -->
	<section class="schluss wz">
		<Image src={reichstag} alt="" class="wz-bild" widths={[800, 1400]} sizes="(max-width: 680px) 100vw, 680px" />
		<div class="streifen schwarz">
			<h2>Holen wir uns die Fahne zurück</h2>
		</div>
		<div class="streifen rot">
			<p>
				Laden Sie unsere Motive in Schwarz-Rot-Gold kostenlos herunter, als Aufkleber für Ihr Auto oder Ihren Laptop,
				für T-Shirts, Tassen und vieles mehr.
			</p>
		</div>
		<div class="streifen gold">
			<a class="knopf-schwarz" href="/#motive">Zu unseren Motiven</a>
		</div>
	</section>
	<!-- Bildnachweis wie auf der Startseite: nur „Foto“, ein Klick zeigt die Angaben -->
	<p class="wz-nachweis">
		<button type="button" class="wz-knopf" aria-expanded="false" aria-controls="wz-lizenz" hidden>Foto</button><span id="wz-lizenz"><span class="wz-ohne-js">Foto</span>:
			<a href="#1990">Flaggen vor dem Reichstag am 3. Oktober 1990</a>.
			Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann,
			<a href="https://creativecommons.org/licenses/by-sa/3.0/de/deed.de" target="_blank" rel="noopener">CC BY-SA 3.0 DE</a>,
			<a href="https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-1990-1003-417,_Berlin,_Flaggen_vor_dem_Reichstag.jpg" target="_blank" rel="noopener">Quelle</a>
		</span>
	</p>

	<section class="nachweise">
		<h2>Quellen und weiterführende Informationen</h2>
		<p>Die Darstellung ist bewusst kurz gehalten. Zum Weiterlesen:</p>
		<ul>
			<li><a href="https://de.wikipedia.org/wiki/Schwarz-Rot-Gold" target="_blank" rel="noopener">Wikipedia: Schwarz-Rot-Gold</a></li>
			<li><a href="https://de.wikipedia.org/wiki/Flagge_Deutschlands" target="_blank" rel="noopener">Wikipedia: Flagge Deutschlands</a></li>
			<li><a href="https://www.gesetze-im-internet.de/gg/art_22.html" target="_blank" rel="noopener">Grundgesetz, Artikel 22</a></li>
			<li><a href="https://www.demokratiegeschichten.de/flaggenkampf-in-der-weimarer-republik/" target="_blank" rel="noopener">Der Flaggenkampf in der Weimarer Republik</a></li>
			<li><a href="https://www.reichsbanner.de/" target="_blank" rel="noopener">Reichsbanner Schwarz-Rot-Gold, Bund aktiver Demokraten e.V.</a></li>
		</ul>

		<h2>Bildnachweise</h2>
		<p>Alle Bilder stammen von Wikimedia Commons.</p>
		<ul>
			{alleBilder.map((b) => (
				<li>
					{b.unterschrift}: {b.nachweis}, {b.lizenz.url ? <a href={b.lizenz.url} target="_blank" rel="noopener">{b.lizenz.text}</a> : b.lizenz.text},
					{' '}<a href={b.quelle} target="_blank" rel="noopener">Quelle</a>
				</li>
			))}
		</ul>
	</section>
</Layout>

<script>
	// Bildnachweis im Schlusskasten: Lizenzangaben erst nach Klick auf „Foto“
	const wzKnopf = document.querySelector<HTMLButtonElement>('.wz-knopf');
	const wzLizenz = document.getElementById('wz-lizenz');
	if (wzKnopf && wzLizenz) {
		wzKnopf.hidden = false;
		document.querySelector('.wz-ohne-js')?.remove();
		wzLizenz.hidden = true;
		wzKnopf.addEventListener('click', () => {
			const offen = wzKnopf.getAttribute('aria-expanded') === 'true';
			wzKnopf.setAttribute('aria-expanded', String(!offen));
			wzLizenz.hidden = offen;
		});
	}

	const jetzt = new Date().getFullYear();
	for (const el of document.querySelectorAll<HTMLElement>('.vor')) {
		const n = jetzt - Number(el.dataset.jahr);
		el.textContent = n <= 0 ? '– in diesem Jahr' : n === 1 ? '– vor einem Jahr' : `– vor ${n} Jahren`;
	}
	// Sprungleiste: Höhe der Kopfzeile messen (die Leiste klebt darunter) und die sichtbare Station hervorheben
	const kopf = document.querySelector<HTMLElement>('.kopf');
	const leiste = document.querySelector<HTMLElement>('.jahre');
	const stationen = [...document.querySelectorAll<HTMLElement>('.station')];
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.jahre a')];

	function hoehenSetzen() {
		document.documentElement.style.setProperty('--kopf-hoehe', `${kopf?.offsetHeight ?? 0}px`);
		document.documentElement.style.setProperty('--leiste-hoehe', `${leiste?.offsetHeight ?? 0}px`);
	}

	let aktiv = -1;
	function aktuelleStation() {
		const grenze = (kopf?.offsetHeight ?? 0) + (leiste?.offsetHeight ?? 0) + 40;
		let index = -1;
		stationen.forEach((station, i) => {
			if (station.getBoundingClientRect().top <= grenze) index = i;
		});
		if (index === aktiv) return;
		aktiv = index;
		links.forEach((link, i) => {
			if (i === index) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		});
		// auf dem Handy die aktuelle Jahreszahl in der Leiste sichtbar halten
		const link = links[index];
		if (link && leiste) {
			const ziel = link.offsetLeft - (leiste.clientWidth - link.offsetWidth) / 2;
			leiste.scrollTo({ left: ziel, behavior: 'smooth' });
		}
	}

	let geplant = false;
	addEventListener(
		'scroll',
		() => {
			if (geplant) return;
			geplant = true;
			requestAnimationFrame(() => {
				geplant = false;
				aktuelleStation();
			});
		},
		{ passive: true }
	);
	addEventListener('resize', () => {
		hoehenSetzen();
		aktuelleStation();
	});
	hoehenSetzen();
	aktuelleStation();
</script>

