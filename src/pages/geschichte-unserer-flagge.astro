		],
		bild: {
			src: reichstag,
			alt: 'Farbfoto: Viele Menschen vor dem Reichstagsgebäude in Berlin, davor Fahnenmasten mit der Bundesflagge und den Flaggen der Bundesländer.',
			unterschrift: 'Flaggen vor dem Reichstag am 3. Oktober 1990',
			nachweis: 'Bundesarchiv, Bild 183-1990-1003-417, Foto: Thomas Uhlemann',
