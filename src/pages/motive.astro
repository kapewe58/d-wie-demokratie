---
// Reiter „Motive“: alle Motive mit Fassungen, Download (PNG, PDF) und Shop-Link, dazu die Fragen zum Herunterladen
// und zum Shop. Die Motive selbst stehen in src/data/motive.ts (auch für die Vorschau auf der Startseite).
// /#motiv-<nr>, /#herunterladen und /#shop von früher leitet die Startseite hierher weiter.
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Werte from '../components/Werte.astro';
import Ziele from '../components/Ziele.astro';
import { gestalterAktiv, gestalterVon } from '../data/gestalter';
// „Über dieses Motiv“ (kleines i am Titel): sobald ein Gestalter eingetragen ist und gestalterAktiv (vorerst nur lokal);
const zeigeInfo = (m: unknown) => gestalterAktiv && !!(m as { gestalter?: string }).gestalter;
import { motive, pdfLink, shopAktiv, shopStart, stoff, kommentareAktiv, kommentarUrl, type Kommentar } from '../data/motive';
// Kommentare eines Motivs; lokal zeigt Motiv 1 einen Beispiel-Kommentar, damit man die Darstellung sieht
const kommentareVon = (m: { nr: number }): (Kommentar & { beispiel?: boolean })[] => {
	const echte = (m as { kommentare?: Kommentar[] }).kommentare ?? [];
	if (import.meta.env.DEV && m.nr === 1 && !echte.length)
		return [{ name: 'Erika Beispiel', zusatz: 'Lehrerin, Köln', text: 'So ein Kommentar würde hier stehen: kurz und persönlich.', seit: '2026-11-25', beispiel: true }];
	return echte;
};
// „Motiv einreichen“ pausiert seit 2026-11-20: Links nur lokal mit „npm run dev“. Zum Wiedereinschalten auf true setzen
// (dazu entwurf in motiv-einreichen.astro, im Menü in Layout.astro und den Sitemap-Filter in astro.config.mjs).
const einreichenAktiv = import.meta.env.DEV;

// Großansicht: Klick auf ein Motiv öffnet es groß in einem Fenster (<dialog> unten), ohne JavaScript das Bild allein.
// Je Fassung ein großes Bild, Schlüssel „<nr><endung>“; Stoffton wie in der kleinen Vorschau.
const gross = new Map<string, string>();
for (const motiv of motive) {
	for (const f of motiv.fassungen) {
		const bild = await getImage({ src: f.bild!, width: Math.min(1400, f.bild!.width), format: 'webp' });
		gross.set(`${motiv.anker}${f.endung}`, bild.src);
	}
}
// helle Fassungen: dezentes Schachbrett, damit man sieht, was durchsichtig ist (wie in Grafikprogrammen)
const grundStoff = 'repeating-conic-gradient(#eeeeee 0% 25%, #ffffff 0% 50%) 0 0 / 16px 16px';
// Motive mit nur einer Fassung (die runden 3–12) zeigen den Hintergrund „für alle Produkte“ (blaugrau, wie Motiv 1 und 13)
const einzelStoff = (m: { fassungen: unknown[] }) => (m.fassungen.length === 1 ? '#71839b' : undefined);
// farbige Stoffe (dunkle Fassungen usw.): Schachbrett im Stoffton, das zweite Feld etwas heller
const karo = (farbe: string) => {
	const hell = '#' + [1, 3, 5].map((i) => Math.min(255, parseInt(farbe.slice(i, i + 2), 16) + 14).toString(16).padStart(2, '0')).join('');
	return `repeating-conic-gradient(${farbe} 0% 25%, ${hell} 0% 50%) 0 0 / 16px 16px`;
};
---

<Layout
	title="Unsere Motive – D wie Demokratie"
	description="Motive für Demokratie und Grundgesetz in Schwarz-Rot-Gold: kostenlos herunterladen, selbst drucken oder fertig bedruckt im Shop bestellen."
>
	<h1>Wir haben ein Motiv und viele Motive</h1>

	<p class="lead">
		Ernst, frech, lustig oder einfach niedlich: Such dir dein Motiv aus. Laufend kommen neue Motive und weitere Produkte im Non-Profit-Shop dazu.
	</p>

	<div class="fragen">
		<details id="beisteuern">
			<summary>Kann ich selbst Motive beisteuern?</summary>
			<p>
				<strong>Ja!</strong> Wir wünschen uns viele Motive von kleinen und großen Künstlern. Gemalt,
				gezeichnet, fotografiert oder am Computer entworfen, alles ist erlaubt.
			</p>
			<p>
				Es muss nicht perfekt sein. Eine gute Idee oder eine Skizze genügt für den Anfang. Gemeinsam machen wir daraus
				ein Motiv, das sich gut drucken lässt.
			</p>
			<p>
				Wichtig ist nur: Dein Motiv passt zu unseren
				<button type="button" class="aufklappen" aria-expanded="false" aria-controls="werte-ziele" hidden>Werten und Zielen</button><span class="aufklappen-text">Werten und Zielen</span>
				und stammt von dir.
			</p>
			<!-- wie auf /verbuendete/: ohne JavaScript gleich offen -->
			<div class="werte-ziele" id="werte-ziele">
				<div class="werte-ziele-innen">
					<p><strong>Unsere Werte</strong> sind die zentralen Werte unseres Grundgesetzes:</p>
					<Werte />
					<p><strong>Unsere Ziele:</strong></p>
					<Ziele />
				</div>
			</div>
			<p>
				Wenn wir dein Motiv aufnehmen, erscheint daneben ein kleines <span class="info-zeichen" aria-hidden="true">i</span>.
				Ein Klick darauf zeigt Infos zu dir und deinem Motiv.
			</p>
			<p>
				Wie alle unsere Motive darf es dann jeder kostenlos drucken und teilen. Die Einzelheiten besprechen wir gemeinsam
				mit dir.
			</p>
			<p>
				Nimm einfach Kontakt auf: Schreib uns an
				<a href="mailto:info@d-wie-demokratie.de?subject=Mein%20Motiv%20f%C3%BCr%20D%20wie%20Demokratie" data-umami-event="email-design" data-umami-event-seite="motive">info@d-wie-demokratie.de</a>
				und erzähl uns von deiner Idee, gern mit einem Foto oder einer Skizze.
			</p>
		</details>

		<details id="herunterladen">
			<summary>Kann ich die Motive herunterladen und selbst drucken (lassen)?</summary>
			<p>
				Ja. Alle unsere Motive stehen dir kostenlos zur Verfügung. Druck sie selbst oder lass sie
				von einer Druckerei oder einem Textildrucker oder Dienstleister deiner Wahl drucken.
			</p>
			<p>
				Unten findest du zu jedem Motiv eine <strong>PNG-Datei</strong> (4000 Pixel, Hintergrund transparent). Sie eignet
				sich zum Drucken zu Hause, im Copyshop, für Online-Druckereien, Textildruck und Social Media. Bei einigen Motiven
				gibt es zusätzlich ein <strong>PDF</strong> in CMYK für Druckereien.
			</p>
			<p>
				Brauchst du mehrere Stück, etwa für deinen Verein, deine Firma oder deine Nachbarschaft? Dann ist das meist der
				günstigste Weg. Online-Druckereien, Textildrucker und Dienstleister stellen Aufkleber, Plakate, T-Shirts, Tassen und alle möglichen Dinge schon in
				kleinen Auflagen günstig her.
			</p>
			<p>
				Lade dazu die Datei herunter und gib die Produktion bei einem Anbieter deiner Wahl in Auftrag. So entscheidest
				du auch selbst, worauf gedruckt wird: zum Beispiel auf Recyclingpapier oder auf Textilien aus Bio-Baumwolle.
			</p>
			<p>
				Du planst eine kleinere oder größere Auflage? Wir helfen dir gerne dabei. Schreib uns an
				<a href="mailto:info@d-wie-demokratie.de?subject=Auflage%20D%20wie%20Demokratie" data-umami-event="email-unterstuetzung" data-umami-event-seite="motive">info@d-wie-demokratie.de</a>.
			</p>
			<p>
				Du darfst unsere Motive kostenlos drucken und verteilen. Die Nutzungsrechte dazu erhältst du. Verändern darfst du die Motive jedoch nicht.
			</p>
		</details>

		<details id="shop">
			<summary>Kann ich fertige Produkte mit den Motiven kaufen?</summary>
			<p>
				<strong>Ja.</strong> In unserem Shop bei Spreadshirt gibt es T-Shirts, Hoodies, Mützen, Taschen, Tassen, Trinkflaschen, Sticker, Magnete, Poster und
				mehr mit unseren Motiven; die Kleidung ist fast ganz von Stanley/Stella, aus Bio-Baumwolle oder recyceltem Material. Bei jedem Motiv weiter unten führt „Motiv im Non-Profit-Shop ansehen“ direkt zu den passenden
				Produkten.
			</p>
			<p>
				Spreadshirt aus Leipzig druckt erst, wenn du bestellst, verschickt und rechnet ab und ist dein
				Vertragspartner. Passt etwas nicht, kannst du es innerhalb von 30 Tagen zurückschicken oder umtauschen. Bei
				Fragen zu Bestellung oder Lieferung hilft dir der Kundenservice von Spreadshirt.
				<a href="/haeufige-fragen/#umwelt">Wie umweltfreundlich sind die Produkte?</a>
			</p>
			<p>
				<strong>Wir verdienen daran nichts.</strong> Unser Shop ist als Non-Profit-Shop eingerichtet: Du zahlst nur
				den Preis von Spreadshirt, ohne Aufschlag für uns.
			</p>
			<p>
				Unabhängig davon kannst du alle Motive jederzeit <a href="#herunterladen">kostenlos herunterladen</a> und
				selbst drucken oder drucken lassen.
			</p>
			<p>
				<a class="knopf-schwarz" href={shopStart} target="_blank" rel="noopener" data-umami-event="shop-oeffnen" data-umami-event-motiv="frage">Zum Shop</a>
			</p>
		</details>
	</div>

	<ul class="motive">
		{motive.map((motiv) => (
			<li id={motiv.anker}>
				{/* mehrere Fassungen: Knöpfe wechseln zwischen ihnen; ohne JavaScript stehen alle untereinander */}
				{motiv.fassungen.map((f, i) => (
					<div class="fassung" data-fassung={i}>
						<a
							class="gross-link"
							href={gross.get(`${motiv.anker}${f.endung}`)}
							data-titel={`${motiv.bald ? '' : `Motiv ${motiv.nr}: `}${motiv.name}${motiv.fassungen.length > 1 && f.name ? ` – ${f.name}` : ''}`}
							data-shop={!motiv.bald && shopAktiv ? (f.shop ?? motiv.shop) : undefined}
							data-nr={motiv.nr}
							data-stoff={(f.stoff ?? stoff[f.endung] ?? einzelStoff(motiv)) ? karo((f.stoff ?? stoff[f.endung] ?? einzelStoff(motiv))!) : grundStoff}
						>
							<Image
								src={f.bild!}
								alt={motiv.alt}
								width={240}
								widths={[240, 480]}
								sizes="200px"
								class="auf-farbe"
								style={(f.stoff ?? stoff[f.endung] ?? einzelStoff(motiv)) ? `background: ${karo((f.stoff ?? stoff[f.endung] ?? einzelStoff(motiv))!)}` : undefined}
							/>
							<span class="lupe" aria-hidden="true">⤢</span>
						</a>
						<div>
							<h2>
								{!motiv.bald && <>Motiv {motiv.nr}: </>}{motiv.name}
								{zeigeInfo(motiv) && <button type="button" class="info-knopf" aria-expanded="false" aria-label="Über dieses Motiv" title="Über dieses Motiv" hidden>i</button>}
								{kommentareAktiv && !motiv.bald && (
									<button
										type="button"
										class="kommentar-knopf"
										aria-expanded="false"
										aria-controls={`${motiv.anker}-kommentare`}
										aria-label={kommentareVon(motiv).length ? `${kommentareVon(motiv).length} ${kommentareVon(motiv).length === 1 ? 'Kommentar' : 'Kommentare'} von Verbündeten` : 'Kommentar schreiben'}
										title={kommentareVon(motiv).length ? 'Kommentare von Verbündeten' : 'Kommentar schreiben'}
										data-motiv={motiv.nr}
										hidden
									>
										{kommentareVon(motiv).length > 0 && <span class="anzahl">{kommentareVon(motiv).length}</span>}
										<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5c4.7 0 8.5 3.1 8.5 7S16.7 17.5 12 17.5c-1 0-2-.1-2.9-.4L4.5 20l1.4-4C4.4 14.7 3.5 12.7 3.5 10.5c0-3.9 3.8-7 8.5-7z" />{kommentareVon(motiv).length > 0 && <g class="punkte"><circle cx="8.3" cy="10.5" r="1.25" /><circle cx="12" cy="10.5" r="1.25" /><circle cx="15.7" cy="10.5" r="1.25" /></g>}</svg>
									</button>
								)}
							</h2>
							{zeigeInfo(motiv) && (
								<div class="info-text">
									{gestalterVon((motiv as { gestalter?: string }).gestalter) && (
										<p>
											<strong>Idee und Gestaltung:</strong>{' '}
											<a href={`/gestalter/${(motiv as { gestalter?: string }).gestalter}/`}>{gestalterVon((motiv as { gestalter?: string }).gestalter)!.name}</a>.
											{' '}{(motiv as { entstehung?: string }).entstehung}
										</p>
									)}
								</div>
							)}
							{motiv.fassungen.length > 1 && (
								<div class="fassung-knoepfe" role="group" aria-label="Fassung wählen" hidden>
									{motiv.fassungen.map((g, k) => (
										<button type="button" data-zu={k} aria-pressed={k === i ? 'true' : 'false'}>{g.name}</button>
									))}
								</div>
							)}
							{f.text && <p class="fassung-text">{f.name && <strong class="ohne-js">{f.name}: </strong>}{f.text}</p>}
							{motiv.bald ? (
								(motiv as { hinweis?: string }).hinweis ? (
									<p class="bald">{(motiv as { hinweis?: string }).hinweis}</p>
								) : (
								<p class="bald">
									<span class="bald-marke">Kommt bald</span>
									Wir bereiten das Motiv für den Druck vor. Bald kannst du es hier herunterladen und im Shop bestellen.
								</p>
								)
							) : (
							<ul class="links">
								<li>
									<a href={f.bild!.src} download={`d-wie-demokratie-motiv-${motiv.nr}${f.endung}.png`} data-umami-event="download-png" data-umami-event-motiv={`${motiv.nr}${f.endung}`}>
										PNG{f.name ? ` ${f.name.replace(/^Für /, 'für ')}` : ' herunterladen'}
										<span class="download-pfeil" aria-hidden="true">↓</span>
									</a>
								</li>
								{pdfLink(motiv.nr, f.endung) && (
									<li>
										<a href={pdfLink(motiv.nr, f.endung)} download data-umami-event="download-pdf" data-umami-event-motiv={`${motiv.nr}${f.endung}`}>
											PDF{f.name ? ` ${f.name.replace(/^Für /, 'für ')}` : ' für Druckereien'}
											<span class="download-pfeil" aria-hidden="true">↓</span>
										</a>
									</li>
								)}
							</ul>
							)}
						</div>
						{/* Shop-Knopf über die ganze Breite der Karte */}
						{!motiv.bald && (f.shop ?? motiv.shop) && (
							shopAktiv ? (
								<a class="shop-knopf" href={f.shop ?? motiv.shop} target="_blank" rel="noopener" data-umami-event="shop-oeffnen" data-umami-event-motiv={motiv.nr}>
									Motiv im Non-Profit-Shop ansehen
								</a>
							) : (
								<span class="shop-knopf aus">Motiv im Non-Profit-Shop ansehen</span>
							)
						)}
					</div>
				))}
				{/* Kommentare von Verbündeten: einmal je Motiv, unter allen Fassungen; nur mit JavaScript (Formular) */}
				{kommentareAktiv && !motiv.bald && (
					<section class="kommentare" id={`${motiv.anker}-kommentare`} aria-label={`Kommentare zu Motiv ${motiv.nr}`} hidden>
						{kommentareVon(motiv).length > 0 && (
							<ul class="kommentar-liste">
								{/* Jeder Kommentar hat eine eigene Adresse /motive/#motiv-<nr>-kommentar-<n> (n = Reihenfolge in
								    `kommentare`, daher neue Kommentare immer HINTEN anhängen, sonst zeigen alte Links falsch) */}
								{kommentareVon(motiv).map((k, i) => (
									<li id={`${motiv.anker}-kommentar-${i + 1}`}>
										{/* 🔗 rechtsbündig am Ende der letzten Zeile: kopiert den Link (Handy: Teilen-Menü);
										    am Computer zeigt es beim Darüberfahren „Link zu diesem Kommentar kopieren“ */}
										<blockquote>
											„{k.text}“<button
												type="button"
												class="kommentar-link"
												data-motiv={`${motiv.nr} – ${motiv.name}`}
												aria-label="Link zu diesem Kommentar kopieren"
												hidden
											><span class="kopiert" role="status"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4l-1.1 1.1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.1-1.1" /></svg></button>
										</blockquote>
										<p class="wer">
											<a href="/verbuendete/">{k.name}</a>{k.zusatz && <>, {k.zusatz}</>}
											{k.beispiel && <span class="entwurf">Beispiel, nur lokal</span>}
										</p>
									</li>
								))}
							</ul>
						)}
						<div class="kommentar-schreiben">
							<p class="kommentar-hinweis">
								<strong>Verbündete können kommentieren.</strong>
								<a href="/verbuendete/#eintragen">Verbünden</a>.
							</p>
							<form class="kommentar-formular" data-motiv={`${motiv.nr} – ${motiv.name}`} data-ziel={kommentarUrl} novalidate>
								<label>
									Mein Kommentar
									<textarea name="kommentar" rows="3" maxlength="500" required></textarea>
								</label>
								<label>
									Meine E-Mail-Adresse, mit der ich mich verbündet habe
									<input type="email" name="email" autocomplete="email" required />
								</label>
								{/* Falle für Spam-Programme, für Menschen unsichtbar */}
								<label class="falle" aria-hidden="true">
									Website <input type="text" name="webseite2" tabindex="-1" autocomplete="off" />
								</label>
								<label class="haken">
									<input type="checkbox" name="einwilligung" required />
									<span>Mein Kommentar darf mit meinem Namen und meiner Tätigkeit bei diesem Motiv erscheinen. Mehr in der <a href="/datenschutz/#kommentare">Datenschutzerklärung</a>.</span>
								</label>
								<p class="fehler" role="alert" hidden></p>
								<button type="submit" class="kommentar-absenden">Kommentar senden</button>
							</form>
							<p class="kommentar-danke" role="status" hidden>
								<strong>Danke!</strong> Wir melden uns per E-Mail.
							</p>
						</div>
					</section>
				)}
			</li>
		))}
	</ul>

	<dialog class="gross-ansicht" aria-label="Motiv in groß">
		<button type="button" class="schliessen" aria-label="Schließen">×</button>
		<img alt="" />
		<div class="gross-leiste">
			<button type="button" class="pfeil zurueck" aria-label="Vorheriges Motiv">‹</button>
			<!-- Titel und darunter der Shop-Knopf (Ziel setzt das Skript je Motiv; ohne Shop verborgen) -->
			<div class="gross-mitte">
				<p class="gross-titel"></p>
				<a class="shop-knopf gross-shop" target="_blank" rel="noopener" data-umami-event="shop-oeffnen" hidden>Motiv im Non-Profit-Shop ansehen</a>
			</div>
			<button type="button" class="pfeil weiter" aria-label="Nächstes Motiv">›</button>
		</div>
	</dialog>

	<p class="mehr-motive">
		Weitere Motive kommen bald. <a href="#neuigkeiten">Wir informieren dich gerne.</a>
		{einreichenAktiv && <>Oder gestalte selbst eins: <a href="/motiv-einreichen/">Motiv einreichen</a>. <span class="entwurf">nur lokal</span></>}
	</p>
</Layout>

<script>
	// Links wie /motive/#herunterladen oder /motive/#shop klappen die passende Frage gleich auf.
	function aufklappen() {
		const ziel = location.hash && document.querySelector(location.hash);
		if (ziel instanceof HTMLDetailsElement) ziel.open = true;
	}
	addEventListener('hashchange', aufklappen);
	aufklappen();

	// „Werten und Zielen“ in der Frage zum Beisteuern: klappt auf wie auf /verbuendete/
	{
		const knopf = document.querySelector<HTMLButtonElement>('.aufklappen');
		const bereich = document.getElementById('werte-ziele');
		const innen = bereich?.firstElementChild as HTMLElement | null;
		if (knopf && bereich && innen) {
			knopf.hidden = false;
			document.querySelector('.aufklappen-text')?.remove();
			bereich.classList.add('zu');
			innen.setAttribute('hidden', 'until-found');
			const oeffnen = () => {
				knopf.setAttribute('aria-expanded', 'true');
				innen.hidden = false;
				bereich.offsetHeight;
				bereich.classList.remove('zu');
			};
			knopf.addEventListener('click', () => {
				if (knopf.getAttribute('aria-expanded') === 'true') {
					knopf.setAttribute('aria-expanded', 'false');
					bereich.classList.add('zu');
					setTimeout(() => {
						if (bereich.classList.contains('zu')) innen.setAttribute('hidden', 'until-found');
					}, 300);
				} else oeffnen();
			});
			innen.addEventListener('beforematch', oeffnen);
		}
	}

	// „Über dieses Motiv“: kleines i am Titel klappt den Text auf und zu (ohne JavaScript steht er immer da)
	for (const knopf of document.querySelectorAll<HTMLButtonElement>('.info-knopf')) {
		const text = knopf.closest('.fassung')?.querySelector<HTMLElement>('.info-text');
		if (!text) continue;
		knopf.hidden = false;
		text.hidden = true;
		knopf.addEventListener('click', () => {
			const auf = knopf.getAttribute('aria-expanded') !== 'true';
			knopf.setAttribute('aria-expanded', String(auf));
			text.hidden = !auf;
		});
	}

	// Kommentare: 💬 am Titel klappt den Bereich unter dem Motiv auf (alle Fassungen teilen ihn)
	for (const knopf of document.querySelectorAll<HTMLButtonElement>('.kommentar-knopf')) {
		const bereich = document.getElementById(knopf.getAttribute('aria-controls')!);
		if (!bereich) continue;
		knopf.hidden = false;
		knopf.addEventListener('click', () => {
			const auf = bereich.hidden;
			bereich.hidden = !auf;
			knopf.closest('li')?.querySelectorAll('.kommentar-knopf').forEach((k) => k.setAttribute('aria-expanded', String(auf)));
			if (auf) {
				window.umami?.track('kommentare-aufklappen', { motiv: knopf.dataset.motiv });
				bereich.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
			}
		});
	}

	// Link zu einem Kommentar (/motive/#motiv-5-kommentar-1): Bereich aufklappen, hinscrollen, kurz hervorheben
	function zumKommentar() {
		if (!/^#[\w-]+-kommentar-\d+$/.test(location.hash)) return;
		const kommentar = document.getElementById(location.hash.slice(1));
		const bereich = kommentar?.closest<HTMLElement>('.kommentare');
		if (!kommentar || !bereich) return;
		bereich.hidden = false;
		document.querySelectorAll(`.kommentar-knopf[aria-controls="${bereich.id}"]`).forEach((k) => k.setAttribute('aria-expanded', 'true'));
		kommentar.scrollIntoView({ block: 'start' });
		kommentar.classList.remove('hervor');
		kommentar.offsetHeight;
		kommentar.classList.add('hervor');
	}
	addEventListener('hashchange', zumKommentar);
	zumKommentar();

	// 🔗 am Kommentar: auf dem Handy Teilen-Menü, sonst Link in die Zwischenablage und kurz „Link kopiert“
	for (const knopf of document.querySelectorAll<HTMLButtonElement>('.kommentar-link')) {
		knopf.hidden = false;
		const meldung = knopf.querySelector<HTMLElement>('.kopiert')!;
		knopf.addEventListener('click', async () => {
			const url = `${location.origin}${location.pathname}#${knopf.closest('li')!.id}`;
			window.umami?.track('kommentar-link', { motiv: knopf.dataset.motiv });
			if (navigator.share && matchMedia('(pointer: coarse)').matches) {
				try {
					await navigator.share({ title: 'Kommentar auf D wie Demokratie', url });
				} catch {
					// abgebrochen – nichts zu tun
				}
				return;
			}
			try {
				await navigator.clipboard.writeText(url);
				meldung.textContent = 'Link kopiert';
				setTimeout(() => (meldung.textContent = ''), 2500);
			} catch {
				prompt('Link zu diesem Kommentar:', url);
			}
		});
	}

	// Kommentar senden: an das Intranet; was angezeigt wird, ist immer dasselbe, damit niemand herausfinden kann,
	// welche Adresse zu einem Verbündeten gehört (Klaus prüft und antwortet per E-Mail)
	const geladen = Date.now();
	for (const formular of document.querySelectorAll<HTMLFormElement>('.kommentar-formular')) {
		const fehler = formular.querySelector<HTMLElement>('.fehler')!;
		const knopf = formular.querySelector<HTMLButtonElement>('.kommentar-absenden')!;
		const fertig = () => {
			formular.hidden = true;
			formular.closest('.kommentar-schreiben')?.querySelector<HTMLElement>('.kommentar-hinweis')?.setAttribute('hidden', '');
			formular.closest('.kommentar-schreiben')!.querySelector<HTMLElement>('.kommentar-danke')!.hidden = false;
		};
		formular.addEventListener('submit', async (e) => {
			e.preventDefault();
			fehler.hidden = true;
			if (!formular.checkValidity()) {
				formular.reportValidity();
				return;
			}
			const d = new FormData(formular);
			const wert = (n: string) => String(d.get(n) ?? '').trim();
			// Spam-Programme füllen die Falle aus oder schicken in Sekunden ab: so tun, als hätte es geklappt
			if (wert('webseite2') || Date.now() - geladen < 4000) {
				fertig();
				return;
			}
			knopf.disabled = true;
			knopf.textContent = 'Wird gesendet …';
			try {
				if (!formular.dataset.ziel) throw new Error('kein Ziel');
				const antwort = await fetch(formular.dataset.ziel, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ cArt: 'Kommentar', emailAddress: wert('email'), cMotiv: formular.dataset.motiv, cKommentar: wert('kommentar') }),
				});
				if (!antwort.ok) throw new Error(String(antwort.status));
				window.umami?.track('kommentar-senden', { motiv: formular.dataset.motiv });
				fertig();
			} catch {
				fehler.textContent = 'Das hat leider nicht geklappt. Bitte versuch es später noch einmal oder schreib uns an info@d-wie-demokratie.de.';
				fehler.hidden = false;
			} finally {
				knopf.disabled = false;
				knopf.textContent = 'Kommentar senden';
			}
		});
	}

	// Fassungen eines Motivs: nur die gewählte zeigen; die Knöpfe gibt es in jeder Fassung, damit sie neben dem Bild stehen
	for (const motiv of document.querySelectorAll<HTMLElement>('.motive > li')) {
		const fassungen = [...motiv.querySelectorAll<HTMLElement>('.fassung')];
		if (fassungen.length < 2) continue;
		const zeigen = (nr: number) => fassungen.forEach((f, i) => (f.hidden = i !== nr));
		motiv.querySelectorAll<HTMLElement>('.fassung-knoepfe').forEach((k) => (k.hidden = false));
		motiv.querySelectorAll<HTMLElement>('.ohne-js').forEach((e) => e.remove());
		motiv.addEventListener('click', (e) => {
			const knopf = (e.target as Element).closest<HTMLButtonElement>('button[data-zu]');
			if (!knopf) return;
			const nr = Number(knopf.dataset.zu);
			zeigen(nr);
			// Fokus auf denselben Knopf in der nun sichtbaren Fassung, damit Tastaturbedienung nicht verloren geht
			fassungen[nr].querySelector<HTMLButtonElement>(`button[data-zu="${nr}"]`)?.focus();
		});
		zeigen(0);
	}

	// Großansicht: Klick aufs Motiv öffnet das Fenster; Pfeile, Pfeiltasten oder Wischen blättern durch alle Motive
	// und Fassungen; jeder andere Klick darin, × oder Esc schließt es wieder
	const fenster = document.querySelector<HTMLDialogElement>('.gross-ansicht');
	if (fenster?.showModal) {
		const bild = fenster.querySelector('img')!;
		const titel = fenster.querySelector('.gross-titel')!;
		const shop = fenster.querySelector<HTMLAnchorElement>('.gross-shop')!;
		// alle Fassungen der Reihe nach, jede wie ein eigenes Motiv (Motiv 1 mit allen Fassungen, dann Motiv 2 …)
		const alle = [...document.querySelectorAll<HTMLAnchorElement>('.gross-link')];
		let nr = 0;
		const zeigen = (link: HTMLAnchorElement) => {
			bild.src = link.href;
			bild.alt = link.querySelector('img')?.alt ?? '';
			bild.style.background = link.dataset.stoff || '#fff';
			titel.textContent = link.dataset.titel ?? '';
			shop.hidden = !link.dataset.shop;
			if (link.dataset.shop) {
				shop.href = link.dataset.shop;
				shop.dataset.umamiEventMotiv = link.dataset.nr ?? '';
			}
		};
		const blaettern = (schritt: number) => {
			nr = (nr + schritt + alle.length) % alle.length;
			zeigen(alle[nr]);
		};
		for (const link of document.querySelectorAll<HTMLAnchorElement>('.gross-link')) {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				nr = alle.indexOf(link);
				zeigen(link);
				fenster.showModal();
			});
		}
		fenster.addEventListener('click', (e) => {
			const pfeil = (e.target as Element).closest<HTMLElement>('.pfeil');
			if (pfeil) blaettern(pfeil.classList.contains('weiter') ? 1 : -1);
			else fenster.close();
		});
		fenster.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') blaettern(1);
			if (e.key === 'ArrowLeft') blaettern(-1);
		});
		// Wischen auf dem Handy: nach links = nächstes, nach rechts = vorheriges Motiv
		let startX = 0;
		fenster.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
		fenster.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - startX;
			if (Math.abs(dx) > 50) blaettern(dx < 0 ? 1 : -1);
		});
		// Beim Schließen dorthin, wo man in der Großansicht zuletzt war: Motiv in die Mitte holen und dessen Fassung zeigen
		fenster.addEventListener('close', () => {
			bild.removeAttribute('src');
			const link = alle[nr];
			const fassung = link.closest<HTMLElement>('.fassung');
			if (fassung?.hidden) {
				const k = fassung.dataset.fassung;
				link.closest('li')?.querySelector<HTMLButtonElement>(`.fassung:not([hidden]) button[data-zu="${k}"]`)?.click();
			}
			link.focus({ preventScroll: true });
			link.closest('li')?.scrollIntoView({ block: 'center' });
		});
	}
</script>

