---
import Layout from '../layouts/Layout.astro';

// Offene Stellen. Neue Ausschreibung = neuer Eintrag, erledigte Stelle = Eintrag löschen.
// Ist die Liste leer, zeigt die Seite automatisch den Hinweis „Gerade ist keine Stelle ausgeschrieben“.
// „id“ ist die Sprungmarke zum Teilen einer einzelnen Stelle: d-wie-demokratie.de/mitmachen/#<id>
// „kurz“ erscheint in der Übersicht oben auf der Seite.
// „interesse“ darf einen Link enthalten (HTML).
// „aufgaben“ ist in Gruppen eingeteilt; „rolle“ ist nur nötig, wenn eine Stelle mehrere Rollen hat. Ohne „aufgaben“ entfällt der Abschnitt.
type Stelle = {
	id: string;
	titel: string;
	kurz: string;
	eckdaten: string[];
	einleitung: string[];
	aufgaben?: { rolle?: string; punkte: string[] }[];
	wichtig: string[];
	bieten: string[];
	interesse?: string;
	betreff: string;
};

const stellen: Stelle[] = [
	{
		id: 'design',
		titel: 'Wir suchen kreative Köpfe, die Spaß daran haben, neue Motive zu entwerfen!',
		kurz: 'kreative Köpfe, die Spaß daran haben, neue Motive zu entwerfen',
		eckdaten: ['Ehrenamtlich', 'Bundesweit', 'Ortsunabhängig'],
		einleitung: [
			'd-wie-demokratie.de ist eine junge, unabhängige Initiative. Wir möchten möglichst viele Menschen ermutigen, sich sichtbar zu unserer Demokratie und ihren Werten zu bekennen.',
			'Jeden Tag ein neues Motiv für unsere Demokratie: Dafür suchen wir Menschen, die mit Ideen, Witz und Gespür für Gestaltung Motive in Schwarz-Rot-Gold entwerfen.',
		],
		wichtig: [
			'Du gestaltest gern, ob mit Grafikprogramm, Tablet oder auf Papier, und stehst aus Überzeugung hinter unserer freiheitlichen Demokratie. Ausbildung oder Berufserfahrung im Design sind keine Voraussetzung.',
		],
		bieten: [
			'Deine Motive auf Aufklebern, T-Shirts und Tassen in ganz Deutschland. Auf unserer Website nennen wir dich bei deinen Motiven und stellen dich auf einer eigenen Profilseite vor.',
			'Die Tätigkeit ist ehrenamtlich, zeitlich flexibel und vollständig ortsunabhängig.',
		],
		interesse: 'Gerne gleich mit einem ersten Entwurf. Bitte beachte dazu unsere <a href="#vorgaben">Vorgaben für Designs</a>.',
		betreff: 'Ehrenamt: Design',
	},
	{
		id: 'instagram',
		titel: 'Wir suchen ein Team für Instagram: Content Creator und Content Manager!',
		kurz: 'ein Team für Instagram: Content Creator und Content Manager',
		eckdaten: ['Ehrenamtlich', 'Bundesweit', 'Ortsunabhängig'],
		einleitung: [
			'd-wie-demokratie.de ist eine junge, unabhängige Initiative. Wir möchten möglichst viele Menschen ermutigen, sich sichtbar zu unserer Demokratie und ihren Werten zu bekennen.',
			'Auf Instagram sind wir noch gar nicht vertreten. Dort wollen wir jeden Tag ein neues Design vorstellen, das wir selbst entworfen haben oder das uns jemand geschickt hat. Dafür suchen wir ein Team, das unseren Auftritt von Grund auf aufbaut und mit Leben füllt.',
		],
		aufgaben: [
			{
				rolle: 'Als Content Creator',
				punkte: [
					'Beiträge, Stories und Reels rund um unsere Designs gestalten',
					'Eigene Designs entwerfen',
					'Zum Mitmachen und zum Einschicken eigener Designs einladen',
				],
			},
			{
				rolle: 'Als Content Manager',
				punkte: [
					'Unseren Instagram-Auftritt von Anfang an aufbauen',
					'Eingeschickte Designs sichten und mit uns auswählen',
					'Den Redaktionsplan führen, damit jeden Tag ein Beitrag erscheint',
					'Mit Followern, Gestaltern und anderen demokratischen Initiativen in Kontakt treten',
				],
			},
		],
		wichtig: [
			'Du kennst dich mit Instagram aus, hast ein Gespür für Bilder und Sprache und stehst aus Überzeugung hinter unserer freiheitlichen Demokratie.',
			'Erfahrung mit Social Media, Fotografie, Video oder Grafik wäre hilfreich, ist aber keine Voraussetzung.',
			'Du kannst eine Rolle übernehmen oder beide, ganz wie es zu dir passt.',
		],
		bieten: [
			'Die seltene Chance, einen Social-Media-Auftritt ganz neu aufzubauen und ihm deine eigene Handschrift zu geben.',
			'Die Tätigkeit ist ehrenamtlich, zeitlich flexibel und vollständig ortsunabhängig. Die täglichen Beiträge teilen wir im Team auf, du bestimmst selbst, wie viel Zeit du einbringst.',
		],
		interesse: 'Schreib uns, welche Rolle dich reizt.',
		betreff: 'Ehrenamt: Instagram',
	},
];

const mailto = (betreff: string) => `mailto:info@d-wie-demokratie.de?subject=${encodeURIComponent(betreff)}`;
---

<Layout
	title="Mitmachen – D wie Demokratie"
	description="Ehrenamtlich bei d-wie-demokratie.de mitmachen: offene Aufgaben, zeitlich flexibel und ortsunabhängig."
>
	<h1>Wir suchen Mitmacher</h1>

	<p class="lead">
		Alle Aufgaben sind ehrenamtlich, zeitlich flexibel und ortsunabhängig.
	</p>

	{stellen.length > 0 && (
		<>
			<p class="uebersicht-titel">Im Moment suchen wir:</p>
			<ul class="uebersicht">
				{stellen.map((stelle) => <li><a href={`#${stelle.id}`}>{stelle.kurz}</a></li>)}
			</ul>
		</>
	)}

	{stellen.length === 0 && (
		<p>
			Gerade ist keine Stelle ausgeschrieben. Wenn du mitmachen möchtest, schreib uns trotzdem gerne an
			<a href={mailto('Ehrenamt')} data-umami-event="email-job" data-umami-event-stelle="initiativ">info@d-wie-demokratie.de</a>.
		</p>
	)}

	{stellen.map((stelle) => (
		<section class="stelle" id={stelle.id} aria-labelledby={`${stelle.id}-titel`}>
			<h2 id={`${stelle.id}-titel`}>{stelle.titel}</h2>
			<p class="eckdaten">{stelle.eckdaten.join(' · ')}</p>

			{stelle.einleitung.map((absatz) => <p>{absatz}</p>)}

			{stelle.aufgaben && <h3>Deine möglichen Aufgaben</h3>}
			{stelle.aufgaben?.map((gruppe) => (
				<>
					{gruppe.rolle && <h4>{gruppe.rolle}</h4>}
					<ul>
						{gruppe.punkte.map((punkt) => <li>{punkt}</li>)}
					</ul>
				</>
			))}

			<h3>Was uns wichtig ist</h3>
			{stelle.wichtig.map((absatz) => <p>{absatz}</p>)}

			<h3>Was wir bieten</h3>
			{stelle.bieten.map((absatz) => <p>{absatz}</p>)}

			<h3>Interesse?</h3>
			<p>
				Dann freuen wir uns über eine Nachricht an
				<a href={mailto(stelle.betreff)} data-umami-event="email-job" data-umami-event-stelle={stelle.id}>info@d-wie-demokratie.de</a>.
				{stelle.interesse && <Fragment set:html={stelle.interesse} />}
				Mehr über uns erfährst du unter <a href="/haeufige-fragen/">„Fragen“</a>.
			</p>
		</section>
	))}

	<!-- gilt für alle, die ein Motiv schicken, auch ohne Ausschreibung; verlinkt von „Unterstützen“ -->
	<section class="stelle" id="vorgaben" aria-labelledby="vorgaben-titel">
		<h2 id="vorgaben-titel">Vorgaben für Designs</h2>
		<p class="eckdaten">Für alle, die uns ein Motiv schicken, ob einmalig oder regelmäßig.</p>

		<h3>Das muss drin sein</h3>
		<ul>
			<li>
				<strong>Die Farben Schwarz-Rot-Gold</strong>, genau diese Werte:
				<span class="farbe"><span style="background: #000000"></span>Schwarz #000000</span>,
				<span class="farbe"><span style="background: #dd0000"></span>Rot #DD0000</span>,
				<span class="farbe"><span style="background: #ffce00"></span>Gold #FFCE00</span>
			</li>
			<li><strong>Der Schriftzug „d-wie-demokratie.de“ und/oder unser QR-Code</strong></li>
		</ul>

		<h3>Die Datei</h3>
		<ul>
			<li><strong>PNG mit transparentem Hintergrund</strong>, längste Seite <strong>mindestens 4000 Pixel</strong></li>
			<li><strong>Wenn möglich zusätzlich als Vektordatei</strong> (SVG, PDF oder AI). Daraus erstellen wir die Druckdatei für Druckereien.</li>
			<li><strong>Schriften:</strong> am besten Helvetica oder Arial wie in unserem Logo, oder Schriften, die frei verwendet werden dürfen, etwa von Google Fonts</li>
		</ul>

		<h3>Damit es gut druckt</h3>
		<ul>
			<li>Das Motiv muss auch klein noch erkennbar sein, etwa als Aufkleber in 10 cm Breite. Also keine haarfeinen Linien und keine winzige Schrift.</li>
			<li>Möglichst wenige Farben, keine Farbverläufe, keine Fotos</li>
		</ul>

		<h3>Was nicht ins Motiv gehört</h3>
		<ul>
			<li>dein Name, deine Signatur, dein Logo oder deine Webadresse. Dich nennen wir auf unserer Website bei deinen Motiven.</li>
			<li>Parteilogos und Parteiwerbung, Herabsetzung von Menschen oder Gruppen, Hass in jeder Form</li>
			<li>fremde Figuren, Marken oder Bilder, an denen du keine Rechte hast</li>
		</ul>

		<h3>Deine Rechte und unsere</h3>
		<p>
			Mit dem Einschicken versicherst du, dass du das Motiv selbst gestaltet hast. Du erlaubst uns, es kostenlos zu
			veröffentlichen, zum Herunterladen anzubieten und in unserem Shop ohne Gewinn verkaufen zu lassen.
		</p>
		<p>
			Auf unserer Website nennen wir dich bei deinen Motiven und stellen dich auf einer eigenen Profilseite vor, mit allen
			deinen Motiven und auf Wunsch mit Foto, ein paar Sätzen über dich und einem Link zu deiner Website oder deinem
			Profil. Schick uns dafür einfach, was dort stehen soll. Wenn du nicht genannt werden möchtest, sag uns Bescheid.
		</p>
		<p>Ob und wann wir ein Motiv veröffentlichen, entscheiden wir.</p>

		<h3>So schickst du dein Motiv</h3>
		<p>
			Per E-Mail an
			<a href={mailto('Design-Einreichung')} data-umami-event="email-design">info@d-wie-demokratie.de</a>,
			Betreff „Design-Einreichung“. Schreib uns dazu, unter welchem Namen wir dich nennen sollen und was auf deiner
			Profilseite stehen darf. Große Dateien schickst du am besten als Link, etwa über WeTransfer.
		</p>
	</section>
</Layout>

<style>
	h1 {
		font-size: clamp(1.85rem, 7.5vw, 2.75rem);
	}

	.lead {
		font-size: 1.3rem;
	}

	/* jede Stelle als Kasten mit Schwarz-Rot-Gold links, wie der Kasten „Bitte weitersagen“ unten auf jeder Seite */
	.stelle {
		margin-top: 2.5em;
		padding: 0.2em 1.5em 0.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	/* auf dem Handy weniger Innenabstand, damit der Text nicht zu schmal wird */
	@media (max-width: 480px) {
		.stelle {
			padding-right: 1em;
			padding-left: calc(1em + 12px);
		}
	}

	h2 {
		font-size: 1.4rem;
	}

	.eckdaten {
		margin-top: -0.4em;
		color: var(--grau);
		font-weight: bold;
	}

	h3 {
		margin: 1.6em 0 0.4em;
		font-size: 1.1rem;
	}

	/* Farbfelder in den Vorgaben für Designs */
	.farbe {
		white-space: nowrap;
	}

	.farbe > span {
		display: inline-block;
		width: 0.9em;
		height: 0.9em;
		margin-right: 0.3em;
		border: 1px solid #c4c4c4;
		vertical-align: -0.1em;
	}

	h3 + p,
	h3 + ul,
	h4 + ul {
		margin-top: 0;
	}

	/* Rollen innerhalb einer Stelle, z. B. „Als Content Creator“ */
	h4 {
		margin: 0.8em 0 0.2em;
		font-size: 1rem;
	}

	h3 + h4 {
		margin-top: 0;
	}

	/* Übersicht oben, direkt unter „Im Moment suchen wir:“ */
	.uebersicht-titel {
		margin-bottom: 0;
		font-weight: bold;
	}

	.uebersicht {
		margin-top: 0.3em;
	}

	.uebersicht li + li {
		margin-top: 0.3em;
	}
</style>
