---
import Layout from '../layouts/Layout.astro';

// Offene Stellen. Neue Ausschreibung = neuer Eintrag, erledigte Stelle = Eintrag löschen.
// Ist die Liste leer, zeigt die Seite automatisch den Hinweis „Gerade ist keine Stelle ausgeschrieben“.
// „id“ ist die Sprungmarke zum Teilen einer einzelnen Stelle: d-wie-demokratie.de/mitmachen/#<id>
// „kurz“ erscheint in der Übersicht oben auf der Seite.
// „interesse“ darf einen Link enthalten (HTML).
// „aufgaben“ ist in Gruppen eingeteilt; „rolle“ ist nur nötig, wenn eine Stelle mehrere Rollen hat. Ohne „aufgaben“ entfällt der Abschnitt.
type Stelle = {
	id: string;
	titel: string;
	kurz: string;
	eckdaten: string[];
	einleitung: string[];
	aufgaben?: { rolle?: string; punkte: string[] }[];
	wichtig: string[];
	bieten: string[];
	interesse?: string;
	betreff: string;
};

const stellen: Stelle[] = [
	{
		id: 'design',
		titel: 'Wir suchen kreative Köpfe, die Spaß daran haben, neue Motive zu entwerfen!',
		kurz: 'kreative Köpfe, die Spaß daran haben, neue Motive zu entwerfen',
		eckdaten: ['Ehrenamtlich', 'Zeitlich flexibel', 'Ortsunabhängig'],
		einleitung: [
			'd-wie-demokratie.de ist eine junge, unabhängige Initiative. Wir möchten möglichst viele Menschen ermutigen, sich sichtbar zu unserer Demokratie und ihren Werten zu bekennen.',
			'Regelmäßig neue Motive für unsere Demokratie: Dafür suchen wir Menschen, die mit Ideen, Witz und Gespür für Gestaltung Motive in Schwarz-Rot-Gold entwerfen.',
		],
		wichtig: [
			'Du gestaltest gern und stehst aus Überzeugung hinter unserer freiheitlichen Demokratie. Ausbildung oder Berufserfahrung im Design sind keine Voraussetzung.',
		],
		bieten: [
			'Deine Motive auf Aufklebern, T-Shirts und Tassen in ganz Deutschland. Auf unserer Website nennen wir dich bei deinen Motiven und stellen dich auf einer eigenen Profilseite vor.',
			'Die Tätigkeit ist ehrenamtlich, zeitlich flexibel und vollständig ortsunabhängig.',
		],
		interesse: 'Gerne gleich mit einem ersten Entwurf. Bitte beachte dazu unsere <a href="/motiv-einreichen/#vorgaben">Vorgaben für Designs</a>.',
		betreff: 'Ehrenamt: Design',
	},
	{
		id: 'instagram',
		titel: 'Wir suchen ein Social-Media-Team für Instagram, TikTok und YouTube!',
		kurz: 'ein Social-Media-Team für Instagram, TikTok und YouTube',
		eckdaten: ['Content Creator und Social-Media-Manager', 'Ehrenamtlich', 'Zeitlich flexibel', 'Ortsunabhängig'],
		einleitung: [
			'd-wie-demokratie.de ist eine junge, unabhängige Initiative. Wir möchten möglichst viele Menschen ermutigen, sich sichtbar zu unserer Demokratie und ihren Werten zu bekennen.',
			'Auf Instagram, TikTok und YouTube sind wir noch gar nicht vertreten. Das wollen wir ändern! Mit kreativen Ideen, witzigen Motiven und kurzen Videos möchten wir besonders auch junge Menschen erreichen und zum Mitmachen begeistern.',
			'Dafür suchen wir ein Team, das unseren Social-Media-Auftritt von Grund auf aufbaut und mit Leben füllt.',
		],
		aufgaben: [
			{
				rolle: 'Als Content Creator',
				punkte: [
					'Kreative Beiträge, Stories, Reels und Shorts gestalten',
					'Unsere Motive in originellen Kurzvideos präsentieren',
					'Eigene Ideen und Designs entwickeln',
					'Andere zum Mitmachen und zum Einschicken eigener Designs motivieren',
				],
			},
			{
				rolle: 'Als Social-Media-Manager',
				punkte: [
					'Unsere Auftritte auf Instagram, TikTok und YouTube aufbauen und betreuen',
					'Eingeschickte Designs sichten und gemeinsam mit uns auswählen',
					'Die Veröffentlichungen planen und koordinieren',
					'Mit Followern, kreativen Menschen und anderen demokratischen Initiativen in Kontakt treten',
				],
			},
		],
		wichtig: [
			'Du kennst dich mit mindestens einer der Plattformen aus, hast Spaß an kreativen Ideen und stehst aus Überzeugung hinter unserer freiheitlichen Demokratie.',
			'Eine Ausbildung oder Berufserfahrung im Social-Media-Bereich brauchst du nicht. Begeisterung, Eigeninitiative und ein Gespür dafür, was Menschen anspricht, sind uns wichtiger.',
		],
		bieten: [
			'Die seltene Chance, einen Social-Media-Auftritt ganz neu aufzubauen, eigene Ideen zu verwirklichen und gemeinsam mit anderen etwas für unsere Demokratie zu bewegen.',
			'Die Tätigkeit ist ehrenamtlich, zeitlich flexibel und vollständig ortsunabhängig. Du musst nicht alle drei Plattformen beherrschen. Wir teilen die Aufgaben im Team auf, und du bestimmst selbst, wie viel Zeit du einbringst.',
		],
		interesse: 'Schreib uns, welche Aufgaben und Plattformen dich besonders interessieren.',
		betreff: 'Ehrenamt: Social Media',
	},
	{
		id: 'vertrieb',
		titel: 'Wir suchen ein Vertriebsgenie und Organisationstalent!',
		kurz: 'ein Vertriebsgenie und Organisationstalent',
		eckdaten: ['Ehrenamtlich', 'Zeitlich flexibel', 'Ortsunabhängig'],
		einleitung: [
			'd-wie-demokratie.de ist eine junge, unabhängige Initiative. Wir möchten möglichst viele Menschen ermutigen, sich sichtbar zu unserer Demokratie und ihren Werten zu bekennen.',
			'Dafür suchen wir jemanden, der hilft, die Initiative bekannt zu machen und weiterzuentwickeln.',
		],
		aufgaben: [
			{
				punkte: [
					'Unternehmen, Medien und Organisationen als Unterstützer gewinnen',
					'Neue Wege zur Verbreitung unserer Demokratie-Motive entwickeln',
					'Kontakte und Kooperationen aufbauen',
					'Die organisatorische Weiterentwicklung unserer Initiative mitgestalten',
					'Eigene Ideen einbringen und selbstständig umsetzen',
				],
			},
		],
		wichtig: [
			'Du kannst Menschen begeistern, denkst unternehmerisch, organisierst gerne und stehst aus Überzeugung hinter unserer freiheitlichen Demokratie.',
			'Berufserfahrung in Vertrieb, Marketing, Kommunikation oder Projektmanagement wäre hilfreich, ist aber keine Voraussetzung.',
		],
		bieten: [
			'Die Möglichkeit, eine Initiative von Anfang an mitzugestalten, eigene Ideen zu verwirklichen und gesellschaftlich etwas zu bewegen.',
			'Die Tätigkeit ist ehrenamtlich, zeitlich flexibel und vollständig ortsunabhängig.',
		],
		betreff: 'Ehrenamt: Vertrieb und Organisation',
	},
];

const mailto = (betreff: string) => `mailto:info@d-wie-demokratie.de?subject=${encodeURIComponent(betreff)}`;
---

<Layout
	title="Mitmachen – D wie Demokratie"
	description="Ehrenamtlich bei d-wie-demokratie.de mitmachen: offene Aufgaben, zeitlich flexibel und ortsunabhängig."
>
	<!-- die Vorgaben für Designs stehen jetzt auf einer eigenen Seite; alte Links dorthin weiterleiten -->
	<script is:inline>
		if (location.hash === '#vorgaben') location.replace('/motiv-einreichen/#vorgaben');
	</script>

	<h1>Wir suchen Mitmacher</h1>

	<p class="lead">
		Alle Aufgaben sind ehrenamtlich, zeitlich flexibel und ortsunabhängig.
	</p>

	{stellen.length > 0 && (
		<>
			<p class="uebersicht-titel">Im Moment suchen wir:</p>
			<ul class="uebersicht">
				{stellen.map((stelle) => <li><a href={`#${stelle.id}`}>{stelle.kurz}</a></li>)}
				<li>
					und dich, wenn du etwas ganz anderes kannst, das unsere Initiative voranbringt. Schreib uns einfach an
					<a href={mailto('Ehrenamt: Initiativ')} data-umami-event="email-job" data-umami-event-stelle="initiativ">info@d-wie-demokratie.de</a>
					und erzähl uns, was du gerne machen würdest.
				</li>
			</ul>
		</>
	)}

	{stellen.length === 0 && (
		<p>
			Gerade ist keine Stelle ausgeschrieben. Wenn du mitmachen möchtest, schreib uns trotzdem gerne an
			<a href={mailto('Ehrenamt')} data-umami-event="email-job" data-umami-event-stelle="initiativ">info@d-wie-demokratie.de</a>.
		</p>
	)}

	{stellen.map((stelle) => (
		<section class="stelle" id={stelle.id} aria-labelledby={`${stelle.id}-titel`}>
			<h2 id={`${stelle.id}-titel`}>{stelle.titel}</h2>
			<p class="eckdaten">{stelle.eckdaten.join(' · ')}</p>

			{stelle.einleitung.map((absatz) => <p>{absatz}</p>)}

			{stelle.aufgaben && <h3>Deine möglichen Aufgaben</h3>}
			{stelle.aufgaben?.map((gruppe) => (
				<>
					{gruppe.rolle && <h4>{gruppe.rolle}</h4>}
					<ul>
						{gruppe.punkte.map((punkt) => <li>{punkt}</li>)}
					</ul>
				</>
			))}

			<h3>Was uns wichtig ist</h3>
			{stelle.wichtig.map((absatz) => <p>{absatz}</p>)}

			<h3>Was wir bieten</h3>
			{stelle.bieten.map((absatz) => <p>{absatz}</p>)}
			<p>
				Unsere Zusammenarbeit organisieren wir über ein gemeinsames Intranet. Dort tauschen wir Ideen aus, stimmen uns
				ab und koordinieren unsere Aufgaben, egal wann und wo du Zeit hast.
			</p>

			<h3>Interesse?</h3>
			<p>
				Dann freuen wir uns über eine Nachricht an
				<a href={mailto(stelle.betreff)} data-umami-event="email-job" data-umami-event-stelle={stelle.id}>info@d-wie-demokratie.de</a>.
				{stelle.interesse && <Fragment set:html={stelle.interesse} />}
				Mehr über uns erfährst du unter <a href="/haeufige-fragen/">„Fragen“</a>.
			</p>
		</section>
	))}
</Layout>

<style>
	h1 {
		font-size: clamp(1.85rem, 7.5vw, 2.75rem);
	}

	.lead {
		font-size: 1.3rem;
	}

	/* jede Stelle als Kasten mit Schwarz-Rot-Gold links, wie der Kasten „Bitte weitersagen“ unten auf jeder Seite */
	.stelle {
		margin-top: 2.5em;
		padding: 0.2em 1.5em 0.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	/* auf dem Handy weniger Innenabstand, damit der Text nicht zu schmal wird */
	@media (max-width: 480px) {
		.stelle {
			padding-right: 1em;
			padding-left: calc(1em + 12px);
		}
	}

	h2 {
		font-size: 1.4rem;
	}

	.eckdaten {
		margin-top: -0.4em;
		color: var(--grau);
		font-weight: bold;
	}

	h3 {
		margin: 1.6em 0 0.4em;
		font-size: 1.1rem;
	}


	h3 + p,
	h3 + ul,
	h4 + ul {
		margin-top: 0;
	}

	/* Rollen innerhalb einer Stelle, z. B. „Als Content Creator“ */
	h4 {
		margin: 0.8em 0 0.2em;
		font-size: 1rem;
	}

	h3 + h4 {
		margin-top: 0;
	}

	/* Übersicht oben, direkt unter „Im Moment suchen wir:“ */
	.uebersicht-titel {
		margin-bottom: 0;
		font-weight: bold;
	}

	.uebersicht {
		margin-top: 0.3em;
	}

	.uebersicht li + li {
		margin-top: 0.3em;
	}
</style>
