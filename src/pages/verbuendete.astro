---
import { Image } from 'astro:assets';
import Werte from '../components/Werte.astro';
import Layout from '../layouts/Layout.astro';

type Verbuendeter = {
	name: string;
	art: 'mensch' | 'organisation' | 'firma';
	// bei Menschen z. B. Beruf, bei Organisationen und Firmen der Ort
	zusatz?: string;
	url?: string;
	// kurzer Satz des Verbündeten, warum er dabei ist (ohne Anführungszeichen eintragen)
	zitat?: string;
	// Logo von Organisationen und Firmen, Datei in src/assets/verbuendete/
	logo?: ImageMetadata;
};

// Neue Einträge erst nach Prüfung und schriftlicher Einwilligung aufnehmen
const verbuendete: Verbuendeter[] = [];

const gruppen = [
	{ art: 'mensch', titel: 'Menschen' },
	{ art: 'organisation', titel: 'Organisationen: Vereine, Schulen etc.' },
	{ art: 'firma', titel: 'Firmen' },
] as const;

const mailto = (betreff: string) => `mailto:info@d-wie-demokratie.de?subject=${encodeURIComponent(betreff)}`;
---

<Layout
	title="Verbündete – D wie Demokratie"
	description="Menschen, Organisationen und Firmen, die mit d-wie-demokratie.de Flagge zeigen für Demokratie und Grundgesetz. Verbünde dich mit uns."
>
	<h1>Wir sind Verbündete</h1>

	<p class="lead">
		Wir teilen
		<button type="button" class="aufklappen" aria-expanded="false" aria-controls="werte-ziele" hidden>Werte und Ziele</button><span class="aufklappen-text">Werte und Ziele</span>.
		Wir zeigen Flagge für unsere Demokratie.
	</p>

	<!-- ohne JavaScript gleich offen; …/verbuendete/#werte öffnet den Abschnitt -->
	<div class="werte-ziele" id="werte-ziele">
		<div class="werte-ziele-innen" id="werte">
			<p><strong>Unsere Werte</strong> sind die zentralen Werte unseres Grundgesetzes:</p>
			<Werte />
			<p><strong>Unsere Ziele:</strong></p>
			<ul class="ziele">
				<li>Schwarz-Rot-Gold als Zeichen für Demokratie und Freiheit sichtbar machen und unsere Farben nicht den Feinden der Demokratie überlassen</li>
				<li>Menschen ermutigen, offen zu zeigen, dass sie zu unserer Demokratie stehen</li>
				<li>alle Demokratinnen und Demokraten über Parteigrenzen hinweg verbinden, statt zu spalten</li>
			</ul>
		</div>
	</div>

	<!-- steht direkt hinter dem Abschnitt und läuft sofort, damit er nicht kurz aufblitzt (wie der Lebenslauf auf „Fragen“) -->
	<script is:inline>
		(() => {
			const knopf = document.querySelector('.aufklappen');
			const bereich = document.getElementById('werte-ziele');
			const innen = bereich.firstElementChild;

			knopf.hidden = false;
			document.querySelector('.aufklappen-text').remove();
			bereich.classList.add('zu');
			// „until-found“: die Suche im Browser (Strg+F) klappt den Abschnitt bei einem Treffer auf
			innen.setAttribute('hidden', 'until-found');

			function oeffnen() {
				knopf.setAttribute('aria-expanded', 'true');
				innen.hidden = false;
				bereich.offsetHeight; // erst einblenden, dann aufschieben, sonst springt es ohne Animation auf
				bereich.classList.remove('zu');
			}

			function schliessen() {
				knopf.setAttribute('aria-expanded', 'false');
				bereich.classList.add('zu');
				setTimeout(() => {
					if (bereich.classList.contains('zu')) innen.setAttribute('hidden', 'until-found');
				}, 300); // Dauer der Animation
			}

			knopf.addEventListener('click', () => {
				if (knopf.getAttribute('aria-expanded') === 'true') {
					schliessen();
				} else {
					oeffnen();
					// nur das Aufklappen zählen, nicht das Zuklappen
					window.umami?.track('werte-ziele-aufklappen');
				}
			});

			innen.addEventListener('beforematch', oeffnen);

			function perAdresse() {
				if (['#werte', '#werte-ziele'].includes(location.hash) && knopf.getAttribute('aria-expanded') !== 'true') oeffnen();
			}
			addEventListener('hashchange', perAdresse);
			addEventListener('pageshow', perAdresse);
			perAdresse();
		})();
	</script>

	{verbuendete.length === 0 && (
		<p class="neu">
			<strong>Diese Seite ist ganz neu.</strong> Noch stehen hier keine Namen. Sei unter den Ersten, die mit uns
			Flagge zeigen!
		</p>
	)}

	{gruppen.map((g) => {
		const eintraege = verbuendete.filter((v) => v.art === g.art);
		return (
			eintraege.length > 0 && (
				<section aria-labelledby={`gruppe-${g.art}`}>
					<h2 id={`gruppe-${g.art}`}>{g.titel}</h2>
					<ul class="liste">
						{eintraege.map((v) => (
							<li>
								{v.logo && <Image class="logo" src={v.logo} alt="" width={240} />}
								<div>
									{v.url ? <a href={v.url} rel="noopener">{v.name}</a> : <strong>{v.name}</strong>}
									{v.zusatz && <span class="zusatz">{v.zusatz}</span>}
									{v.zitat && <q class="zitat">{v.zitat}</q>}
								</div>
							</li>
						))}
					</ul>
				</section>
			)
		);
	})}

	<section class="kasten" id="eintragen" aria-labelledby="eintragen-titel">
		<h2 id="eintragen-titel">Du bist gleichgesinnt? Dann verbünde dich mit uns!</h2>
		<p>
			Ob als Privatperson, Verein oder Firma: Schreib uns eine E-Mail an
			<a href={mailto('Wir sind Verbündete')} data-umami-event="email-verbuendete">info@d-wie-demokratie.de</a>, Betreff
			„Wir sind Verbündete“. Schreib dazu,
		</p>
		<ul>
			<li>unter welchem Namen wir dich hier nennen dürfen,</li>
			<li>als Privatperson auf Wunsch deinen Beruf oder deinen Ort,</li>
			<li>als Organisation euren Ort, eure Website und auf Wunsch euer Logo,</li>
			<li>auf Wunsch einen kurzen Satz, warum du dabei bist.</li>
		</ul>
		<p>
			Verbündete teilen unsere Werte. Verpflichtungen entstehen dadurch keine, und es kostet nichts. Wir prüfen jeden
			Eintrag, bevor er hier erscheint. Ob wir einen Eintrag veröffentlichen, entscheiden wir.
			Mit einem eingesandten Logo erlaubst du uns, es hier zu zeigen.
		</p>
		<p>
			Du kannst deinen Eintrag jederzeit mit einer kurzen E-Mail wieder entfernen lassen.
		</p>
	</section>

	<p class="mehr">
		Du möchtest mehr tun? Dann schau bei <a href="/unterstuetzen/">„Unterstützen“</a> vorbei.
	</p>
</Layout>

<style>
	/* Hinweis, solange die Liste leer ist */
	.neu {
		padding: 0.8em 1em;
		border-left: 4px solid var(--gold);
		background: #fff8d6;
	}

	h1 {
		font-size: clamp(1.85rem, 7.5vw, 2.75rem);
	}

	/* „Werte und Ziele“ als Knopf, der wie ein Link aussieht; der Pfeil dreht sich beim Aufklappen (wie auf „Fragen“) */
	.aufklappen {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.aufklappen[hidden] {
		display: none;
	}

	.aufklappen::after {
		content: '▾';
		display: inline-block;
		margin-left: 0.25em;
		font-size: 0.8em;
		transition: transform 0.3s;
	}

	.aufklappen[aria-expanded='true']::after {
		transform: rotate(180deg);
	}

	@media (hover: hover) {
		.aufklappen:hover {
			color: var(--rot);
		}
	}

	/* Aufschieben über die Zeilenhöhe des Rasters (0fr = zu, 1fr = so hoch wie der Inhalt) */
	.werte-ziele {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.3s ease;
	}

	.werte-ziele.zu {
		grid-template-rows: 0fr;
	}

	/* der Innenabstand links hält die Aufzählungspunkte im sichtbaren Bereich (overflow schneidet sonst ab) */
	.werte-ziele-innen {
		min-height: 0;
		overflow: hidden;
		margin-left: -1em;
		padding-left: 1em;
	}

	/* gleicher Einzug wie die Werte darüber */
	.ziele {
		padding-left: 0.8em;
	}

	.werte-ziele-innen > p:first-child {
		margin-top: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.werte-ziele,
		.aufklappen::after {
			transition: none;
		}
	}

	.lead {
		font-size: 1.3rem;
	}

	h2 {
		font-size: 1.4rem;
	}

	.liste {
		padding: 0;
		list-style: none;
	}

	.liste li {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		padding: 0.5em 0;
		border-bottom: 1px solid #e4e4e4;
	}

	/* Zitat unter dem Namen, mit deutschen Anführungszeichen */
	.zitat {
		display: block;
		margin-top: 0.3em;
		font-style: italic;
		quotes: '„' '“';
	}

	/* Logos einheitlich klein, ohne sie zu verzerren */
	.logo {
		flex: none;
		width: 96px;
		height: 48px;
		object-fit: contain;
	}

	.zusatz {
		display: block;
		color: #555555;
		font-size: 0.95rem;
	}

	/* Kasten mit Schwarz-Rot-Gold links, wie auf „Mitmachen“ und „Motiv einreichen“ */
	.kasten {
		margin-top: 2.5em;
		padding: 0.2em 1.5em 0.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	@media (max-width: 480px) {
		.kasten {
			padding-right: 1em;
			padding-left: calc(1em + 12px);
		}
	}

	.mehr {
		margin-top: 2em;
	}
</style>
