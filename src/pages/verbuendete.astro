---
import Eintrag from '../components/VerbuendeterEintrag.astro';
import Werte from '../components/Werte.astro';
import Ziele from '../components/Ziele.astro';
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import reichstag from '../assets/flagge/1990-reichstag.jpg';

// Reichstag-Foto als Struktur im goldenen Knopf oben (wie bei den Knöpfen in „Bitte weitersagen“; Nachweis dort)
const wasserzeichen = await getImage({ src: reichstag, width: 1000, format: 'webp' });

type Verbuendeter = {
	name: string;
	// Organisation: Vereine, Schulen, Firmen usw.
	art: 'person' | 'organisation';
	// Tätigkeit und/oder Ort, z. B. „Lehrerin, Köln“
	zusatz?: string;
	url?: string;
	// kurzer Satz des Verbündeten, warum er dabei ist (ohne Anführungszeichen eintragen)
	zitat?: string;
	// Logo (meist bei Organisationen), Datei in src/assets/verbuendete/
	logo?: ImageMetadata;
};

// Neue Einträge erst nach Prüfung und schriftlicher Einwilligung aufnehmen
const verbuendete: Verbuendeter[] = [
	{ name: 'Birgit Koch', art: 'person', zusatz: 'Fotografin, München', zitat: 'Weil wir unsere Demokratie stärken müssen.' },
	{ name: 'Heinz Krimmer', art: 'person', zusatz: 'Autor und Journalist, Berlin', url: 'https://heinzkrimmer.com' },
	{ name: 'EduStock', art: 'organisation', zusatz: 'Bilder für Bildung, Berlin', url: 'https://edustock.org' },
];

const gruppen = [
	{ art: 'person', titel: 'Personen' },
	{ art: 'organisation', titel: 'Organisationen' },
] as const;

// Selbsteintrag: Formular schickt an die Lead Capture „Verbündete“ im Intranet (EspoCRM, Interessenten);
// EspoCRM schickt die Bestätigungsmail (Double-Opt-in), erst danach erscheint die Anfrage im Intranet.
// Veröffentlicht wird nichts automatisch: Klaus prüft, dann wird der Eintrag oben in `verbuendete` ergänzt.
const anfrageUrl = 'https://intranet.d-wie-demokratie.de/api/v1/LeadCapture/4435a859ed72ba5381cf9ff1a3124127';

const mailto = (betreff: string) => `mailto:info@d-wie-demokratie.de?subject=${encodeURIComponent(betreff)}`;
---

<Layout
	title="Verbündete – D wie Demokratie"
	description="Menschen, Organisationen und Firmen, die mit d-wie-demokratie.de Flagge zeigen für Demokratie und Grundgesetz. Verbünde dich mit uns."
>
	<h1>Wir sind Verbündete</h1>

	<p class="lead">
		Wir teilen
		<button type="button" class="aufklappen" aria-expanded="false" aria-controls="werte-ziele" hidden>Werte und Ziele</button><span class="aufklappen-text">Werte und Ziele</span>.
	</p>

	<!-- ohne JavaScript gleich offen; …/verbuendete/#werte öffnet den Abschnitt -->
	<div class="werte-ziele" id="werte-ziele">
		<div class="werte-ziele-innen" id="werte">
			<p><strong>Unsere Werte</strong> sind die zentralen Werte unseres Grundgesetzes:</p>
			<Werte />
			<p><strong>Unsere Ziele:</strong></p>
			<Ziele />
		</div>
	</div>

	<!-- steht direkt hinter dem Abschnitt und läuft sofort, damit er nicht kurz aufblitzt (wie der Lebenslauf auf „Fragen“) -->
	<script is:inline>
		// auch für „keine Verpflichtungen“ am Formular (siehe dort); Text ohne JavaScript steht im span direkt hinter dem Knopf
		window.aufklappbar = (knopf, umamiEreignis, adressen) => {
			const bereich = document.getElementById(knopf.getAttribute('aria-controls'));
			const innen = bereich.firstElementChild;

			knopf.hidden = false;
			knopf.nextElementSibling.remove();
			bereich.classList.add('zu');
			// „until-found“: die Suche im Browser (Strg+F) klappt den Abschnitt bei einem Treffer auf
			innen.setAttribute('hidden', 'until-found');

			function oeffnen() {
				knopf.setAttribute('aria-expanded', 'true');
				innen.hidden = false;
				bereich.offsetHeight; // erst einblenden, dann aufschieben, sonst springt es ohne Animation auf
				bereich.classList.remove('zu');
			}

			function schliessen() {
				knopf.setAttribute('aria-expanded', 'false');
				bereich.classList.add('zu');
				setTimeout(() => {
					if (bereich.classList.contains('zu')) innen.setAttribute('hidden', 'until-found');
				}, 300); // Dauer der Animation
			}

			knopf.addEventListener('click', () => {
				if (knopf.getAttribute('aria-expanded') === 'true') {
					schliessen();
				} else {
					oeffnen();
					// nur das Aufklappen zählen, nicht das Zuklappen
					window.umami?.track(umamiEreignis);
				}
			});

			innen.addEventListener('beforematch', oeffnen);

			function perAdresse() {
				if (adressen.includes(location.hash) && knopf.getAttribute('aria-expanded') !== 'true') oeffnen();
			}
			addEventListener('hashchange', perAdresse);
			addEventListener('pageshow', perAdresse);
			perAdresse();
		};
		aufklappbar(document.querySelector('[aria-controls="werte-ziele"]'), 'werte-ziele-aufklappen', ['#werte', '#werte-ziele']);
	</script>

	<!-- Einladung gleich oben, springt zum Formular weiter unten (bei vielen Verbündeten sonst weit weg) -->
	<p class="einladung"><a href="#eintragen" class="einladung-knopf" style={`--wz-url: url(${wasserzeichen.src})`}>Ja, ich verbünde mich!</a></p>

	{verbuendete.length === 0 && (
		<p class="neu">
			<strong>Diese Seite ist ganz neu.</strong> Noch stehen hier keine Namen. Sei unter den Ersten, die mit uns
			Flagge zeigen!
		</p>
	)}

	{gruppen.map((g) => {
		const eintraege = verbuendete.filter((v) => v.art === g.art);
		// lokal auch leere Bereiche zeigen, damit man das Aussehen sieht
		const leerZeigen = import.meta.env.DEV;
		return (
			(eintraege.length > 0 || leerZeigen) && (
				<section aria-labelledby={`gruppe-${g.art}`}>
					<h2 id={`gruppe-${g.art}`}>{g.titel}{eintraege.length > 0 && <span class="anzahl"> ({eintraege.length})</span>}</h2>
					{eintraege.length > 0 ? (
						<ul class="liste">{eintraege.map((v) => <Eintrag v={v} />)}</ul>
					) : (
						leerZeigen && <p class="leer">Noch leer (nur lokal sichtbar)</p>
					)}
				</section>
			)
		);
	})}

	<section class="kasten" id="eintragen" aria-labelledby="eintragen-titel">
		<h2 id="eintragen-titel" class="vor-dem-senden">Ja, ich verbünde mich!</h2>
		<!-- „keine Verpflichtungen“ klappt die Liste auf, die die Angst vor dem Eintragen nimmt (wie „Werte und Ziele“ oben) -->
		<div class="vor-dem-senden">
			<p>
				Es entstehen
				<button type="button" class="aufklappen" aria-expanded="false" aria-controls="zusagen" hidden>keine Verpflichtungen</button><span>keine Verpflichtungen</span>.
			</p>
			<div class="werte-ziele" id="zusagen">
				<div class="werte-ziele-innen">
					<ul class="zusagen">
						<li>Es kostet nichts, und du gehst keine Verpflichtung ein.</li>
						<li>Wir schicken dir keinen Newsletter und geben deine Daten nicht weiter.</li>
						<li>Deine E-Mail-Adresse wird nie veröffentlicht.</li>
						<li>Eine kurze E-Mail genügt, und du stehst nicht mehr drauf.</li>
						<li>Wir prüfen jeden Eintrag, bevor er hier erscheint.</li>
						<li>Ob wir einen Eintrag veröffentlichen, entscheiden wir.</li>
					</ul>
				</div>
			</div>
			<script is:inline>
				aufklappbar(document.querySelector('[aria-controls="zusagen"]'), 'verpflichtungen-aufklappen', ['#zusagen']);
			</script>
		</div>

		<!-- erscheint nur mit JavaScript (schickt die Angaben als JSON ans Intranet); sonst bleibt der Weg per E-Mail -->
		<form class="formular" data-ziel={anfrageUrl} hidden novalidate>
			<fieldset class="art">
				<legend>Ich verbünde mich als</legend>
				<label><input type="radio" name="art" value="Person" checked /> Person</label>
				<label><input type="radio" name="art" value="Organisation" /> Organisation</label>
			</fieldset>

			<div class="nur-person">
				<div class="zeile">
					<label class="titel-feld">Titel
						<input name="titel" maxlength="30" autocomplete="honorific-prefix" />
					</label>
					<label><span>Vorname<span class="muss" aria-hidden="true">*</span></span>
						<input name="vorname" maxlength="100" autocomplete="given-name" data-pflicht-person />
					</label>
				</div>
				<label><span>Nachname<span class="muss" aria-hidden="true">*</span></span>
					<span class="hinweis">Der erste Buchstabe genügt.</span>
					<input name="nachname" maxlength="100" autocomplete="family-name" data-pflicht-person />
				</label>
			</div>

			<div class="nur-organisation" hidden>
				<label><span>Name der Organisation<span class="muss" aria-hidden="true">*</span></span>
					<input name="organisation" maxlength="150" autocomplete="organization" data-pflicht-organisation />
				</label>
			</div>

			<label><span>Tätigkeit und Ort<span class="muss" aria-hidden="true">*</span></span>
				<span class="hinweis nur-person">z. B. „Lehrerin, Kassel“</span>
				<span class="hinweis nur-organisation" hidden>z. B. „Sportverein, Leipzig“</span>
				<input name="taetigkeit" maxlength="150" required />
			</label>

			<label>Website
				<!-- kein type="url": der verlangt „https://“; das ergänzt das Skript beim Absenden selbst -->
				<input name="website" inputmode="url" maxlength="200" placeholder="z. B. meine-seite.de" autocomplete="url" />
			</label>

			<label>Warum bist du dabei?
				<span class="hinweis">Ein Satz genügt.</span>
				<textarea name="satz" rows="1" maxlength="300"></textarea>
			</label>

			<label><span>Deine E-Mail-Adresse<span class="muss" aria-hidden="true">*</span></span>
				<span class="hinweis">Nur für die Bestätigung und für Rückfragen, wird nicht veröffentlicht.</span>
				<input name="email" type="email" maxlength="150" autocomplete="email" required />
			</label>

			<!-- Falle für Spam-Programme, für Menschen unsichtbar -->
			<input class="falle" name="webseite2" tabindex="-1" autocomplete="off" aria-hidden="true" />

			<label class="haken">
				<input type="checkbox" name="einwilligung" required />
				<span>Ich bin einverstanden, dass Name, Tätigkeit und Ort, Website und mein Satz auf d-wie-demokratie.de
				veröffentlicht werden. Ich kann das jederzeit per E-Mail widerrufen. Mehr in der <a href="/datenschutz/">Datenschutzerklärung</a>.</span>
			</label>
			<label class="haken nur-organisation" hidden>
				<input type="checkbox" name="vertretung" data-pflicht-organisation />
				<span>Ich darf für diese Organisation sprechen.</span>
			</label>

			<p class="fehler" role="alert" hidden></p>
			<!-- gelb mit Wasserzeichen wie der Knopf „Ja, ich verbünde mich!“ oben -->
			<button type="submit" class="absenden einladung-knopf" style={`--wz-url: url(${wasserzeichen.src})`}>Formular absenden</button>
			<!-- zeigt, was nach dem Absenden passiert (nimmt die Angst vor dem Klick); verschwindet mit dem Formular -->
			<div class="danach">
				<p>Nach dem Klick geht es so weiter:</p>
				<ol>
					<li>Du bekommst eine E-Mail und bestätigst darin deine Adresse.</li>
					<li>Wir schauen uns deinen Eintrag an.</li>
					<li>Sobald dein Eintrag online ist, senden wir dir eine E-Mail.</li>
				</ol>
			</div>
		</form>

		<div class="danke" role="status" hidden>
			<p><strong>Fast geschafft!</strong> Wir haben dir eine E-Mail geschickt. Bitte klick auf den Link darin, erst dann
			erreicht uns deine Anfrage. Schau notfalls auch im Spam-Ordner nach.</p>
		</div>

		<p class="per-mail vor-dem-senden">
			<span class="mit-formular" hidden>Lieber per E-Mail?</span> Schreib uns an
			<a href={mailto('Wir sind Verbündete')} data-umami-event="email-verbuendete">info@d-wie-demokratie.de</a>, Betreff
			„Wir sind Verbündete“, mit dem Namen, den wir nennen sollen, Tätigkeit, Ort, Website und gern einem kurzen Satz.
		</p>
		<p class="vor-dem-senden">
			Du kannst deinen Eintrag jederzeit mit einer kurzen E-Mail wieder entfernen lassen.
		</p>
	</section>

	<script>
		const formular = document.querySelector<HTMLFormElement>('.formular');
		if (formular) {
			const geladen = Date.now();
			const fehler = formular.querySelector<HTMLElement>('.fehler')!;
			const knopf = formular.querySelector<HTMLButtonElement>('.absenden')!;
			formular.hidden = false;
			document.querySelector<HTMLElement>('.mit-formular')!.hidden = false;

			// Person oder Organisation: passende Felder zeigen und zur Pflicht machen
			const umschalten = () => {
				const org = (formular.elements.namedItem('art') as RadioNodeList).value === 'Organisation';
				formular.querySelectorAll<HTMLElement>('.nur-person').forEach((e) => (e.hidden = org));
				formular.querySelectorAll<HTMLElement>('.nur-organisation').forEach((e) => (e.hidden = !org));
				formular.querySelectorAll<HTMLInputElement>('[data-pflicht-person]').forEach((e) => (e.required = !org));
				formular.querySelectorAll<HTMLInputElement>('[data-pflicht-organisation]').forEach((e) => (e.required = org));
			};
			formular.addEventListener('change', (e) => {
				if ((e.target as HTMLInputElement).name === 'art') umschalten();
			});
			umschalten();

			// Satz-Feld wächst mit dem Text (für Browser ohne field-sizing)
			const satz = formular.querySelector<HTMLTextAreaElement>('textarea[name="satz"]')!;
			if (!CSS.supports('field-sizing', 'content')) {
				const anpassen = () => {
					satz.style.height = 'auto';
					satz.style.height = satz.scrollHeight + 2 + 'px';
				};
				satz.addEventListener('input', anpassen);
				anpassen();
			}

			// nach dem Absenden nur noch Überschrift und „Fast geschafft“ zeigen
			const fertig = () => {
				formular.hidden = true;
				formular.closest('.kasten')?.classList.add('gesendet');
				document.querySelectorAll<HTMLElement>('.vor-dem-senden').forEach((e) => (e.hidden = true));
				const danke = document.querySelector<HTMLElement>('.danke')!;
				danke.hidden = false;
				return danke;
			};

			const zeigeFehler = (text: string) => {
				fehler.textContent = text;
				fehler.hidden = false;
			};

			formular.addEventListener('submit', async (e) => {
				e.preventDefault();
				fehler.hidden = true;
				if (!formular.checkValidity()) {
					formular.reportValidity();
					return;
				}
				const d = new FormData(formular);
				const wert = (n: string) => String(d.get(n) ?? '').trim();
				// Spam-Programme füllen die Falle aus oder schicken in Sekunden ab: so tun, als hätte es geklappt
				if (wert('webseite2') || Date.now() - geladen < 4000) {
					fertig();
					return;
				}
				const org = wert('art') === 'Organisation';
				let website = wert('website');
				if (website && !/^https?:\/\//i.test(website)) website = 'https://' + website;
				const daten = {
					cArt: wert('art'),
					cTitel: org ? '' : wert('titel'),
					firstName: org ? '' : wert('vorname'),
					lastName: org ? wert('organisation') : wert('nachname'),
					emailAddress: wert('email'),
					website,
					cTaetigkeit: wert('taetigkeit'),
					cSatz: wert('satz'),
					cVertretung: org && d.get('vertretung') === 'on',
				};
				knopf.disabled = true;
				knopf.textContent = 'Wird gesendet …';
				try {
					const antwort = await fetch(formular.dataset.ziel!, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(daten),
					});
					if (!antwort.ok) throw new Error(String(antwort.status));
					window.umami?.track('verbuendete-formular');
					fertig().scrollIntoView({ block: 'center', behavior: 'smooth' });
				} catch {
					zeigeFehler('Das hat leider nicht geklappt. Bitte versuch es später noch einmal oder schreib uns an info@d-wie-demokratie.de.');
				} finally {
					knopf.disabled = false;
					knopf.textContent = 'Formular absenden';
				}
			});
		}
	</script>

	<p class="mehr">
		Du möchtest mehr tun? Dann schau bei <a href="/mitmachen/">„Mitmachen“</a> und <a href="/unterstuetzen/">„Unterstützen“</a> vorbei.
	</p>
</Layout>

<style>
	/* Liste unter „keine Verpflichtungen“: Häkchen statt Punkte */
	.zusagen {
		list-style: none;
		margin: 0 0 1em;
		padding-left: 0;
	}

	.zusagen li {
		position: relative;
		padding-left: 1.6em;
		margin: 0.3em 0;
	}

	.zusagen li::before {
		content: '✓';
		position: absolute;
		left: 0.2em;
		color: var(--rot);
		font-weight: bold;
	}

	/* Hinweis, solange die Liste leer ist */
	.neu {
		padding: 0.8em 1em;
		border-left: 4px solid var(--gold);
		background: #fff8d6;
	}

	/* „Werte und Ziele“ als Knopf, der wie ein Link aussieht; der Pfeil dreht sich beim Aufklappen (wie auf „Fragen“) */
	.aufklappen {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		cursor: pointer;
	}

	.aufklappen[hidden] {
		display: none;
	}

	.aufklappen::after {
		content: '▾';
		display: inline-block;
		margin-left: 0.25em;
		font-size: 0.8em;
		transition: transform 0.3s;
	}

	.aufklappen[aria-expanded='true']::after {
		transform: rotate(180deg);
	}

	@media (hover: hover) {
		.aufklappen:hover {
			color: var(--rot);
		}
	}

	/* Aufschieben über die Zeilenhöhe des Rasters (0fr = zu, 1fr = so hoch wie der Inhalt) */
	.werte-ziele {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.3s ease;
	}

	.werte-ziele.zu {
		grid-template-rows: 0fr;
	}

	/* der Innenabstand links hält die Aufzählungspunkte im sichtbaren Bereich (overflow schneidet sonst ab) */
	.werte-ziele-innen {
		min-height: 0;
		overflow: hidden;
		margin-left: -1em;
		padding-left: 1em;
	}

	.werte-ziele-innen > p:first-child {
		margin-top: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.werte-ziele,
		.aufklappen::after {
			transition: none;
		}
	}

	.lead {
		font-size: 1.3rem;
	}

	/* Zahl hinter „Personen“ und „Organisationen“, etwas zurückhaltender */
	.anzahl {
		color: var(--grau);
		font-weight: normal;
	}

	.liste {
		padding: 0;
		list-style: none;
	}

	.leer {
		color: var(--grau);
		font-style: italic;
	}

	/* Kasten mit Schwarz-Rot-Gold links, wie auf „Mitmachen“ und „Motiv einreichen“ */
	.kasten {
		margin-top: 2.5em;
		padding: 0.2em 1.5em 0.5em;
		padding-left: calc(1.5em + 12px);
		background:
			linear-gradient(
				to right,
				var(--schwarz) 0 33.33%,
				var(--rot) 33.33% 66.66%,
				var(--gold) 66.66% 100%
			) left / 12px 100% no-repeat,
			#fafafa;
	}

	@media (max-width: 480px) {
		.kasten {
			padding-right: 1em;
			padding-left: calc(1em + 12px);
		}
	}

	.mehr {
		margin-top: 2em;
	}

	/* der Satz darüber bringt schon Abstand mit (der zugeklappte Bereich „Werte und Ziele“ dazwischen verhindert, dass die Abstände zusammenfallen) */
	.einladung {
		margin: 0.3em 0 2em;
	}

	/* gold über die ganze Breite, mit dem Reichstag-Foto als Struktur (wie „Link kopieren“ unten) */
	.einladung-knopf {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: block;
		padding: 0.6em 0.8em;
		border-radius: 6px;
		background: var(--gold);
		color: var(--schwarz);
		/* groß, wächst mit der Breite: auf dem Handy so, dass es in eine Zeile passt (ab 320 px), am Rechner bis 1,7rem */
		font-size: clamp(1.15rem, 5vw, 1.7rem);
		font-weight: bold;
		line-height: 1.25;
		white-space: nowrap;
		text-align: center;
		text-decoration: none;
	}

	.einladung-knopf::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--wz-url) center 85% / max(100%, 435px) auto no-repeat;
		filter: grayscale(1) contrast(1.1);
		opacity: 0.25;
		mix-blend-mode: luminosity;
		pointer-events: none;
	}

	@media (hover: hover) {
		.einladung-knopf:hover {
			filter: brightness(1.15);
		}
	}

	/* Einladung groß, fast wie die Seitenüberschrift */
	#eintragen-titel {
		margin: 0.7em 0 0.5em;
		font-size: 2rem;
		line-height: 1.2;
	}

	/* Formular zum Selbsteintrag */
	.formular {
		display: grid;
		gap: 1em;
		margin: 1.2em 0;
	}

	/* !important, weil die Feld-Stile unten (display: grid/flex) sonst stärker sind */
	.formular[hidden],
	.formular [hidden] {
		display: none !important;
	}

	.danke[hidden],
	.mit-formular[hidden] {
		display: none;
	}

	.formular label {
		display: grid;
		gap: 0.3em;
		font-weight: bold;
	}

	.formular input:not([type='radio'], [type='checkbox']),
	.formular textarea {
