---
// Gemeinsamer Rahmen für alle Seiten: <head>, Farbstreifen oben, Fußzeile.
import aufkleber from '../assets/aufkleber.png';
import { Image } from 'astro:assets';
import logo from '../assets/d-wie-demokratie-logo.png';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pfad = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/aufkleber-d-wie-demokratie.png', Astro.site);
// Reihenfolge der Reiter, für das Wischen auf dem Handy und die Richtung der Animation
const reiter = ['/', '/haeufige-fragen/', '/unterstuetzer/', '/sag-es-weiter/'];
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}

		<!-- Vorschau beim Teilen in Messengern und sozialen Netzwerken -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(aufkleber.width)} />
		<meta property="og:image:height" content={String(aufkleber.height)} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Besucherstatistik mit Umami (selbst betrieben, ohne Cookies); zählt nur auf der echten Domain, nicht lokal -->
		<script
			is:inline
			defer
			src="https://stats.5-finger.com/script.js"
			data-website-id="1700ae4d-0b3e-4de1-8e27-dd8e4a7c96d3"
			data-domains="d-wie-demokratie.de"
		></script>

		<!-- Wischen zwischen den Reitern; beim Wechsel gleitet der Inhalt seitlich herein.
		     Steht im <head>, damit „pagereveal“ vor dem ersten Zeichnen abgefangen wird. -->
		<script is:inline define:vars={{ reiter }}>
			const nummer = (url) => {
				const pfad = new URL(url, location.href).pathname;
				return reiter.findIndex((r) => r === pfad || r === pfad + '/');
			};

			// Richtung der Animation: zum Reiter weiter rechts „vor“, nach links „zurueck“
			addEventListener('pagereveal', (e) => {
				if (!e.viewTransition) return;
				const von = nummer(navigation?.activation?.from?.url ?? document.referrer);
				const nach = nummer(location.href);
				if (von === -1 || nach === -1 || von === nach) {
					e.viewTransition.skipTransition();
					return;
				}
				document.documentElement.dataset.richtung = nach > von ? 'vor' : 'zurueck';
				e.viewTransition.finished.finally(() => delete document.documentElement.dataset.richtung);
			});

			let start = null;
			addEventListener(
				'touchstart',
				(e) => {
					const t = e.touches[0];
					start = null;
					// Start am Bildschirmrand gehört dem „Zurück“ des Browsers, die Reiterleiste wischt selbst
					if (e.touches.length !== 1 || t.clientX < 30 || t.clientX > innerWidth - 30) return;
					if (e.target.closest('nav, input, textarea')) return;
					start = { x: t.clientX, y: t.clientY, zeit: Date.now() };
				},
				{ passive: true }
			);
			addEventListener(
				'touchend',
				(e) => {
					if (!start) return;
					const t = e.changedTouches[0];
					const dx = t.clientX - start.x;
					const dy = t.clientY - start.y;
					const dauer = Date.now() - start.zeit;
					start = null;
					// nur eine kurze, deutlich waagerechte Bewegung; nicht beim Markieren oder Hineinzoomen
					if (Math.abs(dx) < 70 || Math.abs(dx) < 2 * Math.abs(dy) || dauer > 700) return;
					if (getSelection()?.toString() || (visualViewport && visualViewport.scale > 1.05)) return;
					const ziel = reiter[nummer(location.href) + (dx < 0 ? 1 : -1)];
					if (nummer(location.href) !== -1 && ziel) location.href = ziel;
				},
				{ passive: true }
			);
		</script>
	</head>
	<body>
		<!-- Kopfzeile bleibt beim Scrollen oben stehen -->
		<header class="kopf">
			<div class="flagge" aria-hidden="true"></div>
			<nav aria-label="Hauptnavigation">
				<a href="/" class="logo" aria-current={pfad === '/' ? 'page' : undefined} aria-label="Startseite">
					<Image src={logo} alt="" width={60} densities={[1, 2, 3]} loading="eager" />
				</a>
				<a href="/haeufige-fragen/" aria-current={pfad.startsWith('/haeufige-fragen') ? 'page' : undefined}>Häufige Fragen</a>
				<a href="/unterstuetzer/" aria-current={pfad.startsWith('/unterstuetzer') ? 'page' : undefined}>Unterstützer</a>
				<a href="/sag-es-weiter/" aria-current={pfad.startsWith('/sag-es-weiter') ? 'page' : undefined}>Sag’s weiter</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<a href="/impressum/">Impressum</a>
			<a href="/datenschutz/">Datenschutz</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--schwarz: #000000;
		--rot: #dd0000;
		--gold: #ffce00;
		--text: #1a1a1a;
		--grau: #5a5a5a;
	}

	* {
		box-sizing: border-box;
	}

	/* Sprungziele (#…) nicht unter der festen Kopfzeile verstecken */
	html {
		scroll-padding-top: 5rem;
	}

	body {
		margin: 0;
		background: #ffffff;
		color: var(--text);
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		font-size: 1.15rem;
		line-height: 1.6;
	}

	main {
		width: 100%;
		max-width: 680px; /* Seitenbreite */
		margin: 0 auto;
		padding: 2em 1em 3em;
		overflow-wrap: break-word;
	}

	h1,
	h2 {
		line-height: 1.2;
	}

	a {
		color: var(--text);
		text-decoration-color: currentColor;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	a:hover {
		color: var(--rot);
	}

	/* „d-wie-demokratie.de“ nie umbrechen (wird in src/middleware.ts automatisch gesetzt) */
	.nobr {
		white-space: nowrap;
	}

	/* Seitenwechsel zwischen den Reitern: nur der Inhalt gleitet, Kopf- und Fußzeile bleiben stehen */
	@view-transition {
		navigation: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		@view-transition {
			navigation: none;
		}
	}

	main {
		view-transition-name: inhalt;
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
	}

	::view-transition-group(inhalt) {
		animation-duration: 0.3s;
	}

	[data-richtung='vor']::view-transition-old(inhalt) {
		animation: 0.3s ease-in-out both inhalt-nach-links;
	}
	[data-richtung='vor']::view-transition-new(inhalt) {
		animation: 0.3s ease-in-out both inhalt-von-rechts;
	}
	[data-richtung='zurueck']::view-transition-old(inhalt) {
		animation: 0.3s ease-in-out both inhalt-nach-rechts;
	}
	[data-richtung='zurueck']::view-transition-new(inhalt) {
		animation: 0.3s ease-in-out both inhalt-von-links;
	}

	/* auf dem Handy um die volle Breite, am großen Bildschirm nur ein Stück mit Überblendung */
	:root {
		--weg: 3rem;
	}
	@media (max-width: 560px) {
		:root {
			--weg: 100vw;
		}
	}

	@keyframes inhalt-nach-links {
		to { transform: translateX(calc(-1 * var(--weg))); opacity: 0; }
	}
	@keyframes inhalt-von-rechts {
		from { transform: translateX(var(--weg)); opacity: 0; }
	}
	@keyframes inhalt-nach-rechts {
		to { transform: translateX(var(--weg)); opacity: 0; }
	}
	@keyframes inhalt-von-links {
		from { transform: translateX(calc(-1 * var(--weg))); opacity: 0; }
	}

	/* Für Screenreader lesbar, aber unsichtbar */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>

<style>
	.kopf {
		position: sticky;
		top: 0;
		z-index: 10;
		background: #ffffff;
		/* Trennlinie als Schatten, damit der rote Balken des aktiven Reiters darüberliegt */
		box-shadow: inset 0 -1px 0 #e5e5e5;
	}

	nav {
		display: flex;
		gap: 1.8em;
		/* passen die Reiter nicht in die Breite, lässt sich die Leiste seitlich wischen */
		overflow-x: auto;
		scrollbar-width: none;
		white-space: nowrap;
		max-width: 680px; /* Seitenbreite, damit die Links bündig mit dem Text stehen */
		margin: 0 auto;
		padding: 0 1em;
		font-size: 1rem;
		font-weight: bold;
	}

	/* Reiter: hohe Klickfläche (auch für Finger), aktuelle Seite mit rotem Balken unten */
	nav a {
		padding: 0.75em 0 calc(0.75em - 3px);
		border-bottom: 3px solid transparent;
		color: var(--grau);
		text-decoration: none;
	}

	/* auf dem Handy enger, damit möglichst alle Reiter sichtbar sind */
	@media (max-width: 560px) {
		/* passt so gerade auf ein 390 px breites iPhone; schmalere wischen die Leiste */
		nav {
			gap: 0.6em;
			padding: 0 0.3em 0 0.4em;
			font-size: 0.95rem;
		}
	}

	/* Logo statt „Startseite“: nutzt den Innenabstand der Reiter mit, damit es groß wirkt,
	   ohne die Kopfzeile zu erhöhen (Reiter: 0,75em + 1,6em Zeile + 0,75em = 3,1em) */
	/* „nav .logo“ statt „.logo“, sonst gewinnt der Innenabstand aus „nav a“ */
	nav .logo {
		display: flex;
		align-items: center;
		/* unten knapper als oben: dort folgt noch der (rote) Balken mit 3px */
		padding: 0.25em 0 0.1em;
	}

	.logo img {
		/* 3,1em minus Abstände oben und unten minus roter Balken (3px) */
		height: calc(2.75em - 3px);
		width: auto;
	}

	.logo:hover {
		opacity: 0.8;
	}

	nav a[aria-current='page'] {
		border-bottom-color: var(--rot);
		color: var(--text);
	}

	nav a:hover {
		color: var(--rot);
	}

	/* Schwarz-Rot-Gold als schmaler Streifen am oberen Rand */
	.flagge {
		height: 18px;
		background: linear-gradient(
			to bottom,
			var(--schwarz) 0 33.33%,
			var(--rot) 33.33% 66.66%,
			var(--gold) 66.66% 100%
		);
	}

	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em 2em;
		padding: 2em 1em;
		border-top: 1px solid #e5e5e5;
		font-size: 0.95rem;
	}

	footer a {
		color: var(--grau);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--rot);
	}
</style>
