---
// Gemeinsamer Rahmen für alle Seiten: <head>, Farbstreifen oben, Fußzeile.
import aufkleber from '../assets/aufkleber.png';
import { Image } from 'astro:assets';
import logo from '../assets/menu1.jpeg';
import SagEsWeiter from '../components/SagEsWeiter.astro';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	// Kasten „Bitte weitersagen“ unten; auf Rechts- und Einstellungsseiten abgeschaltet
	teilen?: boolean;
}

const { title, description, noindex = false, teilen = true } = Astro.props;
const pfad = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/aufkleber-d-wie-demokratie.png', Astro.site);
// Reihenfolge der Reiter, für das Wischen auf dem Handy und die Richtung der Animation
const reiter = ['/', '/haeufige-fragen/', '/verbuendete/', '/mitmachen/'];
// Menü ☰ oben rechts: alle Seiten, auch die ohne eigenen Reiter. Neue Seite = neuer Eintrag hier.
const menue = [
	{ href: '/', text: 'Startseite' },
	{ href: '/haeufige-fragen/', text: 'Fragen' },
	{ href: '/verbuendete/', text: 'Verbündete' },
	{ href: '/mitmachen/', text: 'Mitmachen' },
	{ href: '/unterstuetzen/', text: 'Unterstützen' },
	{ href: '/motiv-einreichen/', text: 'Motiv einreichen' },
	{ href: '/geschichte-unserer-flagge/', text: 'Kleine Geschichte unserer Flagge' },
	// Anmeldung steht unten auf jeder Seite mit Teilen-Kasten; auf den anderen (Impressum usw.) zur Startseite
	{ href: teilen ? '#neuigkeiten' : '/#neuigkeiten', text: 'Neuigkeiten per E-Mail' },
];
const menueKlein = [
	{ href: '/impressum/', text: 'Impressum' },
	{ href: '/datenschutz/', text: 'Datenschutz' },
];
// Seite ohne eigenen Reiter: dann trägt das Menü ☰ den roten Balken
const ohneReiter = !reiter.some((r) => (r === '/' ? pfad === '/' : pfad.startsWith(r)));
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-d.png" />

		<!-- „Zum Home-Bildschirm“: Icon, Name „Demokratie“ und Start ohne Adressleiste (Details im Manifest) -->
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Demokratie" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="theme-color" content="#ffffff" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}

		<!-- Vorschau beim Teilen in Messengern und sozialen Netzwerken -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content={String(aufkleber.width)} />
		<meta property="og:image:height" content={String(aufkleber.height)} />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Besucherstatistik mit Umami (selbst betrieben, ohne Cookies); zählt nur auf der echten Domain, nicht lokal -->
		<script
			is:inline
			defer
			src="https://stats.5-finger.com/script.js"
			data-website-id="1700ae4d-0b3e-4de1-8e27-dd8e4a7c96d3"
			data-domains="d-wie-demokratie.de"
		></script>

		<!-- Wischen zwischen den Reitern; beim Wechsel gleitet der Inhalt seitlich herein.
		     Steht im <head>, damit „pagereveal“ vor dem ersten Zeichnen abgefangen wird. -->
		<script is:inline define:vars={{ reiter }}>
			const nummer = (url) => {
				const pfad = new URL(url, location.href).pathname;
				return reiter.findIndex((r) => r === pfad || r === pfad + '/');
			};

			// Richtung der Animation: zum Reiter weiter rechts „vor“, nach links „zurueck“
			addEventListener('pagereveal', (e) => {
				if (!e.viewTransition) return;
				// Zurück/Vorwärts (z. B. Wischen vom Rand): dort animiert Safari selbst, sonst bewegt sich die Seite doppelt
				const zurueckVor =
					navigation?.activation?.navigationType === 'traverse' ||
					performance.getEntriesByType('navigation')[0]?.type === 'back_forward';
				if (zurueckVor) {
					e.viewTransition.skipTransition();
					return;
				}
				const von = nummer(navigation?.activation?.from?.url ?? document.referrer);
				const nach = nummer(location.href);
				if (von === -1 || nach === -1 || von === nach) {
					e.viewTransition.skipTransition();
					return;
				}
				document.documentElement.dataset.richtung = nach > von ? 'vor' : 'zurueck';
				e.viewTransition.finished.finally(() => delete document.documentElement.dataset.richtung);
			});

			let start = null;
			addEventListener(
				'touchstart',
				(e) => {
					const t = e.touches[0];
					start = null;
					// Start am Bildschirmrand gehört dem „Zurück“ des Browsers, die Reiterleiste wischt selbst
					if (e.touches.length !== 1 || t.clientX < 30 || t.clientX > innerWidth - 30) return;
					if (e.target.closest('nav, .menue, input, textarea')) return;
					start = { x: t.clientX, y: t.clientY, zeit: Date.now() };
				},
				{ passive: true }
			);
			addEventListener(
				'touchend',
				(e) => {
					if (!start) return;
					const t = e.changedTouches[0];
					const dx = t.clientX - start.x;
					const dy = t.clientY - start.y;
					const dauer = Date.now() - start.zeit;
					start = null;
					// nur eine kurze, deutlich waagerechte Bewegung; nicht beim Markieren oder Hineinzoomen
					if (Math.abs(dx) < 70 || Math.abs(dx) < 2 * Math.abs(dy) || dauer > 700) return;
					if (getSelection()?.toString() || (visualViewport && visualViewport.scale > 1.05)) return;
					const ziel = reiter[nummer(location.href) + (dx < 0 ? 1 : -1)];
					if (nummer(location.href) !== -1 && ziel) location.href = ziel;
				},
				{ passive: true }
			);
		</script>
	</head>
	<body>
		<!-- Kopfzeile bleibt beim Scrollen oben stehen -->
		<header class="kopf">
			<div class="flagge" aria-hidden="true"></div>
			<div class="leiste">
				<nav aria-label="Hauptnavigation">
					<a href="/" class="logo" aria-current={pfad === '/' ? 'page' : undefined} aria-label="Startseite">
						<Image src={logo} alt="" width={103} densities={[1, 2, 3]} loading="eager" />
					</a>
					<a href="/haeufige-fragen/" aria-current={pfad.startsWith('/haeufige-fragen') ? 'page' : undefined}>Fragen</a>
					<a href="/verbuendete/" aria-current={pfad.startsWith('/verbuendete') ? 'page' : undefined}>Verbündete</a>
					<a href="/mitmachen/" aria-current={pfad.startsWith('/mitmachen') ? 'page' : undefined}>Mitmachen</a>
				</nav>

				<!-- Menü mit allen Seiten; <details> klappt auch ohne JavaScript auf -->
				<details class:list={['menue', { hier: ohneReiter }]}>
					<summary aria-label="Menü">
						<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
							<path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
						</svg>
					</summary>
					<div class="menue-liste">
						{menue.map((m) => (
							<a href={m.href} aria-current={pfad === m.href ? 'page' : undefined}>{m.text}</a>
						))}
						<div class="menue-klein">
							{menueKlein.map((m) => (
								<a href={m.href} aria-current={pfad === m.href ? 'page' : undefined}>{m.text}</a>
							))}
						</div>
					</div>
				</details>
			</div>
		</header>

		<script>
			// Menü schließen beim Klick daneben und mit Escape
			const menue = document.querySelector<HTMLDetailsElement>('.menue');
			if (menue) {
				document.addEventListener('click', (e) => {
					if (menue.open && !menue.contains(e.target as Node)) menue.open = false;
				});
				// ein Link im Menü schließt es, auch wenn er nur auf derselben Seite springt (#neuigkeiten)
				menue.addEventListener('click', (e) => {
					if ((e.target as Element).closest('a')) menue.open = false;
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && menue.open) {
						menue.open = false;
						menue.querySelector('summary')?.focus();
					}
				});
			}
		</script>

		<main>
			<slot />
			{teilen && <SagEsWeiter />}
		</main>

		<footer>
			<a href="/impressum/">Impressum</a>
			<a href="/datenschutz/">Datenschutz</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--schwarz: #000000;
		--rot: #dd0000;
		--gold: #ffce00;
		--text: #1a1a1a;
		--grau: #5a5a5a;
	}

	* {
		box-sizing: border-box;
	}

	/* Sprungziele (#…) nicht unter der festen Kopfzeile verstecken */
	html {
		scroll-padding-top: 5rem;
	}

	body {
		margin: 0;
		background: #ffffff;
		color: var(--text);
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		font-size: 1.15rem;
		line-height: 1.6;
	}

	main {
		width: 100%;
		max-width: 680px; /* Seitenbreite */
		margin: 0 auto;
		padding: 2em 1em 3em;
		overflow-wrap: break-word;
	}

	h1,
	h2 {
		line-height: 1.2;
	}

	a {
		color: var(--text);
		text-decoration-color: currentColor;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	a:hover {
		color: var(--rot);
	}

	/* „d-wie-demokratie.de“ nie umbrechen (wird in src/middleware.ts automatisch gesetzt) */
	.nobr {
		white-space: nowrap;
	}

	/* Seitenwechsel zwischen den Reitern: der sichtbare Bildschirm gleitet seitlich, die Kopfzeile bleibt stehen.
	   Bewusst der ganze Bildschirm (root) statt nur <main>: sonst springt der Inhalt beim Wechsel von einer
	   heruntergescrollten Seite zusätzlich nach oben und ändert seine Höhe, was auf dem Handy wackelt. */
	/* nur auf Touch-Geräten (Handy, Tablet), wo man zwischen den Reitern wischt; am Rechner stört die Bewegung */
	@media (hover: none) and (pointer: coarse) {
		@view-transition {
			navigation: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		@view-transition {
			navigation: none;
		}
	}

	.kopf {
		view-transition-name: kopf;
	}

	/* Kopfzeile wechselt ohne Bewegung (nur der rote Balken springt zum neuen Reiter) */
	::view-transition-group(kopf),
	::view-transition-new(kopf) {
		animation: none;
	}
	::view-transition-old(kopf) {
		display: none;
	}

	[data-richtung='vor']::view-transition-old(root) {
		animation: 0.3s ease-in-out both inhalt-nach-links;
	}
	[data-richtung='vor']::view-transition-new(root) {
		animation: 0.3s ease-in-out both inhalt-von-rechts;
	}
	[data-richtung='zurueck']::view-transition-old(root) {
		animation: 0.3s ease-in-out both inhalt-nach-rechts;
	}
	[data-richtung='zurueck']::view-transition-new(root) {
		animation: 0.3s ease-in-out both inhalt-von-links;
	}

	/* auf dem Handy um die volle Breite, am großen Bildschirm nur ein Stück mit Überblendung */
	:root {
		--weg: 3rem;
	}
	@media (max-width: 560px) {
		:root {
			--weg: 100vw;
		}
	}

	@keyframes inhalt-nach-links {
		to { transform: translateX(calc(-1 * var(--weg))); opacity: 0; }
	}
	@keyframes inhalt-von-rechts {
		from { transform: translateX(var(--weg)); opacity: 0; }
	}
	@keyframes inhalt-nach-rechts {
		to { transform: translateX(var(--weg)); opacity: 0; }
	}
	@keyframes inhalt-von-links {
		from { transform: translateX(calc(-1 * var(--weg))); opacity: 0; }
	}

	/* Für Screenreader lesbar, aber unsichtbar */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>

<style>
	.kopf {
		position: sticky;
		top: 0;
		z-index: 10;
		background: #ffffff;
		/* Trennlinie als Schatten, damit der rote Balken des aktiven Reiters darüberliegt */
		box-shadow: inset 0 -1px 0 #e5e5e5;
	}

	/* Reiter links, Menü ☰ rechts, beides auf Seitenbreite bündig mit dem Text */
	.leiste {
		position: relative;
		display: flex;
		align-items: stretch;
		max-width: 680px; /* Seitenbreite */
		margin: 0 auto;
		padding: 0 1em;
		font-size: 1rem;
	}

	nav {
		display: flex;
		flex: 1;
		min-width: 0;
		gap: 1.8em;
		/* passen die Reiter nicht in die Breite, lässt sich die Leiste seitlich wischen */
		overflow-x: auto;
		scrollbar-width: none;
		white-space: nowrap;
		font-weight: bold;
	}

	/* Reiter: hohe Klickfläche (auch für Finger), aktuelle Seite mit rotem Balken unten */
	nav a {
		padding: 0.75em 0 calc(0.75em - 3px);
		border-bottom: 3px solid transparent;
		color: var(--grau);
		text-decoration: none;
	}

	/* auf dem Handy enger, damit alle Reiter ohne Wischen sichtbar sind (geprüft ab 320 px Breite) */
	@media (max-width: 560px) {
		.leiste {
			padding: 0 0.3em 0 0.4em;
			font-size: 0.9rem;
		}

		nav {
			gap: 0.45em;
		}
	}

	/* Logo statt „Startseite“: nutzt den Innenabstand der Reiter mit, damit es groß wirkt,
	   ohne die Kopfzeile zu erhöhen (Reiter: 0,75em + 1,6em Zeile + 0,75em = 3,1em) */
	/* „nav .logo“ statt „.logo“, sonst gewinnt der Innenabstand aus „nav a“ */
	nav .logo {
		display: flex;
		align-items: center;
		/* unten knapper als oben: dort folgt noch der (rote) Balken mit 3px */
		padding: 0.25em 0 0.1em;
	}

	.logo img {
		/* 3,1em minus Abstände oben und unten minus roter Balken (3px) */
		height: calc(2.75em - 3px);
		width: auto;
	}

	/* schmale Handys (z. B. 360 px): Logo etwas kleiner */
	@media (max-width: 380px) {
		.logo img {
			height: 32px;
		}
	}

	/* ganz schmale Handys (320 px): Logo, Abstände und Schrift noch etwas kleiner */
	@media (max-width: 345px) {
		.leiste {
			font-size: 0.85rem;
		}

		nav {
			gap: 0.35em;
		}

		.logo img {
			height: 26px;
		}
	}

	/* „Fragen“ näher ans Logo: vom Abstand zwischen den Reitern (1,8em) bleibt nach dem Logo nur 0,6em */
	@media (min-width: 561px) {
		nav .logo {
			margin-right: -1.2em;
		}
	}

	.logo:hover {
		opacity: 0.8;
	}

	nav a[aria-current='page'] {
		border-bottom-color: var(--rot);
		color: var(--text);
	}

	nav a:hover {
		color: var(--rot);
	}

	/* Menü ☰: Knopf ganz rechts in der Leiste, Liste klappt darunter auf */
	.menue {
		display: flex;
		flex-shrink: 0;
		margin-left: 0.8em;
	}

	/* auf dem Handy näher an die Reiter (steht hier, damit es die Regel darüber überschreibt) */
	@media (max-width: 560px) {
		.menue {
			margin-left: 0.4em;
		}
	}

	@media (max-width: 345px) {
		.menue {
			margin-left: 0.2em;
		}
	}

	.menue summary {
		display: flex;
		align-items: center;
		padding: 0 0.2em;
		/* oben und unten gleich dick, damit die Striche mittig bleiben; unten wie bei den Reitern rot, wenn die Seite nur im Menü steht */
		border-top: 3px solid transparent;
		border-bottom: 3px solid transparent;
		color: var(--grau);
		cursor: pointer;
		list-style: none;
	}

	.menue.hier summary {
		border-bottom-color: var(--rot);
		color: var(--text);
	}

	.menue summary::-webkit-details-marker {
		display: none;
	}

	.menue summary:hover,
	.menue[open] summary {
		color: var(--text);
	}

	.menue-liste {
		position: absolute;
		top: 100%;
		right: 0;
		min-width: 15em;
		padding: 0.5em 0;
		background: #ffffff;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
		font-weight: bold;
	}

	.menue-liste a {
		display: block;
		padding: 0.55em 1.2em;
		border-left: 3px solid transparent;
		color: var(--text);
		text-decoration: none;
	}

	.menue-liste a[aria-current='page'] {
		border-left-color: var(--rot);
	}

	.menue-liste a:hover {
		color: var(--rot);
	}

	/* Impressum und Datenschutz kleiner, abgesetzt */
	.menue-klein {
		margin-top: 0.4em;
		padding-top: 0.4em;
		border-top: 1px solid #e5e5e5;
		font-size: 0.9rem;
		font-weight: normal;
	}

	.menue-klein a {
		padding-top: 0.4em;
		padding-bottom: 0.4em;
		color: var(--grau);
	}

	/* Schwarz-Rot-Gold als schmaler Streifen am oberen Rand */
	.flagge {
		height: 12px;
		background: linear-gradient(
			to bottom,
			var(--schwarz) 0 33.33%,
			var(--rot) 33.33% 66.66%,
			var(--gold) 66.66% 100%
		);
	}

	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em 2em;
		padding: 2em 1em;
		border-top: 1px solid #e5e5e5;
		font-size: 0.95rem;
	}

	footer a {
		color: var(--grau);
		text-decoration: none;
	}

	footer a:hover {
		color: var(--rot);
	}
</style>
